<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_renewal_dashboard" model="ir.actions.act_window">
        <field name="name">لوحة التجديدات</field>
        <field name="res_model">renewal.document</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_renewal_document_search"/>
        <field name="domain">[]</field>
        <field name="context">{
            'search_default_group_type': 0,
            'orderedBy': [{'name': 'days_remaining', 'asc': True}]
        }</field>
    </record>

    <record id="action_renewal_urgent" model="ir.actions.act_window">
        <field name="name">تحتاج تدخل فوري</field>
        <field name="res_model">renewal.document</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('status', 'in', ['expired', 'critical'])]</field>
    </record>

</odoo>
