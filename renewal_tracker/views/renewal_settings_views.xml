<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_renewal_settings_form" model="ir.ui.view">
        <field name="name">renewal.settings.form</field>
        <field name="model">renewal.settings</field>
        <field name="arch" type="xml">
            <form string="إعدادات التجديدات">
                <sheet>
                    <div class="oe_title">
                        <h2>إعدادات التجديدات والتنبيهات</h2>
                    </div>
                    <group string="مستويات التنبيه المسبق">
                        <div class="text-muted mb-2" colspan="2">
                            حدد عدد الأيام قبل انتهاء الوثيقة لإرسال التنبيه
                        </div>
                        <group>
                            <field name="alert_level_1" string="تنبيه أول قبل (يوم)"/>
                            <field name="alert_level_2" string="تنبيه ثاني قبل (يوم)"/>
                        </group>
                        <group>
                            <field name="alert_level_3" string="تنبيه ثالث قبل (يوم)"/>
                            <field name="alert_level_4" string="تنبيه رابع قبل (يوم)"/>
                        </group>
                    </group>
                    <group string="حدود الحالات">
                        <field name="critical_days" string="الحالة عاجلة عند أقل من (يوم)"/>
                        <field name="warning_days" string="التحذير عند أقل من (يوم)"/>
                    </group>
                    <group string="طريقة الإشعار">
                        <field name="notify_activity" string="إشعار بـ Activity داخل النظام"/>
                        <field name="notify_email" string="إشعار بالبريد الإلكتروني"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_renewal_settings_server" model="ir.actions.server">
        <field name="name">إعدادات التجديدات</field>
        <field name="model_id" ref="model_renewal_settings"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_settings()</field>
    </record>

</odoo>
