<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_renewal_document_list" model="ir.ui.view">
        <field name="name">renewal.document.list</field>
        <field name="model">renewal.document</field>
        <field name="arch" type="xml">
            <list string="الوثائق" decoration-danger="status == 'expired'"
                  decoration-warning="status == 'critical'"
                  decoration-info="status == 'warning'"
                  multi_edit="1">
                <field name="name"/>
                <field name="document_type"/>
                <field name="reference"/>
                <field name="responsible_id"/>
                <field name="start_date"/>
                <field name="expiry_date"/>
                <field name="days_remaining"/>
                <field name="status" widget="badge"
                       decoration-danger="status == 'expired'"
                       decoration-warning="status == 'critical'"
                       decoration-info="status == 'warning'"
                       decoration-success="status == 'ok'"/>
                <field name="renewal_count" string="التجديدات"/>
                <button name="action_renew" string="تجديد" type="object"
                        icon="fa-refresh" class="btn-primary"/>
                <field name="activity_ids" widget="list_activity"/>
            </list>
        </field>
    </record>

    <record id="view_renewal_document_form" model="ir.ui.view">
        <field name="name">renewal.document.form</field>
        <field name="model">renewal.document</field>
        <field name="arch" type="xml">
            <form string="وثيقة التجديد">
                <header>
                    <button name="action_renew" string="تجديد الوثيقة" type="object"
                            class="btn-primary"/>
                    <field name="status" widget="statusbar"
                           statusbar_visible="ok,warning,critical,expired"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_history" type="object"
                                class="oe_stat_button" icon="fa-history">
                            <field name="renewal_count" widget="statinfo" string="تجديد"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="اسم الوثيقة..."/>
                        </h1>
                    </div>
                    <group>
                        <group string="معلومات الوثيقة">
                            <field name="document_type"/>
                            <field name="reference"/>
                            <field name="responsible_id"/>
                        </group>
                        <group string="التواريخ">
                            <field name="start_date"/>
                            <field name="expiry_date"/>
                            <field name="days_remaining"/>
                        </group>
                    </group>
                    <group string="ملاحظات">
                        <field name="notes" nolabel="1" colspan="2"/>
                    </group>
                    <notebook>
                        <page string="سجل التجديدات" name="history">
                            <field name="renewal_history_ids">
                                <list string="سجل التجديدات">
                                    <field name="renewal_date"/>
                                    <field name="old_expiry_date"/>
                                    <field name="new_expiry_date"/>
                                    <field name="renewed_by"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_renewal_document_kanban" model="ir.ui.view">
        <field name="name">renewal.document.kanban</field>
        <field name="model">renewal.document</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="document_type"
                    quick_create="false">
                <field name="name"/>
                <field name="document_type"/>
                <field name="expiry_date"/>
                <field name="days_remaining"/>
                <field name="status"/>
                <field name="responsible_id"/>
                <field name="color"/>
                <templates>
                    <t t-name="card" class="flex-row">
                        <aside>
                            <field name="activity_ids" widget="kanban_activity"/>
                        </aside>
                        <main>
                            <field name="name" class="fw-bold fs-5"/>
                            <div class="text-muted">
                                <field name="responsible_id"/>
                            </div>
                            <div class="mt-2">
                                <span t-attf-class="badge #{record.status.raw_value == 'expired' ? 'text-bg-danger' : record.status.raw_value == 'critical' ? 'text-bg-warning' : record.status.raw_value == 'warning' ? 'text-bg-info' : 'text-bg-success'}">
                                    <field name="days_remaining"/> يوم
                                </span>
                                <span class="ms-2 text-muted small">
                                    انتهاء: <field name="expiry_date"/>
                                </span>
                            </div>
                            <div class="mt-2">
                                <button name="action_renew" type="object"
                                        class="btn btn-sm btn-primary">تجديد</button>
                            </div>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_renewal_document_search" model="ir.ui.view">
        <field name="name">renewal.document.search</field>
        <field name="model">renewal.document</field>
        <field name="arch" type="xml">
            <search string="بحث في الوثائق">
                <field name="name" string="اسم الوثيقة"/>
                <field name="reference" string="المرجع"/>
                <field name="responsible_id" string="المسؤول"/>
                <separator/>
                <filter name="expired" string="منتهية" domain="[('status','=','expired')]"/>
                <filter name="critical" string="عاجل" domain="[('status','=','critical')]"/>
                <filter name="warning" string="قريب" domain="[('status','=','warning')]"/>
                <filter name="ok" string="سليم" domain="[('status','=','ok')]"/>
                <separator/>
                <filter name="car_license" string="رخص سيارات" domain="[('document_type','=','car_license')]"/>
                <filter name="employee_doc" string="وثائق موظفين" domain="[('document_type','=','employee_doc')]"/>
                <separator/>
                <filter name="my_docs" string="وثائقي" domain="[('responsible_id','=',uid)]"/>
                <group>
                    <filter name="group_type" string="النوع" context="{'group_by': 'document_type'}"/>
                    <filter name="group_status" string="الحالة" context="{'group_by': 'status'}"/>
                    <filter name="group_responsible" string="المسؤول" context="{'group_by': 'responsible_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_renewal_renew_wizard_form" model="ir.ui.view">
        <field name="name">renewal.document.renew.wizard.form</field>
        <field name="model">renewal.document.renew.wizard</field>
        <field name="arch" type="xml">
            <form string="تجديد الوثيقة">
                <group>
                    <field name="document_id" readonly="1"/>
                    <field name="old_expiry_date" readonly="1"/>
                    <field name="new_start_date"/>
                    <field name="new_expiry_date" required="1"/>
                    <field name="notes"/>
                </group>
                <footer>
                    <button name="action_confirm_renew" string="تأكيد التجديد"
                            type="object" class="btn-primary"/>
                    <button string="إلغاء" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_renewal_document" model="ir.actions.act_window">
        <field name="name">الوثائق والتجديدات</field>
        <field name="res_model">renewal.document</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_renewal_document_search"/>
        <field name="context">{'search_default_group_type': 0}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                أضف وثيقتك الأولى
            </p>
            <p>
                تتبع مواعيد انتهاء رخص السيارات وأوراق الموظفين وغيرها.
            </p>
        </field>
    </record>

    <record id="action_renewal_document_expired" model="ir.actions.act_window">
        <field name="name">الوثائق المنتهية</field>
        <field name="res_model">renewal.document</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('status', 'in', ['expired', 'critical'])]</field>
        <field name="context">{'search_default_expired': 1}</field>
    </record>

</odoo>
