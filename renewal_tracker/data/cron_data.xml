<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_check_renewals" model="ir.cron">
            <field name="name">فحص تجديدات الوثائق اليومي</field>
            <field name="model_id" ref="model_renewal_document"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_renewals()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 06:00:00')"/>
        </record>
    </data>
</odoo>
