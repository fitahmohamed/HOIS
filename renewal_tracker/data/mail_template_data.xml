<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="email_template_renewal_alert" model="mail.template">
            <field name="name">تنبيه تجديد وثيقة</field>
            <field name="model_id" ref="renewal_tracker.model_renewal_document"/>
            <field name="subject">تنبيه تجديد: {{ object.name }}</field>
            <field name="partner_to">{{ object.responsible_id.partner_id.id }}</field>
            <field name="email_to">{{ object.responsible_id.email or object.responsible_id.partner_id.email }}</field>
            <field name="description">إشعار بريدي لتنبيهات تجديد الوثائق</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        مرحباً <t t-out="object.responsible_id.name or ''"/>،<br/><br/>
                        نحيطكم علماً بأن الوثيقة <strong><t t-out="object.name or ''"/></strong> 
                        (المرجع: <t t-out="object.reference or '-'"/>) 
                        ستنتهي صلاحيتها خلال <strong><t t-out="ctx.get('days_left')"/></strong> يوم بتاريخ <strong><t t-out="object.expiry_date"/></strong>.<br/><br/>
                        يرجى اتخاذ الإجراءات اللازمة لتجديد الوثيقة.
                    </p>
                </div>
            </field>
        </record>
    </data>
</odoo>
