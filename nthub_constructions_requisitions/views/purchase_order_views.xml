<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="purchase_order_form_inherit_requisition_tracking" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.requisition.tracking</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_ref']" position="after">
                <field name="internal_serial"/>
                <field name="requisition_project_id" readonly="1"/>
                <field name="requisition_project_wbs_id" readonly="1"/>
                <field name="requisition_wbs_builds_id" readonly="1"/>
                <field name="requisition_task_id" readonly="1"/>
            </xpath>

            <xpath expr="//field[@name='order_line']//list//field[@name='price_unit']" position="before">
                <field name="last_purchase_price" readonly="1" optional="show"/>
            </xpath>

            <xpath expr="//field[@name='order_line']//list//field[@name='product_qty']" position="before">
                <field name="requisition_project_wbs_id" readonly="1" optional="hide"/>
                <field name="requisition_wbs_builds_id" readonly="1" optional="hide"/>
                <field name="requisition_task_id" readonly="1" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="purchase_order_tree_inherit_internal_serial" model="ir.ui.view">
        <field name="name">purchase.order.list.inherit.internal.serial</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="internal_serial" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="purchase_order_kpis_tree_inherit_internal_serial" model="ir.ui.view">
        <field name="name">purchase.order.kpis.list.inherit.internal.serial</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_kpis_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="internal_serial" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="purchase_order_view_tree_inherit_internal_serial" model="ir.ui.view">
        <field name="name">purchase.order.view.list.inherit.internal.serial</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="internal_serial" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="purchase_order_line_tree_inherit_last_purchase_price" model="ir.ui.view">
        <field name="name">purchase.order.line.list.inherit.last.purchase.price</field>
        <field name="model">purchase.order.line</field>
        <field name="inherit_id" ref="purchase.purchase_order_line_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='price_unit']" position="before">
                <field name="last_purchase_price" readonly="1" optional="show"/>
            </xpath>
        </field>
    </record>

</odoo>
