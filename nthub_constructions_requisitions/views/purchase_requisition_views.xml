<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="material_purchase_requisition_form_inherit" model="ir.ui.view">
        <field name="name">material.purchase.requisition.form.inherit.constructions</field>
        <field name="model">material.purchase.requisition</field>
        <field name="inherit_id" ref="nthub_project_requisitions.material_purchase_requisition_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='requisition_confirm']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//button[@name='requisition_confirm']" position="after">
                <button name="action_inventory_check" type="object" string="Inventory Check"
                        invisible="state != 'draft'"
                        class="btn-primary" groups="stock.group_stock_user"/>
                <button name="action_inventory_approve" type="object" string="Inventory Approve"
                        invisible="state != 'inventory_check'"
                        class="btn-primary" groups="stock.group_stock_user"/>
            </xpath>

            <xpath expr="//field[@name='state']" position="attributes">
                <attribute name="statusbar_visible">draft,inventory_check,dept_confirm,ir_approve,approve,stock,receive</attribute>
            </xpath>

            <!-- Add task_id after project_id -->
            <xpath expr="//field[@name='project_id']" position="after">
                <field name="project_wbs_id"
                       domain="[('project_id', '=', project_id)]"
                       readonly="state != 'draft'"/>
                <field name="wbs_builds_id"
                       domain="[('project_wbs_id', '=', project_wbs_id)]"
                       readonly="state != 'draft'"/>
                <field name="task_id"
                       domain="[('project_id', '=', project_id), ('parent_id.wbs_builds_id', '=', wbs_builds_id)]"
                       readonly="state != 'draft'"/>
                <field name="location_id"
                       groups="stock.group_stock_user,nthub_project_requisitions.group_purchase_requisition_manager,nthub_project_requisitions.group_purchase_requisition_department"
                       domain="[('usage','!=', 'view')]"
                       readonly="state not in ('draft', 'inventory_check')"/>
            </xpath>

            <!-- Add tracking columns to requisition lines -->
            <xpath expr="//field[@name='requisition_line_ids']//list//field[@name='qty']" position="before">
                <field name="original_qty" readonly="1" string="Task Qty"
                       decoration-muted="original_qty == 0"/>
                <field name="prev_requisitioned_qty" readonly="1" string="سبق طلبه (نفس النوع)"/>
                <field name="inventory_checked_qty"
                       readonly="parent.state != 'inventory_check'"
                       string="Inventory Qty"/>
                <field name="breakdown_price" readonly="1" string="Cost Price"/>
                <field name="budget_amount" readonly="1" string="Budget"/>
            </xpath>

            <xpath expr="//field[@name='requisition_line_ids']//list//field[@name='qty']" position="after">
                <field name="remaining_qty" readonly="1" string="Still Remaining"
                       decoration-danger="remaining_qty &lt; 0"/>
                <field name="line_total" readonly="1" string="Est. Cost" sum="Total"/>
            </xpath>

        </field>
    </record>

</odoo>
