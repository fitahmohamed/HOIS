<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="payment_header_custom">
        <t t-if="not company">
            <t t-if="company_id">
                <t t-set="company" t-value="company_id"/>
            </t>
            <t t-else="else">
                <t t-set="company" t-value="res_company"/>
            </t>
        </t>
        <div class="header font_system" t-att-style="report_header_style">
            <div class="row">
                <div class="col-2 mb4 pt-5 text-center">
                    <img t-if="company.logo" class="text-center" t-att-src="image_data_uri(company.logo)"
                         style="max-height: 120px;" alt="Logo"/>
                </div>
                <div class="col-10 text-right" dir="rtl" name="moto">
                    <p style="font-size:22px;font-weight: bold;" class="font_system" t-if="company.arabic_name">
                        <span t-field="company.arabic_name"/>
                    </p>
                    <p style="font-size:15px;margin-top:-20px;font-weight: bold;" class="font_system"
                       t-if="company.arabic_street">
                        <span t-field="company.arabic_street"/>
                    </p>
                    <p style="font-size:15px;margin-top:-20px;font-weight: bold;" class="font_system"
                       t-if="company.arabic_street2">
                        <span t-field="company.arabic_street2"/>
                    </p>
                    <p style="font-size:15px;margin-top:-20px;font-weight: bold;" class="font_system"
                       t-if="company.arabic_city">
                        <span t-field="company.arabic_city"/>
                    </p>
                    <p style="font-size:15px;margin-top:-20px;font-weight: bold;" class="font_system"
                       t-if="company.arabic_state_id">
                        <span t-field="company.arabic_state_id"/>
                    </p>
                    <p style="font-size:15px;margin-top:-20px;font-weight: bold;" class="font_system"
                       t-if="company.arabic_country_id">
                        <span t-field="company.arabic_country_id"/>
                    </p>
                    <p style="font-size:15px;margin-top:-20px;font-weight: bold;" class="font_system"
                       t-if="company.vat">
                        <span>الرقم الضريبى :</span>
                        <span t-field="company.vat"/>
                    </p>
                    <p style="font-size:15px;margin-top:-20px;font-weight: bold;" class="font_system"
                       t-if="company.email">
                        <span>البريد الالكتروني:</span>
                        <span t-field="company.email"/>
                    </p>
                    <p style="font-size:15px;margin-top:-20px;font-weight: bold;" class="font_system"
                       t-if="company.phone">
                        <span>هاتف رقم :</span>
                        <span t-field="company.phone"/>
                    </p>
                </div>
            </div>
            <div t-if="company.logo or company.report_header" class="row mt-1 zero_min_height">
                <div class="col-12">
                    <div style="border-bottom: 1px solid black;"/>
                </div>
            </div>
        </div>
        <div t-attf-class="article o_report_layout_standard"
             t-att-data-oe-model="o and o._name"
             t-att-data-oe-id="o and o.id">
            <t t-raw="0"/>
        </div>
    </template>

    <template id="payment_customer_print_out_custom">
        <div class="border border-2 border-dark">
            <div t-if="payment_type == 'inbound'" class="text-center"
                 style="font-family: 'Almarai', sans-serif;margin-top: 50px;">
                <h2>إذن استلام نقدية</h2>
            </div>
            <div t-if="payment_type == 'outbound'" class="text-center"
                 style="font-family: 'Almarai', sans-serif;margin-top: 50px;">
                <h2>إذن صرف نقدية</h2>
            </div>
            <div style="margin-top: 30px; margin-right: 50px; margin-left: 50px;">
                <table class="table table-borderless" style="width: 100%;" dir="rtl">
                    <tr>
                        <td style="width: 10%;" class="text-center">
                            <h3>التاريخ</h3>
                        </td>
                        <td style="width: 20%;">
                            <h3>
                                <span t-if="o.date" t-field="o.date" t-options='{"format": "dd/MM/yyyy"}'/>
                                <span t-if="not o.date">
                                    ......................................................................
                                </span>

                            </h3>
                        </td>
                        <td style="width: 15%;" class="text-center">
                            <h3>رقم الاذن</h3>
                        </td>
                        <td style="width: 60%;">
                            <h3>
                                <span t-if="o.name" t-field="o.name"/>
                                <span t-if="not o.name">
                                    ...................................................................................................
                                </span>
                            </h3>
                        </td>
                    </tr>
                </table>

                <div style="margin-top: 30px; text-align: right; direction: rtl;">
                    <h4 t-if="not o.is_multi_dest_account">
                        <span t-if="payment_type == 'inbound'" style="margin-left: 50px;">استلمنا من السيد/:</span>
                        <span t-if="payment_type == 'outbound'" style="margin-left: 50px;">يصرف الى السيد/:</span>
                        <span t-if="o.partner_id" t-field="o.partner_id.name"/>
                        <span t-if="not o.partner_id" t-field="o.destination_account_id"/>
                        <span t-if="not o.partner_id and not o.destination_account_id">
                            ...................................................................................................
                        </span>
                    </h4>
                    <h4>
                        <span style="margin-left: 50px;">مبلغ وقدرة:</span>
                        <span class="mr-5" t-if="o.amount" t-field="o.amount"/>
                        <span t-if="not o.amount">
                            ...................................................................................................
                        </span>
                    </h4>
                    <h4>
                        <span t-if="o.amount" t-esc="o._compute_amount_word(o.amount)"/>
                        <span t-if="not o.amount">
                            ...................................................................................................
                        </span>
                    </h4>
                    <div style="margin-top: 50px;" t-if="o.is_multi_dest_account">
                        <table style="width: 100%;" class="table table-bordered" dir="rtl">
                            <tr>
                                <td style="width: 25%; text-align: center;">الحساب</td>
                                <td style="width: 25%; text-align: center;">البيان</td>
                                <td style="width: 25%; text-align: center;">الشريك</td>
                                <td style="width: 10%; text-align: center;">الحساب التحليلى</td>
                                <td style="width: 10%; text-align: center;">الضريبة</td>
                                <td style="width: 15%; text-align: center;">المبلغ</td>
                            </tr>
                            <t t-foreach="o.move_line_ids" t-as="move_line">
                                <tr>
                                    <td style="width: 25%; text-align: center;height: 30px">
                                        <span t-if="move_line.account_id" t-field="move_line.account_id"/>
                                        <span t-if="not move_line.account_id">................</span>

                                    </td>
                                    <td style="width: 25%; text-align: center;height: 30px">
                                        <span t-if="move_line.name" t-field="move_line.name"/>
                                        <span t-if="not move_line.name">................</span>
                                    </td>
                                    <td style="width: 25%; text-align: center;height: 30px">
                                        <span t-if="move_line.partner_id" t-field="move_line.partner_id"/>
                                        <span t-if="not move_line.partner_id">................</span>

                                    </td>
                                    <td style="width: 25%; text-align: center;height: 30px">
                                        <span t-if="move_line.analytic_account_id"
                                              t-field="move_line.analytic_account_id"/>
                                        <span t-if="not move_line.analytic_account_id">................</span>

                                    </td>
                                    <td style="width: 10%; text-align: center;height: 30px">
                                        <span t-if="move_line.tax_ids" t-field="move_line.tax_ids"/>
                                        <span t-if="not move_line.tax_ids">................</span>

                                    </td>
                                    <td style="width: 15%; text-align: center;height: 30px">
                                        <span t-if="move_line.balance">
                                            <span t-esc="move_line.balance"/>
                                        </span>
                                        <span t-if="not move_line.balance">................</span>
                                    </td>
                                </tr>
                            </t>
                        </table>
                    </div>
                    <h4 style="margin-top: 40px;">
                        <span style="margin-left: 50px;">وذلك نظير:</span>
                        <span t-if="o.memo" t-field="o.memo"/>
                        <span t-if="not o.memo">
                            ...................................................................................................
                        </span>
                    </h4>
                    <h4 style="margin-top: 40px;">
                        <span style="margin-left: 50px;">عن طريق:</span>
                        <span t-if="o.journal_id" t-field="o.journal_id.name"/>
                        <span t-if="not o.journal_id">
                            ...................................................................................................
                        </span>
                    </h4>
                </div>

                <div style="margin-top: 50px;">
                    <table style="width: 100%;" class="table table-borderless">
                        <tr>
                            <td style="width: 25%; text-align: center;">
                                <h4>مدخل البيانات</h4>
                            </td>
                                                        <td style="width: 25%; text-align: center;">
                                <h4>المستلم</h4>
                            </td>
                                                      <td style="width: 25%; text-align: center;">
                                <h4>المراجع</h4>
                            </td>
                            <td style="width: 25%; text-align: center;">
                                <h4>المدير المالي</h4>
                            </td>
                        </tr>
                        <tr>
                            <td style="width: 25%; text-align: center;height: 30px"/>
                            <td style="width: 25%; text-align: center;height: 30px"/>
                            <td style="width: 25%; text-align: center;height: 30px"/>
                            <td style="width: 25%; text-align: center;height: 30px"/>
                        </tr>
                    </table>
                </div>
            </div>
        </div>
    </template>


    <template id="payment_customer_custom_main">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="lang" t-value="ar_001"/>
                <t t-call="bi_account_payment_customization.payment_header_custom">
                    <div class="page font_system">
                        <t t-set="payment_type" t-value="o.payment_type"/>
                        <t t-call="bi_account_payment_customization.payment_customer_print_out_custom" t-lang="lang"/>
                    </div>
                </t>
            </t>
        </t>
    </template>
    <template id="payment_multi_custom_main">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="lang" t-value="ar_001"/>
                <t t-call="bi_account_payment_customization.payment_header_custom">
                    <div class="page font_system">
                        <t t-set="payment_type" t-value="o.payment_type"/>
                        <t t-call="bi_account_payment_customization.payment_customer_print_out_custom" t-lang="lang"/>
                        <div style="margin-top: 50px;"/>
                        <t t-call="bi_account_payment_customization.payment_customer_print_out_custom" t-lang="lang"/>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="payment_printout_to_arabic_paperformat" model="report.paperformat">
        <field name="name">A4 Portrait Account</field>
        <field name="default" eval="True"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">40</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">2</field>
        <field name="margin_right">2</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">35</field>
        <field name="dpi">110</field>
    </record>
    <record id="account_payment_customer_custom" model="ir.actions.report">
        <field name="name">Payment Print</field>
        <field name="model">account.payment</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">bi_account_payment_customization.payment_customer_custom_main</field>
        <field name="report_file">bi_account_payment_customization.payment_customer_custom_main</field>
        <field name="print_report_name">(object._get_report_base_filename())</field>
        <field name="binding_model_id" ref="account.model_account_payment"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="bi_account_payment_customization.payment_printout_to_arabic_paperformat"/>
    </record>
    <record id="account_payment_multi_custom" model="ir.actions.report">
        <field name="name">Payment Multi Print</field>
        <field name="model">account.payment</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">bi_account_payment_customization.payment_multi_custom_main</field>
        <field name="report_file">bi_account_payment_customization.payment_multi_custom_main</field>
        <field name="print_report_name">(object._get_report_base_filename())</field>
        <field name="binding_model_id" ref="account.model_account_payment"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="bi_account_payment_customization.payment_printout_to_arabic_paperformat"/>
    </record>
</odoo>
