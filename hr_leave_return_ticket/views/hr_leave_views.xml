<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Added on the base Time Off form, so it shows in the manager form
         (hr_leave_view_form_manager), the employee form and the dashboard pop-ups. -->
    <record id="hr_leave_view_form_return_ticket" model="ir.ui.view">
        <field name="name">hr.leave.view.form.return.ticket</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='col_left']/field[@name='name']" position="before">
                <field name="return_ticket_required" widget="radio" options="{'horizontal': true}"
                       required="1"
                       readonly="state in ('cancel', 'refuse', 'validate', 'validate1')"/>
                <field name="return_ticket_file_name" invisible="1"/>
                <field name="return_ticket_file" filename="return_ticket_file_name"
                       invisible="return_ticket_required != 'yes'"
                       required="return_ticket_required == 'yes'"
                       readonly="state in ('cancel', 'refuse')"/>
            </xpath>
        </field>
    </record>

    <!-- List: optional column -->
    <record id="hr_leave_view_tree_return_ticket" model="ir.ui.view">
        <field name="name">hr.leave.view.list.return.ticket</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_tree"/>
        <field name="arch" type="xml">
            <field name="holiday_status_id" position="after">
                <field name="return_ticket_required" optional="hide"/>
            </field>
        </field>
    </record>
</odoo>
