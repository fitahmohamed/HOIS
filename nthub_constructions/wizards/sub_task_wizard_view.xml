<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sub_task_wizard_view_form" model="ir.ui.view">
        <field name="name">sub.task.wizard.view.form</field>
        <field name="model">sub.task.wizard</field>
        <field name="arch" type="xml">
            <form string="Sub Task Wizard">
                <sheet>
                    <field name="product_sub_task_ids">
                        <list editable="bottom">
                            <field name="product_id" domain="[('id', 'in', product_ids)]"/>
                            <field name="product_ids" column_invisible="1"/>
                            <field name="quantity_product"/>
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button name="create_stock_picking" groups="nthub_constructions.construction_group_officer"
                            type="object" string="Create" class="oe_highlight"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
