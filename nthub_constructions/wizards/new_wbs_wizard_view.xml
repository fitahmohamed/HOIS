<?xml version="1.0" encoding="utf-8"?>
<odoo>


        <record id="new_wbs_wizard_view_form" model="ir.ui.view">
            <field name="name">new_wbs_wizard_view_form</field>
            <field name="model">new.wbs.wizard</field>
            <field name="arch" type="xml">
                <form string="new_wbs_wizard_form">
                    <sheet>
                        <group>
                            <group>
                                <field name="project_id"/>
                                <field name="unit_type_id"/>
                            </group>
                        </group>
                    </sheet>
                    <footer>
                        <button name="confirm" groups="nthub_constructions.construction_group_officer" type="object" string="Confirm" class="oe_highlight"/>
                        <button special="cancel" string="Cancel"/>
                    </footer>
                </form>
            </field>
        </record>


</odoo>