        <record model="ir.module.category" id="nthub_constructions_category">
            <field name="name">Constructions</field>
            <field name="sequence">1</field>
            <field name="description">Module category for Construction</field>
        </record>

        <record model="res.groups.privilege" id="res_groups_privilege_constructions">
        <field name="name">Constructions</field>
        <field name="sequence">12</field>
        <field name="category_id" ref="nthub_constructions.nthub_constructions_category"/>
        </record>

        <record model="res.groups.privilege" id="res_groups_privilege_constructions_wbs">
        <field name="name">WBS Constructions</field>
        <field name="sequence">12</field>
        <field name="category_id" ref="nthub_constructions.nthub_constructions_category"/>
        </record>

        <record id="construction_group_user" model="res.groups">
            <field name="name">User</field>
            <field name="privilege_id" ref="nthub_constructions.res_groups_privilege_constructions"/>
            
        </record>

        <record id="construction_group_officer" model="res.groups">
            <field name="name">Officer</field>
            <field name="privilege_id" ref="nthub_constructions.res_groups_privilege_constructions"/>
            <field name="implied_ids" eval="[(4, ref('nthub_constructions.construction_group_user'))]"/>

        </record>

        <record id="construction_group_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="privilege_id" ref="nthub_constructions.res_groups_privilege_constructions"/>
            <field name="implied_ids" eval="[(4, ref('nthub_constructions.construction_group_officer'))]"/>
        </record>

        <record id="construction_group_wbs" model="res.groups">
            <field name="name">WBS Manager</field>
            <field name="privilege_id" ref="nthub_constructions.res_groups_privilege_constructions_wbs"/>
        </record>

        <record id="construction_group_max_purchase_price" model="res.groups">
            <field name="name">Edit Max Purchase Price</field>
            <field name="privilege_id" ref="nthub_constructions.res_groups_privilege_constructions"/>
        </record>

        <record id="construction_group_create_vendors_subcontractors" model="res.groups">
            <field name="name">Create Vendors/Subcontractors</field>
            <field name="privilege_id" ref="nthub_constructions.res_groups_privilege_constructions"/>
        </record>
    </data>
</odoo>
