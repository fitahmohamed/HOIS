<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="delivery_request_id" model="ir.actions.report">
            <field name="name">Delivery Request Report</field>
            <field name="model">subcontractor.delivery.request</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">nthub_constructions.delivery_request_request</field>
            <field name="report_file">nthub_constructions.delivery_request_request</field>
            <field name="binding_model_id" ref="model_subcontractor_delivery_request"/>
            <field name="binding_type">report</field>
        </record>

        <template id="delivery_request_request">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="doc">
                    <t t-call="web.internal_layout">
                        <div class="page">
                            <div class="text-center">
                                <h2 style="text-align: center; color: #ffffff; background-color: silver; padding: 0px;">
                                    <strong>
                                        <p style="text-align: center; color: black;">Delivery Request -
                                            <span t-field="doc.name"/>
                                        </p>
                                    </strong>
                                </h2>
                            </div>
                            <br/>

                            <strong>
                                <h3>Delivery Request Information</h3>
                            </strong>

                            <table class="table table-responsive">
                                <tr>
                                     <td>
                                        <strong>Project</strong>
                                    </td>
                                    <td>
                                        <span t-field="doc.project_id.name"/>
                                    </td>
                                    <td>
                                        <strong>Contract</strong>
                                    </td>
                                    <td>
                                        <span t-field="doc.contract_id.name"/>
                                    </td>
                                </tr>
                                <tr>

                                    <td>
                                        <strong>Date</strong>
                                    </td>
                                    <td>
                                        <span t-field="doc.date"/>
                                    </td>
                                     <td>
                                        <strong>Type</strong>
                                    </td>
                                    <td>
                                        <span t-field="doc.type"/>
                                    </td>
                                </tr>


                            </table>

                            <strong t-if="doc.subcontractor_delivery_request_line_ids">
                                <h3>Delivery Request Items</h3>
                            </strong>
                            <table t-if="doc.subcontractor_delivery_request_line_ids" class="table table-responsive">
                                <tr style="border: 2px solid black;">
                                    <td>
                                        <strong>Item</strong>
                                    </td>
                                    <td>
                                        <strong>Quantity</strong>
                                    </td>
                                    <td>
                                        <strong>Unit Price</strong>
                                    </td>

                                    <td>
                                        <strong>Total Amount</strong>
                                    </td>
                                    <td>
                                        <strong>Approved Amount</strong>
                                    </td>
                                       <td>
                                        <strong>State</strong>
                                    </td>
                                </tr>
                                <t t-foreach="doc.subcontractor_delivery_request_line_ids" t-as="line">
                                    <tr style="border: 2px solid grey;">
                                        <td>
                                            <span t-field="line.item_id"/>
                                        </td>
                                        <td class="text-right">
                                            <span t-field="line.quantity"/>
                                        </td>
                                        <td>
                                            <span t-field="line.price_unit"/>
                                        </td>
                                        <td>
                                            <span t-field="line.total_amount"/>
                                        </td>
                                         <td>
                                            <span t-field="line.amount"/>
                                        </td>
                                        <td>
                                            <span t-field="line.state"/>
                                        </td>
                                    </tr>
                                </t>
                            </table>

                            <strong t-if="doc.deduction_line_ids">
                                <h3>Deduction Lines</h3>
                            </strong>
                            <table t-if="doc.deduction_line_ids" class="table table-responsive">
                                <tr style="border: 2px solid black;">
                                    <td>
                                        <strong>Name</strong>
                                    </td>
                                    <td>
                                        <strong>Type Of Contract</strong>
                                    </td>
                                    <td>
                                        <strong>Main Type</strong>
                                    </td>
                                    <td>
                                        <strong>Percentage</strong>
                                    </td>
                                    <td>
                                        <strong>Amount</strong>
                                    </td>

                                </tr>
                                <t t-foreach="doc.deduction_line_ids" t-as="line">
                                    <tr style="border: 2px solid grey;">
                                        <td>
                                            <span t-field="line.item_id"/>
                                        </td>
                                        <td>
                                            <span t-field="line.contract_type"/>
                                        </td>
                                        <td>
                                            <span t-esc="line.main_type"/>
                                        </td>
                                        <td class="text-right">
                                            <span t-esc="line.percentage"  widget="percentage"/>
                                        </td>
                                        <td class="text-right">
                                            <span t-esc="line.amount"/>
                                        </td>

                                    </tr>
                                </t>
                            </table>


                            <strong t-if="doc.allowance_line_ids">
                                <h3>Allowance Lines</h3>
                            </strong>
                            <table t-if="doc.allowance_line_ids" class="table table-responsive">
                                <tr style="border: 2px solid black;">
                                    <td>
                                        <strong>Name</strong>
                                    </td>
                                    <td>
                                        <strong>Type Of Contract</strong>
                                    </td>
                                    <td>
                                        <strong>Main Type</strong>
                                    </td>
                                    <td>
                                        <strong>Percentage</strong>
                                    </td>
                                    <td>
                                        <strong>Amount</strong>
                                    </td>

                                </tr>
                                <t t-foreach="doc.allowance_line_ids" t-as="line">
                                    <tr style="border: 2px solid grey;">
                                        <td>
                                            <span t-field="line.name"/>
                                        </td>
                                        <td>
                                            <span t-field="line.contract_type"/>
                                        </td>
                                        <td>
                                            <span t-esc="line.main_type"/>
                                        </td>
                                        <td class="text-right">
                                            <span t-esc="line.percentage"  widget="percentage"/>
                                        </td>
                                        <td class="text-right">
                                            <span t-esc="line.amount"/>
                                        </td>

                                    </tr>
                                </t>
                            </table>


                            <div class="text-right">
                                <table class="table table-responsive" style="width:50%; float:right">
                                    <tr>
                                        <td>
                                            <strong>Total Line Cost</strong>
                                        </td>
                                        <td>
                                            <span t-field="doc.total_line_cost"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>
                                            <strong>Total Deduction Cost</strong>
                                        </td>
                                        <td>
                                            <span t-field="doc.total_deduction_cost"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>
                                            <strong>Total Allowance Cost</strong>
                                        </td>
                                        <td>
                                            <span t-field="doc.total_allowance_cost"/>
                                        </td>

                                    </tr>
                                    <tr>
                                        <td>
                                            <strong>Total</strong>
                                        </td>
                                        <td>
                                            <span t-field="doc.total_cost"/>
                                        </td>

                                    </tr>

                                </table>
                            </div>

                        </div>
                    </t>
                </t>
            </t>
        </template>

    </data>
</odoo>
