<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="hr_employee_form_joining_date" model="ir.ui.view">
        <field name="name">hr.employee.form.joining.date</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
             <xpath expr="//field[@name='mobile_phone']/parent::h5" position="after">
                <h5 class="d-flex align-items-baseline mb-0">
                    <i class="fa fa-calendar fa-fw me-1 text-primary" title="Joining Date"/>
                    <span class="me-1">تاريخ المباشرة:</span>
                    <field name="joining_date" readonly="1"/>
                </h5>
            </xpath>
        </field>
    </record>
</odoo>
