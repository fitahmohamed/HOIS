<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <data>
        <record id="constructions_res_config_settings_view_form" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.constructions</field>
            <field name="model">res.config.settings</field>
            <field name="priority" eval="15"/>
            <field name="inherit_id" ref="base.res_config_settings_view_form"/>
            <field name="arch" type="xml">

                <xpath expr="//form[hasclass('oe_form_configuration')]" position="inside">
                    <app data-string="Constructions &amp; Contracting" string="Constructions &amp; Contracting" name="nthub_constructions">
                        <block title="Customer Accounts Management">
                            <setting help="Define Accounts Types">
                                <group>
                                    <field name="customer_compilation_journal_account_id"
                                           class="text-center oe_inline"/>
                                    <field name="customer_compilation_request_account_id"
                                           class="text-center oe_inline"/>
                                </group>
                            </setting>
                        </block>

                        <block title="Vendor Accounts Management">
                            <setting help="Define Accounts Types">
                                <group>
                                    <field name="vendor_delivery_journal_account_id"
                                           class="text-center oe_inline"/>
                                    <field name="vendor_delivery_request_account_id"
                                           class="text-center oe_inline"/>
                                    <field name="subcontractor_payable_account_id"
                                           class="text-center oe_inline"/>
                                </group>
                            </setting>
                        </block>

                        <block title="Stock Management">
                            <setting help="Define Accounts Types">
                                <group>
                                    <field name="source_location_id" class="text-center oe_inline"/>
<!--                                    <field name="picking_type_id" class="text-center oe_inline"/>-->
                                </group>
                            </setting>
                        </block>
                    </app>
                </xpath>

            </field>
        </record>

        <record id="construction_setting_menu_action" model="ir.actions.act_window">
            <field name="name">construction Settings</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">res.config.settings</field>
            <field name="view_mode">form</field>
            <field name="target">current</field>
            <field name="context">{'module' : 'nthub_constructions', 'bin_size': False}</field>
        </record>

    </data>
</odoo>
