<odoo>

        <!--     define a project_completion_request list-->
        <record model="ir.ui.view" id="view_project_completion_request_tree">
            <field name="name">project.completion.request.list</field>
            <field name="model">project.completion.request</field>
            <field name="arch" type="xml">
                <list create="0">
                    <field name="name"/>
                    <field name="invoice_id" column_invisible="1"/>
                    <field name="project_id"/>
                    <field name="contract_id"/>
                    <field name="date"/>
                    <field name="type"/>
                    <field name="state" widget="badge" decoration-success="state=='invoiced'"
                           decoration-muted="state=='draft'" decoration-primary="state=='confirm'"
                           decoration-info="state=='processing'" decoration-danger="state=='reject'" />
                    <field name="reference" column_invisible="1"/>
                </list>
            </field>
        </record>
        <!-- define a form_project_engineer_technical_form-->
        <record model="ir.ui.view" id="project_completion_request_form">
            <field name="name">project.completion.request.form</field>
            <field name="model">project.completion.request</field>
            <field name="arch" type="xml">
                <form create="0">
                    <header>
                        <button name="start_processing" type="object" string="Start Processing"
                                invisible="state!='draft'"
                                groups="nthub_constructions.construction_group_user"
                                class="btn-primary"/>
                        <button name="action_confirm" type="object" string="Confirm"
                                invisible="state!='processing'"
                                groups="nthub_constructions.construction_group_officer"
                                class="btn-primary"/>
                        <button name="create_completion_invoice" type="object" string="Create Invoice"
                                invisible="state!='confirm'"
                                groups="nthub_constructions.construction_group_officer"
                                class="btn-primary"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,confirm"/>
                    </header>
                    <sheet>
                        <div name="button_box" class="oe_button_box">
                            <button name="open_completion_invoice" type="object" class="oe_stat_button"
                                    icon="fa-book"
                                    string="Active Invoice"
                                    invisible="invoice_id ==False"/>
                        </div>
                        <div class="oe_title">
                            <h1>
                                <field name="name"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="project_id"
                                       readonly="state in ('confirm', 'invoiced')"/>
                                <field name="invoice_id" invisible="1"/>
                                <field name="contract_id"
                                       readonly="state in ('confirm', 'invoiced')"/>
                                <field name="date"
                                       readonly="state in ('confirm', 'invoiced')"/>
                                <field name="type" readonly="state in ('confirm', 'invoiced')"/>
                                <field name="confirmation_date" readonly="state in ('confirm', 'invoiced')"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Lines">
                                <field name="line_ids" options="{'delete': [('state', '=', 'draft')]}"
                                       readonly="state in ('confirm', 'invoiced')">
                                    <list editable="bottom" create="0">
                                        <field name="item_id"/>
                                        <field name="description"/>
                                        <field name="uom_id"/>
                                        <field name="analytic_distribution" widget="analytic_distribution"/>
                                        <field name="budget_amount" force_save="1"/>
                                        <field name="quantity" sum="Total"
                                               readonly="parent.state =='processing'"/>
                                        <field name="price_unit" sum="Total" readonly="1"/>
                                        <field name="total_amount" sum="Total"
                                               readonly="1" force_save="1"/>
                                        <field name="percentage" widget="percentage"
                                               readonly="parent.state =='draft'"/>
                                        <field name="amount" sum="Total"
                                               readonly="parent.state =='draft'"/>
                                        <field name="state"
                                               readonly="parent.state =='draft'"/>
                                        <field name="completion_request_id" column_invisible="1"/>

                                    </list>
                                </field>
                            </page>
                            <page string="Deductions">
                                <field name="deduction_line_ids" nolabel="1" widget="one2many"
                                       readonly="1"
                                       context="{'default_main_type':'deduction', 'main_type':'deduction', 'default_contract_type':'owner', 'contract_type':'owner', 'list_view_ref':'nthub_constructions.view_contract_completion_deduction_allowance_tree', 'form_view_ref':'nthub_constructions.view_contract_completion_deduction_allowance_form'}"/>
                            </page>
                            <page string="Allowance">
                                <field name="allowance_line_ids"  nolabel="1"
                                       readonly="1"
                                       context="{'default_main_type':'allowance', 'main_type':'allowance', 'default_contract_type':'owner', 'contract_type':'owner', 'list_view_ref':'nthub_constructions.view_contract_completion_deduction_allowance_tree', 'form_view_ref':'nthub_constructions.view_contract_completion_deduction_allowance_form'}"/>
                            </page>
                        </notebook>
                        <group>
                            <group class="oe_subtotal_footer oe_right" colspan="2" name="totals">
                                <field name="total_line_cost" widget="monetary" force_save="1"/>
                                <field name="total_deduction_cost" widget="monetary"
                                       readonly="state in ('confirm', 'invoiced')"/>
                                <field name="total_allowance_cost" widget="monetary"
                                       readonly="state in ('confirm', 'invoiced')"/>
                                <field name="total_cost" widget="monetary"
                                       readonly="state in ('confirm', 'invoiced')"/>
                            </group>
                            <label for="notes"/>
                            <field name="notes" class="oe_inline" nolabel="1"
                                   placeholder="Setup default Completion Request Details or Technical contents."
                                   readonly="state in ('confirm', 'reject')"/>

                            <div class="oe_clear"/>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>
        <!--  define  action_project_engineer_technical_action-->
        <record id="owner_completion_request_action" model="ir.actions.act_window">
            <field name="name">Owner Completion Request</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">project.completion.request</field>
            <field name="view_mode">list,form</field>
            <field name="context">{"group_by": "project_id"}</field>
        </record>

</odoo>
