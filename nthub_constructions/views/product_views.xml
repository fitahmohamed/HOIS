<odoo>

        <record model="ir.ui.view" id="view_const_product_search">
            <field name="name">const_product.search</field>
            <field name="model">product.template</field>
            <field name="arch" type="xml">
                <search>
                    <filter name="expenses" string="Expenses"
                            domain="[('expenses','=',True)]"/>
                    <filter name="material" string="Material"
                            domain="[('material','=',True)]"/>
                    <filter name="labour" string="Labour"
                            domain="[('labour','=',True)]"/>
                    <filter name="equipment" string="Equipment"
                            domain="[('equipment','=',True)]"/>
                    <filter name="indirect_cost" string="Indirect Cost"
                            domain="[('indirect_cost','=',True)]"/>
                    <filter name="subcontractor" string="Subcontractor"
                            domain="[('subcontractor','=',True)]"/>
                    <filter name="top_sheet" string="Top Sheet"
                            domain="[('top_sheet','=',True)]"/>

                </search>
            </field>
        </record>

        <!-- Define a view for the product form -->
        <record id="const_product_form_view" model="ir.ui.view">
            <field name="name">const_product.form</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='options']" position="after">
                    <group string="Construction Options" col="2">
                        <group>
                            <field name="expenses"/>
                            <field name="material"/>
                            <field name="labour"/>
                        </group>
                        <group>
                            <field name="equipment"/>
                            <field name="indirect_cost"/>
                            <field name="subcontractor"/>
                            <field name="top_sheet"/>
                        </group>
                    </group>
                </xpath>
                <xpath expr="//field[@name='type']" position="replace">
                <field name="type"/>
            </xpath>
            </field>
        </record>
        <!-- Define an action for the product window -->
        <record id="const_product_action" model="ir.actions.act_window">
            <field name="name">Products</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">product.template</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="domain"
                   eval="'|', '|', '|', '|', '|', '|', ('expenses','=',True), ('material','=',True), ('labour','=',True), ('equipment','=',True), ('indirect_cost','=',True), ('subcontractor','=',True), ('top_sheet','=',True)"/>
        </record>

</odoo>