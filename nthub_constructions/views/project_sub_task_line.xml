<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <!-- Form View -->
        <record id="view_form_project_sub_task_line" model="ir.ui.view">
            <field name="name">project.sub.task.line.form</field>
            <field name="model">project.sub.task.line</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="flag" readonly='1' />
                            <field name="task_id" readonly='1' />
                            <field name="date"/>      
                            <field name="product_id" domain="[('equipment', '=', True) , ('id', 'in',context.get('default_prod_tem_ids'))]" invisible="flag !='q'"/>
                            <field name="product_id" domain="[('material', '=', True) , ('id', 'in',context.get('default_prod_tem_ids'))]" invisible="flag !='m'"/>
                            <field name="product_id" domain="[('labour', '=', True) , ('id', 'in',context.get('default_prod_tem_ids'))]" invisible="flag !='l'"/>
                            <field name="product_id" domain="[('expenses', '=', True) , ('id', 'in',context.get('default_prod_tem_ids'))]" invisible="flag !='e'"/>
                            <field name="product_id" domain="[('subcontractor', '=', True) , ('id', 'in',context.get('default_prod_tem_ids'))]" invisible="flag !='s'"/>
                            <field name="employee_id" widget="many2many_tags"  invisible="flag !='l'"/>
                            <field name="qty"  invisible="flag =='l'"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>     

        <!-- Tree View -->
       <record id="view_project_sub_task_line_tree" model="ir.ui.view">
            <field name="name">project.sub.task.line.tree</field>
            <field name="model">project.sub.task.line</field>
            <field name="arch" type="xml">
                <list create="0" delete="0">
                    <field name="product_id"/>
                    <field name="date"/>
                    <field name="qty"/>
                    <field name="flag"/>
                    <field name="budget_amount"/>
                    <field name="employee_id"/>
                    <field name="task_id"/>
                    <field name="project_id" type="row"/>
                    <field name="check_state"/>
                </list>
            </field>
        </record>

        <!-- Pivot View -->
        <record id="view_project_sub_task_line_pivot" model="ir.ui.view">
            <field name="name">project.sub.task.line.pivot</field>
            <field name="model">project.sub.task.line</field>
            <field name="arch" type="xml">
                <pivot>
                    <field name="product_id" type="row"/>
                    <field name="task_id" type="row"/>
                    <field name="project_id" type="row"/>
                    <field name="qty" type="measure"/>
                    <field name="budget_amount" type="measure"/>
                </pivot>
            </field>
        </record>


        <!-- Search View -->
        <record id="view_project_sub_task_line_search" model="ir.ui.view">
            <field name="name">project.sub.task.line.search</field>
            <field name="model">project.sub.task.line</field>
            <field name="arch" type="xml">
                <search>
                    <field name="parent_id"/>
                    <field name="product_id"/>
                    <field name="task_id" type="row"/>
                    <field name="project_id" type="row"/>
                    <field name="date"/>
                    <field name="flag"/>
                </search>
            </field>
        </record>


        <record id="action_project_sub_task_line" model="ir.actions.act_window">
            <field name="name">Project Sub Task Lines (Grouped)</field>
            <field name="res_model">project.sub.task.line</field>
            <field name="view_mode">list,pivot,form</field>
            <field name="context">{
                "group_by": ["project_id", "task_id", "parent_id", "product_id"]
            }</field>
            <field name="domain">[]</field>
            <field name="search_view_id" ref="view_project_sub_task_line_search"/>
        </record>
        
    </data>
</odoo>