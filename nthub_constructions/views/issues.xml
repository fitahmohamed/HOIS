<odoo>
    <data>
        <!-- Define a view for the Issue Category form -->
        <record model="ir.ui.view" id="view_issue_form">
            <field name="name">view.issue.form</field>
            <field name="model">project.issue</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="description"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- define a list view Issue Category -->
        <record model="ir.ui.view" id="view_issue_tree">
            <field name="name">issue.list</field>
            <field name="model">project.issue</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="description"/>
                </list>
            </field>
        </record>
        <!-- define the issue-->
        <record model="ir.actions.act_window" id="issues_action">
            <field name="name">Issue Category</field>
            <field name="res_model">project.issue</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>