<!--This XML file does not appear to have any style information associated with it. The document list is shown below.-->
<odoo>

        <!-- Define a view for the tenants list -->
        <record id="subcontractor_form_view" model="ir.ui.view">
            <field name="name">subcontractor.form</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="before">
                        <field name="is_subcontractor" invisible="1"/>
                </xpath>
            </field>
        </record>
        <!-- Define a action for the Sub-Contractors  -->
        <record id="subcontractors_action" model="ir.actions.act_window">
            <field name="name">Sub-Contractors</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">res.partner</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="context">{"default_is_subcontractor": True}</field>
            <field name="domain">[('is_subcontractor', '=', True)]</field>
        </record>
        <!-- Define a action for the owner  -->
        <record id="owner_action" model="ir.actions.act_window">
            <field name="name">Customers</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">res.partner</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="context">{"default_is_subcontractor": False}</field>
            <field name="domain">[('is_subcontractor', '=', False)]</field>
        </record>

</odoo>