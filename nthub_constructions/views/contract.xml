<!--This XML file does not appear to have any style information associated with it. The document list is shown below.-->
<odoo>

        <!--      define a owner.contract list -->
        <record model="ir.ui.view" id="view_owner_contract_tree">
            <field name="name">owner.contract.list</field>
            <field name="model">owner.contract</field>
            <field name="arch" type="xml">
                <list create="0">
                    <field name="name"/>
                    <field name="project_id"/>
                    <field name="partner_id"/>
                    <field name="date"/>
                    <field name="reference" readonly="1"/>
                    <field name="received_date"/>
                    <field name="down_payment_percentage" widget="percentage"/>
                    <field name="down_payment"/>
                    <field name="total_amount"/>
                    <field name="state" widget="badge" decoration-success="state=='done'"
                           decoration-muted="state=='draft'" decoration-info="state=='confirm'" />
                </list>
            </field>
        </record>
        <!--  define a form_top_sheet -->
        <record model="ir.ui.view" id="owner_contract_form">
            <field name="name">owner.contract.form</field>
            <field name="model">owner.contract</field>
            <field name="arch" type="xml">
                <form create="0">
                    <header>
                        <button name="action_confirm" groups="nthub_constructions.construction_group_officer"
                                type="object" string="Confirm"
                                invisible="state!='draft'"
                                class="btn-primary"/>
                        <button name="create_completion_request" type="object" string="Create Completion Req"
                                class="btn-primary" groups="nthub_constructions.construction_group_officer"
                                invisible="is_owner != True or state != 'confirm' or project_state == 'done'"/>
                        <button name="create_sub_contract" type="object" string="Create Sub Contract"
                                class="btn-primary" groups="nthub_constructions.construction_group_officer"
                                invisible="is_owner != True or state != 'confirm'"/>
                        <button name="create_subcontractor_delivery_request" type="object" string="Create Delivery Req"
                                groups="nthub_constructions.construction_group_officer" class="btn-primary"
                                invisible="is_owner == True or state != 'confirm' or project_state == 'done'"/>


                        <field name="extra_expense_invoice_id" invisible="1"/>
                        <field name="project_extra_expenses_ids" invisible="1"/>
                        <button name="action_create_expenses_invoice" type="object" string="Create Extra Expenses Invoice"
                                class="btn-primary"
                                invisible="is_owner != True or extra_expense_invoice_id != False
                                or project_extra_expenses_ids == [] or state == 'draft'"/>

                        <field name="project_state" invisible="1"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,confirm"/>
                    </header>
                    <sheet>
                        <div name="button_box" class="oe_button_box">
                             <button name="action_open_extra_expense_invoice" type="object" class="oe_stat_button"
                                    icon="fa-external-link"
                                     string="Expenses Invoice"
                                     invisible="extra_expense_invoice_id == False"/>
                            <button name="action_open_sub_contract" type="object" class="oe_stat_button" icon="fa-book"
                                    invisible="is_owner != True or state != 'confirm'">
                                <div class="o_field_widget o_stat_info">
                                    <span class="o_stat_value" widget="statinfo">
                                        <field name="sub_contract_count" widget="statinfo" nolabel="1" class="mr4"
                                               readonly="1"/>
                                    </span>
                                    <span class="o_stat_text">Sub-Contract</span>
                                </div>
                            </button>
                            <button name="action_open_completion_request" type="object" class="oe_stat_button"
                                    groups="nthub_constructions.construction_group_officer" icon="fa-book"
                                    invisible="is_owner != True or state != 'confirm'">
                                <div class="o_field_widget o_stat_info">
                                    <span class="o_stat_value" widget="statinfo">
                                        <field name="completion_request_count" widget="statinfo" nolabel="1" class="mr4"
                                               readonly="1"/>
                                    </span>
                                    <span class="o_stat_text">Completion Request</span>
                                </div>
                            </button>
                            <button name="action_open_subcontractor_delivery_request" type="object"
                                    class="oe_stat_button" icon="fa-book"
                                    invisible="is_owner == True or state != 'confirm'">
                                <div class="o_field_widget o_stat_info">
                                    <span class="o_stat_value" widget="statinfo">
                                        <field name="subcontractor_delivery_request_count" widget="statinfo" nolabel="1"
                                               class="mr4" readonly="1"/>
                                    </span>
                                    <span class="o_stat_text">Delivery Request</span>
                                </div>
                            </button>
                        </div>
                        <div class="oe_title">
                            <h1>
                                <field name="name"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="state" invisible="1"/>
                                <field name="is_generated" invisible="1"/>
                                <field name="is_owner" invisible="1"/>
                                <field name="project_id"
                                       readonly="state =='confirm'"/>
                                <field name="partner_id"  string="Customer" widget="res_partner_many2one"
                                       readonly="state =='confirm'" invisible="is_owner !=True"/>
                                <field name="partner_id"  string="Customer" widget="res_partner_many2one"
                                       readonly="state =='confirm'" invisible="is_owner ==True"/>
                                <field name="end_date"
                                       readonly="state =='confirm'"
                                       />
                                <field name="reference" readonly="1"
                                       invisible="is_owner ==True"/>
                            </group>
                            <group>
                                <field name="received_date" readonly="state =='confirm'"/>
                                <field name="down_payment_percentage" widget="percentage"
                                       readonly="state == 'confirm'"
                                       />
                                <label for="down_payment"/>
                                <div class="o_row" width="80%">
                                    <field name="down_payment" widget="monetary"
                                           readonly="state =='confirm'"/>

                                    <field name="payment_id" readonly="1"
                                           invisible="payment_id == False"/>
                                    <button name="create_payment" string="Create Payment"
                                            class="btn-secondary" type="object"
                                            invisible="payment_id != False or is_owner != True or state == 'draft'"
                                            />
                                    <button name="create_payment_from_down_payment" string="Create Payment"
                                            class="btn-secondary" type="object"
                                            invisible="payment_id != False or is_owner == True or state == 'draft'"
                                            />
                                    <field name="currency_id" required="1"
                                           readonly="state =='confirm'"/>
                                </div>
                            </group>
                        </group>
                        <notebook>
                            <page string="Lines" name="lines">
                                <field name="owner_contract_line_ids"
                                       options="{'delete': [('state', '=', 'draft'),('is_owner', '=', False)]}"
                                       readonly="state == 'confirm'">
                                    <list editable="bottom">
                                        <field name="owner_contract_id" column_invisible="1"/>
                                        <field name="code"/>
                                        <field name="item_id"/>
                                        <field name="stage"/>
                                        <field name="description"/>
                                        <field name="job_id"/>
                                        <field name="uom_id"/>
                                        <field name="template_id"/>
                                        <field name="analytic_distribution" widget="analytic_distribution"/>
                                        <field name="budget_amount" force_save="1"/>
                                        <field name="quantity"/>
                                        <field name="price_unit"/>
                                        <field name="percentage" widget="percentage"/>
                                        <field name="finished_quantity" readonly="1"/>
                                        <field name="remaining_quantity" readonly="1"/>
                                        <field name="amount"/>
                                        <field name="attachment"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Deductions" name="deductions">
                                <field name="deduction_line_ids" nolabel="1" widget="one2many"
                                       context="{'default_main_type':'deduction','main_type':'deduction','default_contract_type':'owner','contract_type':'owner','list_view_ref':'nthub_constructions.view_contract_deduction_allowance_tree','form_view_ref':'nthub_constructions.view_contract_deduction_allowance_form'}"
                                       readonly="1"/>
                            </page>
                            <page string="Allowances" name="allowances">
                                <field name="allowance_line_ids" nolabel="1" widget="one2many"
                                       context="{'default_main_type':'allowance','main_type':'allowance','default_contract_type':'owner','contract_type':'owner','list_view_ref':'nthub_constructions.view_contract_deduction_allowance_tree','form_view_ref':'nthub_constructions.view_contract_deduction_allowance_form'}"
                                       readonly="1"/>
                            </page>

                            <page name="extra_expense" string="Extra Expenses"
                                  invisible="is_owner != True">
                                <field name="project_extra_expenses_ids" force_save="1"
                                       readonly="state != 'draft'"
                                       >
                                    <list editable="bottom">
                                        <field name="product_id"/>
                                        <field name="date"/>
                                        <field name="name"/>
                                        <field name="description"/>
                                        <field name="cost" sum="Total"/>
                                        <field name="attachment"/>
                                        <field name="project_id" column_invisible="1"/>
                                    </list>
                                </field>
                            </page>

                            <page string="CRG Settings" name="cr_settings"
                                  invisible="is_owner ==False  or project_state == 'done'">
                                <group>
                                    <group>
                                        <field name="generation_method"
                                               readonly="is_generated ==True"
                                               />
                                        <field name="rate"
                                               readonly="is_generated == True" invisible="generation_method != 'progress'"
                                               widget="percentage"/>
                                        <field name="months"
                                               readonly="is_generated == True" invisible="generation_method != 'duration'"
                                               />
                                    </group>
                                </group>
                                <button name="action_generate_completion_request" type="object"
                                        string="Generate Completion Req"
                                        groups="nthub_constructions.construction_group_officer" class="btn-primary"
                                        invisible="is_owner != True or state != 'confirm' or is_generated != False"
                                        />
                            </page>
                        </notebook>
                        <group>
                            <group class="oe_subtotal_footer oe_right" colspan="2" name="totals">
                                <field name="total_amount" string="Total Lines" widget="monetary"
                                       readonly="1" force_save="1"/>
                                <field name="deduction_total" string="Total Deduction" widget="monetary"
                                       readonly="1" force_save="1"/>
                                <field name="allowance_total" string="Total Allowances" widget="monetary"
                                       readonly="1" force_save="1"/>
                                <field name="total_extra_cost" string="Total Extra Expenses" widget="monetary"
                                    readonly="1" force_save="1"
                                       invisible="is_owner == False"
                                       />
                                />
                                <field name="total_after_deduction_allowance" string="Total" widget="monetary"
                                       class="oe_subtotal_footer_separator"
                                       readonly="1" force_save="1"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <!--   define a action_top_sheet -->
        <record id="owner_contract_action" model="ir.actions.act_window">
            <field name="name">Owner Contract</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">owner.contract</field>
            <field name="view_mode">list,form</field>
            <field name="context">{"default_is_owner": True , "group_by": "project_id"}</field>
            <field name="domain">[('is_owner', '=', True)]</field>
        </record>
        <record id="sub_contract_action" model="ir.actions.act_window">
            <field name="name">Sub-Contract</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">owner.contract</field>
            <field name="view_mode">list,form</field>
            <field name="context">{"default_is_owner": False, "group_by": "project_id"}</field>
            <field name="domain">[('is_owner', '=', False)]</field>
        </record>

</odoo>