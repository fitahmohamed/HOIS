        <menuitem id="owner_contract_menu" name="Owner Contract" parent="constructions_contract_menu"
                  action="owner_contract_action"
                  sequence="1"/>
        <menuitem id="sub_contract_menu" name="Sub-Contract" parent="constructions_contract_menu"
