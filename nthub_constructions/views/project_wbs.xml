<odoo>

    <record id="project_wbs_view_tree" model="ir.ui.view">
        <field name="name">project_wbs_view_list</field>
        <field name="model">project.wbs</field>
        <field name="arch" type="xml">
            <list string="tender_offer" create="0">
                <field name="name"/>
                <field name="date"/>
                <field name="customer_id" domain="[('is_internal_employee', '=', False)]"/>
                <field name="project_id"/>
                <field name="company_id"/>
            </list>
        </field>
    </record>
    <record id="project_wbs_view_form" model="ir.ui.view">
        <field name="name">project_wbs_view_form</field>
        <field name="model">project.wbs</field>
        <field name="arch" type="xml">
            <form string="tender_offer">
                <header>
                    <button name="action_confirm"
                            type="object" string="Confirm"
                            invisible="state!='draft'"
                            class="btn-primary"/>
                    <button name="action_draft"
                            type="object" string="Reset to Draft"
                            invisible="state!='confirm'"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirm"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field nolabel="1" name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="customer_id" domain="[('is_internal_employee', '=', False)]"/>
                            <field name="project_id"/>
                        </group>
                        <group>
                            <field name="company_id" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Cost Structure Lines">
                            <field name="project_wbs_builds_ids">
                                <form string="tender_offer">
                                    <header>
                                        <button string="Approved" type="object" class="btn-primary"
                                                name="action_approved"
                                                invisible="state!='draft'"/>
                                        <field name="state" widget="statusbar" statusbar_visible="draft,approved"/>
                                    </header>
                                    <sheet>
                                        <div class="oe_title">
                                            <h1>
                                                <field nolabel="1" name="name"/>
                                            </h1>
                                        </div>
                                        <group>
                                            <group>
                                                <field name="project_wbs_id" readonly="1"/>
                                                <field name="customer_id" domain="[('is_internal_employee', '=', False)]" readonly="state == 'approved'"/>
                                                <field name="project_id" readonly="state == 'approved'"/>
                                            </group>
                                            <group>
                                                <field name="company_id" readonly="1"/>
                                                <field name="Project_Task_id" readonly="1"/>
                                                <field name="currency_id" invisible="1"/>
                                            </group>
                                        </group>
                                        <notebook>
                                            <page string="Cost Structure Execution Lines">
                                                <field name="project_wbs_builds_line_ids"
                                                       readonly="state == 'approved'">
                                                    <list editable="bottom">
                                                        <field name="item_id"/>
                                                        <field name="name"/>
                                                        <field name="uom_id"/>
                                                        <field name="qty"/>
                                                        <field name="unit_price"/>
                                                        <field name="template_id"/>
                                                        <field name="sub_total" widget="monetary"
                                                               options="{'currency_field': 'currency_id'}"/>
                                                        <field name="flag"/>
                                                        <field name="company_id" invisible="1"/>
                                                        <field name="currency_id" invisible="1"/>
                                                        <field name="project_wbs_builds_id" invisible="1"/>
                                                    </list>
                                                </field>
                                                <group class="oe_subtotal_footer oe_right" colspan="2">
                                                    <field name="total_cost" widget="monetary"
                                                           options="{'currency_field': 'currency_id'}"/>
                                                </group>
                                            </page>
                                        </notebook>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="project_wbs_action" model="ir.actions.act_window">
        <field name="name">WBS</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">project.wbs</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
