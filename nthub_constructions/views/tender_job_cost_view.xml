<?xml version="1.0" encoding="UTF-8"?>
<odoo>


        <record model="ir.ui.view" id="tender_job_costing_form_view">
            <field name="name">Tender.Job.Costing.Form</field>
            <field name="model">tender.job.cost</field>
            <field name="arch" type="xml">
                <form string='Job Costing form'>
                    <header>
                        <button name='action_draft' type="object" string='Reset to Draft'
                                 invisible="state!='cancel'"
                                />
<!--                        <button name="action_confirm"  type="object" string="Confirm" states="draft"-->
<!--                                class="btn-primary"/>-->
                        <button name="action_approve" groups="nthub_constructions.construction_group_manager"
                                type="object" string="Confirm"
                                invisible="state!='draft'"
                                class="btn-primary"/>
                        <button name="action_cancel" type="object" string="Cancel"
                                invisible="state not in ('approve', 'draft')"
                                />

                        <field name="state" widget="statusbar" statusbar_visible="draft,approve"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_jobcost_sheet_lines"
                                    type="object"
                                    class="oe_stat_button"
                                    icon="fa-pencil-square-o">
                                <field string="Cost Lines" name="job_costsheet_line_count" widget="statinfo"/>
                            </button>
                        </div>
                        <div class="oe_title">
                            <h1>
                                <field name="number"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="name"
                                       readonly="state in ('approve', 'cancel')"
                                       />
                                <field name="user_id"/>
                            </group>
                            <group>
                                <field name="company_id" groups="base.group_multi_company"/>
                                <field name="currency_id" groups="base.group_multi_currency"
                                       readonly="state in ('approve', 'cancel')"/>
                                <field name="employee_id"/>
                                <field name="department_id"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Materials" name="job_cost_material_page">
                                <field name="job_cost_line_ids" nolabel="1"
                                       context="{'default_flag':'m'}"
                                       readonly="state in ('approve', 'cancel')">
                                    <list editable="bottom">
                                        <field name="date"/>
                                        <!--                                        <field name="job_type_id" domain="[('job_type','=',job_type)]"/>-->
                                        <field name="product_id" domain="[('material', '=', True)]"/>
                                        <field name="description"/>
                                        <field name="analytic_distribution" widget="analytic_distribution"/>
                                        <field name="budget_amount" force_save="1"/>
                                        <field name="qty" sum="Total"/>
                                        <field name="uom_id"/>
                                        <field name="cost_actual" force_save='1' column_invisible="1"/>
                                        <field name="unit_price" sum="Total"/>
                                        <field name="total_cost" widget="monetary" sum="Total"/>
                                        <field name="currency_id" column_invisible="1"/>
                                        <field name="job_cost_id" column_invisible="1"/>
                                        <field name="flag" column_invisible="1"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Labours" name="job_cost_labour_page">
                                <field name="job_labour_line_ids" nolabel="1"
                                       context="{'default_flag':'l'}"
                                       readonly="state in ('approve', 'cancel')">
                                    <list editable="bottom">
                                        <field name="date"/>
                                        <!--                                        <field name="job_type_id" domain="[('job_type','=',job_type)]"/>-->
                                        <field name="product_id" domain="[('labour', '=', True)]"/>
                                        <field name="description"/>
                                        <field name="analytic_distribution" widget="analytic_distribution"/>
                                        <field name="budget_amount" force_save="1"/>
                                        <field name="cost_per_day"/>
                                        <field name="no_of_days"/>
                                        <field name="unit_price" force_save="1" sum="Total" readonly="1"/>
                                        <field name="qty" sum="Total"/>
                                        <field name="uom_id"/>
                                        <field name="cost_actual" force_save='1'/>
                                        <field name="total_cost" widget="monetary" sum="Total"/>
                                        <field name="currency_id" column_invisible="1"/>
                                        <field name="job_cost_id" column_invisible="1"/>
                                        <field name="flag" column_invisible="1"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Expenses" name="job_cost_expense_page">
                                <field name="job_expense_line_ids" nolabel="1"
                                       context="{'default_flag':'e'}"
                                       readonly="state in ('approve', 'cancel')">
                                    <list editable="bottom">
                                        <field name="date"/>
                                        <!--                                        <field name="job_type_id" domain="[('job_type','=',job_type)]"/>-->
                                        <field name="product_id" domain="[('expenses', '=', True)]"/>
                                        <field name="description"/>
                                        <field name="analytic_distribution" widget="analytic_distribution"/>
                                        <field name="budget_amount" force_save="1"/>
                                        <field name="qty" sum="Total"/>
                                        <field name="uom_id"/>
                                        <field name="cost_actual" force_save='1'/>
                                        <field name="unit_price" sum="Total"/>
                                        <field name="total_cost" widget="monetary" sum="Total"/>
                                        <field name="currency_id" column_invisible="1"/>
                                        <field name="job_cost_id" column_invisible="1"/>
                                        <field name="flag" column_invisible="1"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Equipment" name="job_cost_expense_page">
                                <field name="job_equipment_line_ids" nolabel="1"
                                       context="{'default_flag':'q'}"
                                       readonly="state in ('approve', 'cancel')">
                                    <list editable="bottom">
                                        <field name="date"/>
                                        <!--                                        <field name="job_type_id" domain="[('job_type','=',job_type)]"/>-->
                                        <field name="product_id" domain="[('equipment', '=', True)]"/>
                                        <field name="description"/>
                                        <field name="analytic_distribution" widget="analytic_distribution"/>
                                        <field name="budget_amount" force_save="1"/>
                                        <field name="cost_per_day"/>
                                        <field name="no_of_days"/>
                                        <field name="unit_price" force_save="1" sum="Total" readonly="1"/>
                                        <field name="qty" sum="Total"/>
                                        <field name="uom_id"/>
                                        <field name="cost_actual" force_save='1'/>
                                        <field name="total_cost" widget="monetary" sum="Total"/>
                                        <field name="currency_id" column_invisible="1"/>
                                        <field name="job_cost_id" column_invisible="1"/>
                                        <field name="flag" column_invisible="1"/>
                                    </list>
                                </field>
                            </page>
                            <page string="SubContractor" name="job_cost_subcontractor_page">
                                <field name="job_subcontractor_line_ids" nolabel="1"
                                       context="{'default_flag':'s'}"
                                       readonly="state in ('approve', 'cancel')">
                                    <list editable="bottom">
                                        <field name="date"/>
                                        <!--                                        <field name="job_type_id" domain="[('job_type','=',job_type)]"/>-->
                                        <field name="product_id" domain="[('subcontractor', '=', True)]"/>
                                        <field name="description"/>
                                        <field name="analytic_distribution" widget="analytic_distribution"/>
                                        <field name="budget_amount" force_save="1"/>
                                        <field name="qty" sum="Total"/>
                                        <field name="uom_id"/>
                                        <field name="cost_actual" force_save='1'/>
                                        <field name="unit_price" sum="Total"/>
                                        <field name="total_cost" widget="monetary" sum="Total"/>
                                        <field name="currency_id" column_invisible="1"/>
                                        <field name="job_cost_id" column_invisible="1"/>
                                        <field name="flag" column_invisible="1"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                        <group>
                            <group class="oe_subtotal_footer oe_right" colspan="2" name="jobcost_total">
                                <field name="material_total" widget="monetary"/>
                                <field name="labor_total" widget="monetary"/>
                                <field name="expense_total" widget="monetary"/>
                                <field name="equipment_total" widget="monetary"/>
                                <field name="subcontractor_total" widget="monetary"/>
                                <field name="jobcost_total" widget="monetary"/>
                                   <field name="actual_total" widget="monetary"/>
                                <field name="revenue" widget="monetary"/>
                            </group>
                            <label for="notes_job"/>
                            <field name="notes_job" class="oe_inline" nolabel="1"
                                   placeholder="Setup default Job Details or Technical contents."
                                   readonly="state in ('approve', 'cancel')"
                                   />
                            <div class="oe_clear"/>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="tender_job_costing_tree_view" model="ir.ui.view">
            <field name="name">Tender.Job.Costing.List</field>
            <field name="model">tender.job.cost</field>
            <field name="arch" type="xml">
                <list>
                    <field name="number"/>
                    <field name="name"/>
                    <field name="jobcost_total" widget="monetary"/>
                    <field name="company_id" column_invisible='1' groups="base.group_multi_company"/>
                    <field name="state" widget="badge" decoration-success="state=='approve'"
                           decoration-danger="state=='cancel'" decoration-muted="state=='draft'"/>
                </list>
            </field>
        </record>

        <record id="tender_job_costing_search" model="ir.ui.view">
            <field name="name">tender_job_costing_search</field>
            <field name="model">tender.job.cost</field>
            <field name="arch" type="xml">
                <search string="Search WBS Template">
                    <field name="number"/>
                    <field name="name"/>

                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="user_id"/>
                    <field name="state"/>
                    <filter string="Confirm Job Costing" name="confirm_state" domain="[('state','=','confirm')]"/>
                    <filter string="Approved Job Costing" name="approved_jobcosting"
                            domain="[('state','=','approve')]"/>
                    <filter string="Cancel Job Costing" name="cancel_job_costing" domain="[('state','=','cancel')]"/>
                    <group>
                        <filter string="User" name="user_id" context="{'group_by':'user_id'}"/>
                        <filter string="Company" name="company" context="{'group_by':'company_id'}"
                                groups="base.group_multi_company"/>
                    </group>
                </search>
            </field>
        </record>


        <record id="tender_job_cost_line_tree_view" model="ir.ui.view">
            <field name="name">Tender.Job.Cost.line.list</field>
            <field name="model">tender.job.cost.line</field>
            <field name="arch" type="xml">
                <list create="false" edit="0" delete="0">
                    <field name="date"/>
                    <field name="flag" optional="hide"/>
                    <field name="product_id"/>
                    <field name="description" optional="hide"/>
                    <field name="qty"/>
                    <field name="uom_id" optional="hide"/>

                    <field name="unit_price"/>
                    <field name="currency_id" column_invisible="1"/>
                    <field name="total_cost" widget="monetary"/>
                    <field name="job_cost_id" column_invisible="1"/>
                </list>
            </field>
        </record>

        <record model="ir.actions.act_window" id="action_tender_job_costing">
            <field name="name">Breakdown Template</field>
            <field name="res_model">tender.job.cost</field>
            <field name="view_mode">list,form</field>
        </record>

        <record model="ir.actions.act_window" id="action_job_cost_line_custom">
            <field name="name">WBS Template Lines</field>
            <field name="res_model">tender.job.cost.line</field>
            <field name="context">{'group_by':'flag'}</field>
            <field name="view_mode">list,form</field>
        </record>


</odoo>
