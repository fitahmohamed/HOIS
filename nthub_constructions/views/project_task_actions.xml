<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Action: Tasks (parent only) -->
    <record id="action_construction_tasks_list" model="ir.actions.act_window">
        <field name="name">Tasks</field>
        <field name="res_model">project.task</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="domain">[('parent_id', '=', False)]</field>
        <field name="context">{'search_default_group_by_project': 1}</field>
    </record>

    <!-- Action: Sub Tasks -->
    <record id="action_construction_sub_tasks_list" model="ir.actions.act_window">
        <field name="name">Sub Tasks</field>
        <field name="res_model">project.task</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('parent_id', '!=', False)]</field>
        <field name="context">{'search_default_group_by_project': 1}</field>
    </record>

    <!-- Improved sub task list view -->
    <record id="view_construction_sub_task_list" model="ir.ui.view">
        <field name="name">project.task.list.sub.construction</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_tree2"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="parent_id" optional="show"/>
                <field name="project_wbs_id" optional="hide" string="WBS"/>
                <field name="template_wbs_builds_line_id" optional="hide" string="Breakdown"/>
            </xpath>
        </field>
    </record>

    <!-- Improved consumables list: add analytic_distribution and project_id -->
    <record id="view_project_sub_task_line_tree_inherit" model="ir.ui.view">
        <field name="name">project.sub.task.line.tree.inherit</field>
        <field name="model">project.sub.task.line</field>
        <field name="inherit_id" ref="nthub_constructions.view_project_sub_task_line_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='budget_amount']" position="after">
                <field name="analytic_distribution" widget="analytic_distribution"
                       optional="show" string="Cost Center"/>
            </xpath>
        </field>
    </record>

</odoo>
