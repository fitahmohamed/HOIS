<?xml version="1.0" encoding="UTF-8"?>
<odoo>


        <record model="ir.ui.view" id="wbs_job_costing_form_view">
            <field name="name">wbs.Job.Costing.Form</field>
            <field name="model">wbs.job.cost</field>
            <field name="arch" type="xml">
                <form string='WBS Costing form' create="0">
                   <header>
                        <button name='action_draft' type="object" string='Reset to Draft'
                                invisible="state!='approve'"
                                />
                        <button name="action_confirm" grpoup="nthub_construction.construction_group_wbs"
                                type="object" string="Approve"
                                invisible="state!='draft'"
                                class="btn-primary"/>
                       <field name="state" widget="statusbar" statusbar_visible="draft,approve"/>
                  </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="number"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="name"
                                       readonly="state == 'approve'"
                                      />
                                <field name="user_id"/>
                                <field name="ref_id"
                                       readonly="state == 'approve'"
                                       />
                            </group>
                            <group>
                                <field name="company_id" groups="base.group_multi_company"/>
                                <field name="currency_id" groups="base.group_multi_currency"
                                       readonly="state == 'approve'"
                                       />
                                <field name="employee_id"/>
                                <field name="department_id"/>
                                <field name="expected_date"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Materials" name="job_cost_material_page">
                                <field name="job_cost_line_ids" nolabel="1"
                                       context="{'default_flag':'m'}"
                                       readonly="state == 'approve'"
                                      >
                                    <list editable="bottom">
                                        <field name="date"/>
                                        <field name="product_id" domain="[('material', '=', True)]" options='{"no_open": true, "no_create": true}' />
                                        <field name="description"/>
                                        <field name="analytic_distribution" widget="analytic_distribution"/>
                                        <field name="budget_amount" force_save="1"/>
                                        <field name="unit_value"/>
                                        <field name="qty" sum="Total"/>
                                        <field name="uom_id"/>
                                        <field name="unit_price" sum="Total"/>

                                        <field name="total_cost" widget="monetary" sum="Total"/>
                                        <field name="currency_id" column_invisible="1"/>
                                        <field name="job_cost_id" column_invisible="1"/>
                                        <field name="flag" column_invisible="1"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Labour" name="job_cost_labour_page">
                                <field name="job_labour_line_ids" nolabel="1"
                                       context="{'default_flag':'l'}"
                                       readonly="state == 'approve'"
                                     >
                                    <list editable="bottom">
                                        <field name="date"/>
                                        <!--                                        <field name="job_type_id" domain="[('job_type','=',job_type)]"/>-->
                                        <field name="product_id" domain="[('labour', '=', True)]" options='{"no_open": true, "no_create": true}'/>
                                        <field name="description"/>
                                        <field name="analytic_distribution" widget="analytic_distribution"/>
                                        <field name="budget_amount" force_save="1"/>
                                        <field name="unit_value"/>
                                        <field name="unit_value" readonly="1"/>
                                        <field name="cost_per_day"/>
                                        <field name="no_of_days"/>
                                        <field name="unit_price" force_save="1" sum="Total" readonly="1"/>
                                        <field name="qty" sum="Total"/>
                                        <field name="uom_id"/>
                                        <field name="total_cost" widget="monetary" sum="Total"/>
                                        <field name="currency_id" column_invisible="1"/>
                                        <field name="job_cost_id" column_invisible="1"/>
                                        <field name="flag" column_invisible="1"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Expenses" name="job_cost_expense_page">
                                <field name="job_expense_line_ids" nolabel="1"
                                       context="{'default_flag':'e'}"
                                       readonly="state == 'approve'">
                                    <list editable="bottom">
                                        <field name="date"/>
                                        <field name="product_id" domain="[('expenses', '=', True)]" options='{"no_open": true, "no_create": true}'/>
                                        <field name="description"/>
                                        <field name="analytic_distribution" widget="analytic_distribution"/>
                                        <field name="budget_amount" force_save="1"/>
                                        <field name="unit_value"/>
                                        <field name="qty" sum="Total"/>
                                        <field name="uom_id"/>
                                        <field name="unit_price" sum="Total"/>
                                        <field name="total_cost" widget="monetary" sum="Total"/>
                                        <field name="currency_id" column_invisible="1"/>
                                        <field name="job_cost_id" column_invisible="1"/>
                                        <field name="flag" column_invisible="1"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Equipment" name="job_cost_expense_page">
                                <field name="job_equipment_line_ids" nolabel="1"
                                       context="{'default_flag':'q'}"
                                       readonly="state == 'approve'">
                                    <list editable="bottom">
                                        <field name="date"/>
                                        <field name="product_id" domain="[('equipment', '=', True)]" options='{"no_open": true, "no_create": true}'/>
                                        <field name="description"/>
                                        <field name="analytic_distribution" widget="analytic_distribution"/>
                                        <field name="budget_amount" force_save="1"/>
                                        <field name="cost_per_day"/>
                                        <field name="no_of_days"/>
                                        <field name="unit_price" sum="Total" readonly="1"/>
                                        <field name="qty" sum="Total"/>
                                        <field name="uom_id"/>
                                        <field name="total_cost" widget="monetary" sum="Total"/>
                                        <field name="currency_id" column_invisible="1"/>
                                        <field name="job_cost_id" column_invisible="1"/>
                                        <field name="flag" column_invisible="1"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Subcontractor" name="job_cost_subcontractor_page">
                                <field name="job_subcontractor_line_ids" nolabel="1"
                                       context="{'default_flag':'s'}"
                                       readonly="state == 'approve'">
                                    <list editable="bottom">
                                        <field name="date"/>
                                        <field name="product_id" domain="[('subcontractor', '=', True)]" options='{"no_open": true, "no_create": true}'/>
                                        <field name="description"/>
                                        <field name="analytic_distribution" widget="analytic_distribution"/>
                                        <field name="budget_amount" force_save="1"/>
                                        <field name="qty" sum="Total"/>
                                        <field name="uom_id"/>
                                        <field name="unit_price" sum="Total"/>
                                        <field name="total_cost" widget="monetary" sum="Total"/>
                                        <field name="currency_id" column_invisible="1"/>
                                        <field name="job_cost_id" column_invisible="1"/>
                                        <field name="flag" column_invisible="1"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                        <group>
                            <group class="oe_subtotal_footer oe_right" colspan="2" name="jobcost_total">
                                <field name="material_total" widget="monetary"/>
                                <field name="labor_total" widget="monetary"/>
                                <field name="expense_total" widget="monetary"/>
                                <field name="equipment_total" widget="monetary"/>
                                <field name="subcontractor_total" widget="monetary"/>
                                <field name="jobcost_total" widget="monetary"/>
                            </group>
                            <label for="notes_job"/>
                            <field name="notes_job" class="oe_inline" nolabel="1"
                                   placeholder="Setup default Job Details or Technical contents."
                                   readonly="state == 'approve'"
                                   />
                            <div class="oe_clear"/>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="tender_job_costing_tree_view" model="ir.ui.view">
            <field name="name">wbs.Job.Costing.List</field>
            <field name="model">wbs.job.cost</field>
            <field name="arch" type="xml">
                <list create="0">
                    <field name="number"/>
                    <field name="name"/>
                    <field name="jobcost_total" widget="monetary"/>
                    <field name="company_id" column_invisible='1' groups="base.group_multi_company"/>
                    <field name="state"/>
                </list>
            </field>
        </record>

        <record id="wbs_job_costing_search" model="ir.ui.view">
            <field name="name">wbs_job_costing_search</field>
            <field name="model">wbs.job.cost</field>
            <field name="arch" type="xml">
                <search string="Search">
                    <field name="number"/>
                    <field name="name"/>

                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="user_id"/>
                    <field name="state"/>
                    <filter string="Confirmed Job Templates" name="confirm_state" domain="[('state','=','confirm')]"/>
                    <filter string="Approved Job Templates" name="approved_jobcosting"
                            domain="[('state','=','approve')]"/>
                    <filter string="Cancelled Job Templates" name="cancel_job_costing" />
                    <group>
                        <filter string="User" name="user_id" context="{'group_by':'user_id'}"/>

                        <filter string="Company" name="company" context="{'group_by':'company_id'}"
                                groups="base.group_multi_company"/>
                    </group>
                </search>
            </field>
        </record>


        <record id="wbs_job_cost_line_tree_view" model="ir.ui.view">
            <field name="name">wbs.Job.Cost.line.list</field>
            <field name="model">wbs.job.cost.line</field>
            <field name="arch" type="xml">
                <list create="false" edit="0" delete="0">
                    <field name="date"/>
                    <field name="flag" optional="hide"/>
                    <field name="product_id" options='{"no_open": true, "no_create": true}'/>
                    <field name="description" optional="hide"/>
                    <field name="unit_value"/>
                    <field name="qty"/>
                    <field name="uom_id" optional="hide"/>

                    <field name="unit_price"/>
                    <field name="currency_id" column_invisible="1"/>
                    <field name="total_cost" widget="monetary"/>
                    <field name="job_cost_id" column_invisible="1"/>
                </list>
            </field>
        </record>

        <record model="ir.actions.act_window" id="action_wbs_job_costing">
            <field name="name">Work Breakdown Structure</field>
            <field name="res_model">wbs.job.cost</field>
            <field name="view_mode">list,form</field>
        </record>

        <record model="ir.actions.act_window" id="action_wbs_cost_line_custom">
            <field name="name">WBS Template Lines</field>
            <field name="res_model">wbs.job.cost.line</field>
            <field name="context">{'group_by':'flag'}</field>
            <field name="view_mode">list,form</field>
        </record>


</odoo>
