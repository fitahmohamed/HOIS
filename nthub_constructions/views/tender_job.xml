<odoo>

        <!-- Define a view for the tender_job form -->
        <record model="ir.ui.view" id="view_tender_form">
            <field name="name">view.tender.form</field>
            <field name="model">tender.job</field>
            <field name="arch" type="xml">
                <form create="0">
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="code"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- define a list view tender_job -->
        <record model="ir.ui.view" id="view_tender_job_tree">
            <field name="name">tender.list</field>
            <field name="model">tender.job</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="code"/>
                </list>
            </field>
        </record>


        <!-- define the tender_job-->

        <record model="ir.actions.act_window" id="tender_job_action">
            <field name="name">Tender Job</field>
            <field name="res_model">tender.job</field>
            <field name="view_mode">list,form</field>
        </record>


</odoo>