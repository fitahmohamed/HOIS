<odoo>

        <!--   define a search contract_deduction_allowance -->
        <record model="ir.ui.view" id="view_contract_deduction_allowance_search">
            <field name="name">contract.deduction.allowance.search</field>
            <field name="model">contract.deduction.allowance</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name" string="Name" filter_domain="[('name','ilike',self)]"/>
                    <newline/>
                    <filter string="Type And Main Type" name="contract_type"
                            domain="[('contract_type', '=', 'owner'),('main_type', '=', 'deduction')]"/>
                    <group>
                        <filter name="contract_type" string="Type Of Contract" domain="[]"
                                context="{'group_by':'contract_type'}"/>
                        <filter name="main_type" string="Main Type" domain="[]" context="{'group_by':'main_type'}"/>
                    </group>
                </search>
            </field>
        </record>
        <!--     define a contract_deduction_allowance_sheet-->
        <record model="ir.ui.view" id="view_contract_deduction_allowance_tree" >
            <field name="name">contract.deduction.allowance.list</field>
            <field name="model">contract.deduction.allowance</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="contract_type" />
                    <field name="main_type" />
<!--                    <field name="account_id"/>-->
                    <field name="calculation_type"/>
                    <field name="percentage" widget="percentage"/>
                    <field name="amount"/>
                </list>
            </field>
        </record>
        <!-- define a form_contract_deduction_allowance_form-->
        <record model="ir.ui.view" id="view_contract_deduction_allowance_form">
            <field name="name">contract.deduction.allowance.form</field>
            <field name="model">contract.deduction.allowance</field>
            <field name="arch" type="xml">
                <form create="0">
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="contract_type"/>
                                <field name="main_type"/>
<!--                                <field name="account_id"/>-->
                                <field name="calculation_type"/>
                                <field name="percentage" widget="percentage"
                                       invisible="calculation_type!='percentage'"/>
                                <field name="amount"
                                       invisible="calculation_type!='amount'"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <!--  define  action_contract_deduction_allowance_action-->
        <record id="contract_deduction_allowance_action" model="ir.actions.act_window">
            <field name="name">Deduction</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">contract.deduction.allowance</field>
            <field name="view_mode">list,form</field>
            <field name="context">{'search_default_contract_type': 1}</field>
        </record>


</odoo>


