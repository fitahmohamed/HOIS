<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="email_template_employee_document_alert" model="mail.template">
            <field name="name">تنبيه تجديد وثيقة موظف</field>
            <field name="model_id" ref="hr.model_hr_employee"/>
            <field name="subject">تنبيه تجديد: {{ ctx.get('doc_label') }} - {{ object.name }}</field>
            <field name="partner_to">{{ ctx.get('responsible_partner_id') }}</field>
            <field name="description">إشعار بريدي لتنبيهات تجديد وثائق الموظفين</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        مرحباً <t t-out="ctx.get('responsible_name') or ''"/>،<br/><br/>
                        نحيطكم علماً بأن <strong><t t-out="ctx.get('doc_label') or ''"/></strong>
                        الخاص بالموظف <strong><t t-out="object.name or ''"/></strong>
                        ستنتهي صلاحيته خلال <strong><t t-out="ctx.get('days_left')"/></strong> يوم
                        بتاريخ <strong><t t-out="ctx.get('expiry_date')"/></strong>.<br/><br/>
                        يرجى اتخاذ الإجراءات اللازمة للتجديد.
                    </p>
                </div>
            </field>
        </record>
    </data>
</odoo>
