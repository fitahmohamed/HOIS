<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List used inside each tab -->
    <record id="view_hr_employee_document_history_list" model="ir.ui.view">
        <field name="name">hr.employee.document.history.list</field>
        <field name="model">hr.employee.document.history</field>
        <field name="arch" type="xml">
            <list create="false" delete="false">
                <field name="renewal_date"/>
                <field name="old_expiry_date"/>
                <field name="expiry_date"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="status" widget="badge"
                       decoration-danger="status == 'expired'"
                       decoration-warning="status == 'critical'"
                       decoration-info="status == 'warning'"
                       decoration-success="status == 'ok'"/>
            </list>
        </field>
    </record>

    <!-- List used by the "Renewal History" smart button -->
    <record id="view_hr_employee_document_history_all_list" model="ir.ui.view">
        <field name="name">hr.employee.document.history.all.list</field>
        <field name="model">hr.employee.document.history</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <list create="false" delete="false">
                <field name="doc_type" string="History Type" decoration-bf="1"/>
                <field name="employee_id" optional="hide"/>
                <field name="renewal_date"/>
                <field name="old_expiry_date"/>
                <field name="expiry_date"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="status" widget="badge"
                       decoration-danger="status == 'expired'"
                       decoration-warning="status == 'critical'"
                       decoration-info="status == 'warning'"
                       decoration-success="status == 'ok'"/>
            </list>
        </field>
    </record>

    <record id="view_hr_employee_document_history_form" model="ir.ui.view">
        <field name="name">hr.employee.document.history.form</field>
        <field name="model">hr.employee.document.history</field>
        <field name="arch" type="xml">
            <form string="Renewal" create="false" edit="false" delete="false">
                <sheet>
                    <div class="oe_title">
                        <h2><field name="doc_type" readonly="1"/></h2>
                    </div>
                    <group>
                        <group string="Renewal">
                            <field name="employee_id" readonly="1"/>
                            <field name="renewal_date" readonly="1"/>
                            <field name="user_id" readonly="1" widget="many2one_avatar_user"/>
                        </group>
                        <group string="Dates">
                            <field name="old_issue_date" readonly="1"/>
                            <field name="old_expiry_date" readonly="1"/>
                            <field name="issue_date" readonly="1"/>
                            <field name="expiry_date" readonly="1"/>
                            <field name="remaining_days" readonly="1"/>
                        </group>
                    </group>
                    <group string="Document Information">
                        <group>
                            <field name="number" string="Passport Number" readonly="1" invisible="doc_type != 'passport'"/>
                            <field name="number" string="Iqama Number" readonly="1" invisible="doc_type != 'iqama'"/>
                            <field name="number" string="License Number" readonly="1" invisible="doc_type != 'license'"/>
                            <field name="number" string="Card Number" readonly="1" invisible="doc_type != 'driver_card'"/>
                            <field name="number" string="Policy Number" readonly="1" invisible="doc_type != 'medical'"/>
                            <field name="profession" readonly="1" invisible="doc_type != 'iqama'"/>
                            <field name="sponsor" readonly="1" invisible="doc_type != 'iqama'"/>
                            <field name="country_id" readonly="1" invisible="doc_type not in ('passport', 'iqama')"/>
                            <field name="license_type" readonly="1" invisible="doc_type != 'license'"/>
                            <field name="authority" readonly="1" invisible="doc_type != 'license'"/>
                            <field name="company" readonly="1" invisible="doc_type != 'medical'"/>
                            <field name="membership_number" readonly="1" invisible="doc_type != 'medical'"/>
                            <field name="insurance_type" readonly="1" invisible="doc_type != 'medical'"/>
                        </group>
                        <group>
                            <field name="file_name" invisible="1"/>
                            <field name="file" filename="file_name" readonly="1"/>
                            <field name="status" readonly="1" widget="badge"
                                   decoration-danger="status == 'expired'"
                                   decoration-warning="status == 'critical'"
                                   decoration-info="status == 'warning'"
                                   decoration-success="status == 'ok'"/>
                            <field name="note" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hr_employee_document_history_search" model="ir.ui.view">
        <field name="name">hr.employee.document.history.search</field>
        <field name="model">hr.employee.document.history</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="number"/>
                <field name="user_id"/>
                <filter name="passport" string="Passport" domain="[('doc_type', '=', 'passport')]"/>
                <filter name="iqama" string="Iqama" domain="[('doc_type', '=', 'iqama')]"/>
                <filter name="license" string="Driving License" domain="[('doc_type', '=', 'license')]"/>
                <filter name="driver_card" string="Driver Card" domain="[('doc_type', '=', 'driver_card')]"/>
                <filter name="medical" string="Medical Insurance" domain="[('doc_type', '=', 'medical')]"/>
                <separator/>
                <filter name="st_expired" string="منتهي" domain="[('status', '=', 'expired')]"/>
                <filter name="st_critical" string="عاجل جداً" domain="[('status', '=', 'critical')]"/>
                <filter name="st_warning" string="قريب" domain="[('status', '=', 'warning')]"/>
                <filter name="st_ok" string="سليم" domain="[('status', '=', 'ok')]"/>
                <group>
                    <filter name="group_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                    <filter name="group_doc_type" string="History Type" context="{'group_by': 'doc_type'}"/>
                    <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
                    <filter name="group_user" string="Renewed By" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>
