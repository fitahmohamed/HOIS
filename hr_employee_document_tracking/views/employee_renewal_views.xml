<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_renewal_list" model="ir.ui.view">
        <field name="name">hr.employee.document.history.employee.renewal.list</field>
        <field name="model">hr.employee.document.history</field>
        <field name="priority">30</field>
        <field name="arch" type="xml">
            <list string="Employee Renewal" create="false" delete="false"
                  decoration-danger="status == 'expired'"
                  decoration-warning="status == 'critical'"
                  decoration-info="status == 'warning'">
                <field name="employee_id" string="Employee" widget="many2one_avatar_employee"/>
                <field name="doc_type" string="History Type"/>
                <field name="entry_type" widget="badge" decoration-muted="entry_type == 'initial'"/>
                <field name="number" optional="show"/>
                <field name="renewal_date"/>
                <field name="old_expiry_date"/>
                <field name="expiry_date"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="status" widget="badge"
                       decoration-danger="status == 'expired'"
                       decoration-warning="status == 'critical'"
                       decoration-info="status == 'warning'"
                       decoration-success="status == 'ok'"/>
                <field name="company_id" optional="hide" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="action_employee_renewal" model="ir.actions.act_window">
        <field name="name">Employee Renewal</field>
        <field name="res_model">hr.employee.document.history</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_employee_renewal_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_hr_employee_document_history_form')})]"/>
        <field name="search_view_id" ref="view_hr_employee_document_history_search"/>
        <field name="context">{'create': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">لا توجد تجديدات للموظفين بعد</p>
            <p>التجديدات اللي بتتعمل من زرار Renewal في فورم الموظف بتظهر هنا.</p>
        </field>
    </record>

    <menuitem id="menu_employee_renewal"
              name="Employee Renewal"
              parent="renewal_tracker.menu_renewal_root"
              action="action_employee_renewal"
              sequence="25"
              groups="hr.group_hr_user"/>
</odoo>
