<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="vs_sale_order_form_extension" model="ir.ui.view">
        <field name="name">vs.sale.order.form.extension</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="delivery_status" readonly="1"/>
                <field name="invoice_status" readonly="1"/>
                <field name="vs_invoice_payment_status" readonly="1"/>
                <field name="vs_po_contract_ref" required="state != 'cancel'"/>
            </xpath>

            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="vs_site_no_id" readonly="1"/>
                <field name="vs_department_id" readonly="1"/>
                <field name="vs_truck_ids"
                    widget="many2many_tags"
                    readonly="1"
                    string="Truck" invisible="is_rental_order"/>
                <field name="vs_truck_ids"
                    widget="many2many_tags"
                    readonly="1"
                    string="Truck"
                    invisible="not is_rental_order"/>
            </xpath>

            <xpath expr="//page[@name='order_lines']//field[@name='order_line']/form//field[@name='analytic_distribution']" position="attributes">
                <attribute name="required">not display_type and not is_downpayment</attribute>
            </xpath>

            <xpath expr="//page[@name='order_lines']//field[@name='order_line']/list//field[@name='analytic_distribution']" position="attributes">
                <attribute name="required">not display_type and not is_downpayment</attribute>
            </xpath>
        </field>
    </record>

    <record id="vs_sale_order_tree_extension" model="ir.ui.view">
        <field name="name">vs.sale.order.tree.extension</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <field name="vs_po_contract_ref" optional="show"/>
                <field name="delivery_status" optional="show"/>
                <field name="invoice_status" optional="show"/>
                <field name="vs_invoice_payment_status" optional="show"/>
                <field name="vs_site_no_id" optional="show"/>
                <field name="vs_department_id" optional="show"/>
                <field name="vs_truck_ids" widget="many2many_tags" readonly="1" string="Truck" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="vs_sale_quotation_tree_extension" model="ir.ui.view">
        <field name="name">vs.sale.quotation.tree.extension</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <field name="vs_po_contract_ref" optional="show"/>
                <field name="delivery_status" optional="show"/>
                <field name="invoice_status" optional="show"/>
                <field name="vs_invoice_payment_status" optional="show"/>
                <field name="vs_site_no_id" optional="show"/>
                <field name="vs_department_id" optional="show"/>
                <field name="vs_truck_ids" widget="many2many_tags" readonly="1" string="Truck" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
