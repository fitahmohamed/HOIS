<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="product_template_purchase_price_form" model="ir.ui.view">
        <field name="name">product.template.purchase.price.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='standard_price']" position="after">
                <field name="admin_purchase_price"/>
            </xpath>
        </field>
    </record>

    <record id="purchase_order_line_purchase_price_tree" model="ir.ui.view">
        <field name="name">purchase.order.line.purchase.price.tree</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='price_unit']" position="after">
                <field name="admin_purchase_price"/>
                <field name="purchase_price_difference"/>
            </xpath>
        </field>
    </record>
</odoo>
