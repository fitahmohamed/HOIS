<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="material_purchase_requisition_form_view" model="ir.ui.view">
            <field name="name">material.purchase.requisition.form.view</field>
            <field name="model">material.purchase.requisition</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="requisition_confirm" type="object" string="Confirm"
                                invisible="state!='draft'"
                                class="btn-primary" groups="base.group_user"/>
                        <button name="manager_approve" type="object" string="Department Approve"
                                invisible="state not in ('dept_confirm', 'cancel')"
                                class="btn-primary"
                                groups="nthub_project_requisitions.group_purchase_requisition_department"/>
                        <button name="user_approve" type="object" string="Approve"
                                invisible="state!='ir_approve'"
                                class="btn-primary"
                                groups="nthub_project_requisitions.group_purchase_requisition_user"/>
                        <button name="request_stock" type="object" string="Create Picking and PO"
                                invisible="state!='approve'"
                                groups="nthub_project_requisitions.group_purchase_requisition_user"/>
                        <button name="action_received" type="object" string="Received"
                                invisible="state!='stock'"
                                class="btn-primary"/>
                        <button name="requisition_reject" type="object" string="Reject"
                                groups="nthub_project_requisitions.group_purchase_requisition_department,nthub_project_requisitions.group_purchase_requisition_user"
                                invisible="state not in ('dept_confirm', 'approve','ir_approve')"
                        />
                        <button name="action_cancel" type="object"
                                invisible="state!='draft'"
                                string="Cancel" groups="base.group_user"/>
                        <button name="reset_draft" type="object" string="Reset to Draft"
                                invisible="state not in ('cancel', 'reject','receive')"
                                class="btn-primary"/>
                        <field name="state" widget="statusbar" string="confirm"
                                            statusbar_visible="draft,receive"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button class="oe_stat_button" type="object" icon="fa-truck"
                                    name="show_picking" groups="base.group_user">
                                <div class="o_field_widget o_stat_info">
                                    <span class="o_stat_value" widget="statinfo">
                                        <field name="picking_counter" widget="statinfo" nolabel="1" class="mr4"
                                               readonly="1"/>
                                    </span>
                                    <span class="o_stat_text">Transfer</span>
                                </div>
                            </button>
                            <button class="oe_stat_button" type="object" icon="fa-book"
                                    name="action_show_po">
                                <div class="o_field_widget o_stat_info">
                                    <span class="o_stat_value" widget="statinfo">
                                        <field name="po_counter" widget="statinfo" nolabel="1" class="mr4"
                                               readonly="1"/>
                                    </span>
                                    <span class="o_stat_text">Purchase Order</span>
                                </div>
                            </button>
                        </div>
                        <div class="oe_title">
                            <div class="oe_title">
                                <h1>
                                    <field name="name"/>
                                    <br/>
                                </h1>
                            </div>
                        </div>
                        <group>
                            <group>
                                <field name="state" invisible="1"/>
                                <field name="employee_id"
                                       readonly="state!='draft'"/>
                                <field name="department_id"
                                       readonly="state!='draft'"/>
                                <field name="company_id" readonly="1"/>
                                <field name="transfer_type" invisible="1"/>
                                <field name="project_id"/>
                                <field name="requisition_responsible_id" readonly="state!='draft'"/>
                            </group>
                            <group>
                                <field name="request_date" readonly="state!='draft'"/>
                                <field name="receive_date"
                                       readonly="state in ('reject', 'cancel','receive')"
                                       />
                                <field name="date_end" readonly="state in ('reject', 'cancel','receive')"/>
                                <field name="analytic_distribution" widget="analytic_distribution"
                                       groups="analytic.group_analytic_accounting"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Requisitions Lines">
                                <field name="requisition_line_ids" readonly="state in ('cancel','receive','stock')">
                                    <list editable="bottom">
                                        <field name="product_id"/>
                                        <field name="requisition_type"
                                               groups="nthub_project_requisitions.group_purchase_requisition_manager,nthub_project_requisitions.group_purchase_requisition_department"/>
                                        <field name="description"/>
                                        <field name="available_qty"
                                               groups="purchase.group_purchase_user,nthub_project_requisitions.group_purchase_requisition_manager,nthub_project_requisitions.group_purchase_requisition_department"/>
                                        <field name="qty"/>
                                        <field name="uom"/>
                                        <field name="partner_id"
                                               groups="nthub_project_requisitions.group_purchase_requisition_manager,nthub_project_requisitions.group_purchase_requisition_department"
                                               widget="many2many_tags" readonly="requisition_type !='purchase'"/>
                                    </list>
                                </field>
                                <group>
                                    <field name="reason"
                                           readonly="state in ('reject', 'cancel','receive')"
                                           placeholder="Add Reason for Products Requisition ...."/>
                                </group>
                            </page>
                            <page string="Picking Details" readonly="state  in ('stock','cancel','reject','receive')">
                                <group>
                                    <group>
                                        <field name="location_id"
                                               groups="stock.group_stock_user,nthub_project_requisitions.group_purchase_requisition_manager,nthub_project_requisitions.group_purchase_requisition_department"
                                               domain="[('usage','!=', 'view')]"
                                               readonly="state in ('reject', 'cancel','receive')"/>
                                        <field name="transit_location_id"
                                               groups="stock.group_stock_user,nthub_project_requisitions.group_purchase_requisition_manager,nthub_project_requisitions.group_purchase_requisition_department"
                                               readonly="state in ('reject', 'cancel','receive')"/>
                                        <field name="dest_location_id" domain="[('company_id', '=', company_id)]"
                                               readonly="state in ('reject', 'cancel','receive')"/>
                                        <field name="source_employee_id"
                                               groups="stock.group_stock_user,nthub_project_requisitions.group_purchase_requisition_manager,nthub_project_requisitions.group_purchase_requisition_department"
                                               readonly="state in ('reject', 'cancel','receive')"
                                               invisible="transfer_type == 'internal_company'"/>
                                    </group>
                                    <group>
                                        <field name="custom_picking_type_id"
                                               readonly="state in ('reject', 'cancel','receive')"
                                               invisible="transfer_type != 'internal_company'"/>
                                        <field name="custom_picking_trans_type_id"
                                               readonly="state in ('reject', 'cancel','receive')"
                                               invisible="transfer_type != 'internal_company'"/>

                                        <field name="custom_picking_type_id" string="Source Picking Type"
                                               groups="stock.group_stock_user,nthub_project_requisitions.group_purchase_requisition_manager,nthub_project_requisitions.group_purchase_requisition_department"
                                               readonly="state in ('reject', 'cancel','receive')"
                                               invisible="transfer_type != 'between_companies'"/>
                                        <field name="custom_picking_trans_type_id" string="Destination Picking Type"
                                               domain="[('company_id', '=', company_id)]"
                                               readonly="state in ('reject', 'cancel','receive')"
                                               invisible="(transfer_type not in ('between_companies',False) and state != 'draft') or (state == 'draft' and transfer_type not in (False, 'between_companies'))"/>

                                        <field name="source_debit_account_id" readonly="state in ('reject', 'cancel','receive')"
                                               invisible="transfer_type != 'between_companies'"
                                               groups="stock.group_stock_user,nthub_project_requisitions.group_purchase_requisition_manager,nthub_project_requisitions.group_purchase_requisition_department"/>
                                        <field name="destination_credit_account_id" readonly="state in ('reject', 'cancel','receive')"
                                               invisible="(transfer_type not in ('between_companies',False) and state != 'draft') or (state == 'draft' and transfer_type not in (False, 'between_companies'))"/>

                                        <field name="source_journal_id" readonly="state in ('reject', 'cancel','receive')"
                                               invisible="transfer_type != 'between_companies'"
                                               groups="stock.group_stock_user,nthub_project_requisitions.group_purchase_requisition_manager,nthub_project_requisitions.group_purchase_requisition_department"/>
                                        <field name="destination_journal_id"
                                               readonly="state in ('reject', 'cancel','receive')"
                                               invisible="(transfer_type not in ('between_companies',False) and state != 'draft') or (state == 'draft' and transfer_type not in (False, 'between_companies'))"/>

                                    </group>
                                </group>
                            </page>
                            <page string="Other Information">
                                <group>
                                    <group>
                                        <field name="employee_confirm_id"/>
                                        <field name="approve_manager_id"/>
                                        <field name="approve_employee_id"/>
                                        <field name="reject_employee_id"/>
                                    </group>
                                    <group>
                                        <field name="confirm_date"/>
                                        <field name="managerapp_date"/>
                                        <field name="userrapp_date"/>
                                        <field name="userreject_date"/>
                                    </group>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter reload_on_follower="True"/>
                </form>
            </field>
        </record>

        <record id="material_purchase_requisition_tree_view" model="ir.ui.view">
            <field name="name">material.purchase.requisition.view.list</field>
            <field name="model">material.purchase.requisition</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="employee_id"/>
                    <field name="department_id"/>
                    <field name="request_date"/>
                    <field name="date_end"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="state" widget="badge" decoration-muted="state=='draft'"
                           decoration-danger="state in ['cancel','reject']"
                           decoration-success="state in ['approve','receive']"
                           decoration-warning="state in ['dept_confirm','ir_approve']"
                           decoration-primary="state =='stock'"/>
                </list>
            </field>
        </record>

        <record id="material_purchase_requisition_search_view" model="ir.ui.view">
            <field name="name">material.purchase.requisition search</field>
            <field name="model">material.purchase.requisition</field>
            <field name="arch" type="xml">
                <search string="Purchase Requistion search">
                    <field name="employee_id"/>
                    <field name="request_date"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="date_end"/>
                    <field name="department_id"/>
                    <field name="approve_manager_id"/>
                    <field name="approve_employee_id"/>
                    <field name="location_id"/>
                    <field name="managerapp_date"/>
                    <field name="userrapp_date"/>
                    <field name="receive_date"/>
                    <field name="date_done"/>
                    <field name="dest_location_id"/>
                    <field name="reason"/>
                    <field name="state"/>
                    <group>
                        <filter string="Employee" name="employee_id" context="{'group_by':'employee_id'}"/>
                        <filter string="Reqisition Date" name="request_date" context="{'group_by':'request_date'}"/>
                        <filter string="Company" name="company" context="{'group_by':'company_id'}"
                                groups="base.group_multi_company"/>
                        <filter string="Reqisition Dedline" name="date_end" context="{'group_by':'date_end'}"/>
                        <filter string="Department" name="department" context="{'group_by':'department_id'}"/>
                        <filter string="Department Manager" name="department_manager"
                                context="{'group_by':'approve_manager_id'}"/>
                        <filter string="Approve By" name="approve_by" context="{'group_by':'approve_employee_id'}"/>
                        <filter string="Location" name="location" context="{'group_by':'location_id'}"/>
                        <filter string="Manager Approve Date" name="managerapp_date"
                                context="{'group_by':'managerapp_date'}"/>
                        <filter string="User Approve Date" name="userapp_date" context="{'group_by':'userrapp_date'}"/>
                        <filter string="Destination Location" name="dest_location_id"
                                context="{'group_by':'dest_location_id'}"/>
                        <filter string="Reason" name="reason" context="{'group_by':'reason'}"/>
                        <filter string="Date Done" name="date_done" context="{'group_by':'date_done'}"/>
                        <filter string="State" name="state" context="{'group_by':'state'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record model="ir.actions.act_window" id="action_material_purchase_requisition">
            <field name="name">Purchase Requisitions</field>
            <field name="res_model">material.purchase.requisition</field>
            <!--<field name="view_type">form</field>-->
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="menu_purchase_requisition" name="Requisitions" groups="base.group_user"
                  web_icon="nthub_project_requisitions,static/description/icon.png"/>
        <menuitem id="menu_item_purchase_requisition" name="Products Requisition" parent="menu_purchase_requisition"/>
        <menuitem id="menu_action_purchase_requisition" name="Products Requisitions"
                  parent="menu_item_purchase_requisition" action="action_material_purchase_requisition"/>

    </data>
</odoo>
