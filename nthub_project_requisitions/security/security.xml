<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- Category to make groups visible as checkboxes in user form -->
        <record id="module_category_purchase_requisitions" model="ir.module.category">
            <field name="name">Purchase Requisitions</field>
            <field name="sequence">20</field>
        </record>

        <!-- Independent checkbox groups under Purchase Requisitions category -->
        <record id="group_purchase_requisition_user" model="res.groups">
            <field name="name">Confirm</field>
        </record>

        <record id="group_purchase_requisition_department" model="res.groups">
            <field name="name">Department Approve</field>
        </record>

        <record id="group_purchase_requisition_manager" model="res.groups">
            <field name="name">Final Approve</field>
        </record>

        <!-- Rules -->
        <record id="purchase_requisition_all_rule" model="ir.rule">
            <field name="name">Material Purchase Requisitions All</field>
            <field name="model_id" ref="model_material_purchase_requisition"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('nthub_project_requisitions.group_purchase_requisition_user')),
                                        (4, ref('nthub_project_requisitions.group_purchase_requisition_manager')),
                                        (4, ref('nthub_project_requisitions.group_purchase_requisition_department'))]"/>
        </record>

        <record id="purchase_requisition_line_all_rule" model="ir.rule">
            <field name="name">Material Purchase Requisitions Line All</field>
            <field name="model_id" ref="model_material_purchase_requisition_line"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('nthub_project_requisitions.group_purchase_requisition_user')),
                                        (4, ref('nthub_project_requisitions.group_purchase_requisition_manager')),
                                        (4, ref('nthub_project_requisitions.group_purchase_requisition_department'))]"/>
        </record>

    </data>
</odoo>
