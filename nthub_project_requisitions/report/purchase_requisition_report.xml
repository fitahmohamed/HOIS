<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="report_purchase_requisition" model="ir.actions.report">
            <field name="name">Purchase Requisition</field>
            <field name="model">material.purchase.requisition</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">nthub_project_requisitions.purchase_requisition</field>
            <field name="report_file">nthub_project_requisitions.purchase_requisition</field>
            <field name="binding_model_id" ref="model_material_purchase_requisition"/>
            <field name="binding_type">report</field>
        </record>

        <template id="purchase_requisition">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="doc">
                    <t t-call="web.internal_layout">
                        <div class="page">
                            <div class="text-center">
                                <h2 style="text-align: center; color: #ffffff; background-color: silver; padding: 0px;">
                                    <strong>
                                        <p style="text-align: center; color: black;">Purchase Requisition
                                            <span t-field="doc.name"/>
                                            -
                                            <span t-field="doc.state"/>
                                        </p>
                                    </strong>

                                </h2>
                            </div>

                            <br/>
                            <table class="table table-responsive">
                                <tr>
                                    <td>
                                        <strong>Employee</strong>
                                    </td>
                                    <td>
                                        <span t-field="doc.employee_id"/>
                                    </td>
                                    <td>
                                        <strong>Requisition Date</strong>
                                    </td>
                                    <td>
                                        <span t-field="doc.request_date"/>
                                    </td>
                                </tr>
                                <tr >
                                    <td>
                                        <strong>Department</strong>
                                    </td>
                                    <td>
                                        <span t-field="doc.department_id.name"/>
                                    </td>
                                    <td>
                                        <strong>Received Date</strong>
                                    </td>
                                    <td>
                                        <span t-field="doc.receive_date"/>
                                    </td>
                                </tr>
                                <tr >
                                    <td>
                                        <strong>Requisition Responsible</strong>
                                    </td>
                                    <td>
                                        <span t-field="doc.requisition_responsible_id.sudo().name"/>
                                    </td>
                                    <td>
                                        <strong>Requisition Deadline</strong>
                                    </td>
                                    <td>
                                        <span t-field="doc.date_end"/>
                                    </td>
                                </tr>
                                <tr >
                                      <td>
                                        <strong>Project</strong>
                                    </td>
                                    <td>
                                        <span t-field="doc.project_id.name"/>
                                    </td>

                                </tr>

                            </table>

<br/>
                            <t t-if="doc.reason">
                                <strong>
                                    <h3>Reason for Requisition</h3>
                                </strong>
                                <table class="table table-responsive">
                                    <tr style="border: 2px solid black;">
                                        <td>
                                            <span t-field="doc.reason"/>
                                        </td>
                                    </tr>
                                </table>
                            </t>
                            <strong>
                                    <h3>Picking Details</h3>
                                </strong>
                            <table class="table table-responsive">
                                <tr>
                                    <td>
                                        <strong>Source Location</strong>
                                    </td>
                                    <td>
                                        <span t-field="doc.location_id"/>
                                    </td>
                                    <td>
                                        <strong>Destination Location</strong>
                                    </td>
                                    <td>
                                        <span t-field="doc.dest_location_id.name"/>
                                    </td>
                                </tr>
                                <tr >
                                    <td>
                                        <strong>Transit Location</strong>
                                    </td>
                                    <td>
                                        <span t-field="doc.transit_location_id.name"/>
                                    </td>

                                </tr>
                            </table>
                            <br/>
                                <strong t-if="doc.requisition_line_ids">
                                <h3>Requisition Lines</h3>
                            </strong>
                            <table t-if="doc.requisition_line_ids" class="table table-responsive">
                                <tr style="border: 2px solid black;">
                                    <td>
                                        <strong>Requisition Action</strong>
                                    </td>
                                    <td>
                                        <strong>Product</strong>
                                    </td>
                                     <td>
                                        <strong>Unit of Measure</strong>
                                    </td>
                                    <td>
                                        <strong>Description</strong>
                                    </td>
                                    <td>
                                        <strong>Quantity</strong>
                                    </td>

                                    <td>
                                        <strong>Vendors</strong>
                                    </td>
                                </tr>
                                <t t-foreach="doc.requisition_line_ids" t-as="line">
                                    <tr style="border: 2px solid grey;">
                                        <td>
                                            <span t-field="line.requisition_type"/>
                                        </td>
                                        <td>
                                            <span t-field="line.product_id.name"/>
                                        </td>
                                         <td class="text-right">
                                            <span t-esc="line.uom.name"/>
                                        </td>
                                        <td>
                                            <span t-esc="line.description"/>
                                        </td>
                                        <td class="text-right">
                                            <span t-esc="line.qty"/>
                                        </td>

                                        <td>
                                            <t t-foreach="line.partner_id" t-as="vendore"><span t-field="vendore.name"/>

                                            </t>
                                        </td>
                                    </tr>
                                </t>
                            </table>

                        </div>
                    </t>
                </t>
            </t>
        </template>

    </data>
</odoo>
