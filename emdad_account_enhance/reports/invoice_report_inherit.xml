        <template id="l10n_sa_edi_invoice_address_without_identification"
                  inherit_id="l10n_sa_edi.l10n_sa_edi_report_invoice_document" priority="99999">
            <xpath expr="//div[hasclass('invoice_main')]/preceding-sibling::t[@t-set='address'][1]" position="replace">
                <t t-set="address">
                    <t t-set="address_partner" t-value="o.partner_id"/>
                    <t t-set="address_parts"
                       t-value="[part for part in [address_partner.street, address_partner.street2, address_partner.city, address_partner.state_id.name, address_partner.zip, address_partner.country_id.name] if part]"/>
                    <t t-set="address_mid" t-value="(len(address_parts) + 1) // 2"/>
                    <div t-if="address_partner.name" style="font-weight: bold;" t-out="address_partner.name"/>
                    <div t-if="address_parts" style="line-height: 1.15;" t-out="', '.join(address_parts[:address_mid])"/>
                    <div t-if="len(address_parts) &gt; address_mid" style="line-height: 1.15;" t-out="', '.join(address_parts[address_mid:])"/>
                    <div t-if="address_partner.vat" style="line-height: 1.15;">
                        VAT Number:
                        <span t-out="address_partner.vat"/>
                    </div>
                </t>
            </xpath>
            <xpath expr="//t[@t-call='web.external_layout']" position="before">
                <t t-set="additional_address_sa" t-value="False"/>
            </xpath>
        </template>
        <template id="l10n_sa_invoice_disable_additional_address_sa"
                  inherit_id="l10n_sa.l10n_sa_report_invoice_document" priority="99999">
            <xpath expr="//t[@t-call='web.external_layout']" position="before">
                <t t-set="additional_address_sa" t-value="False"/>
            </xpath>
        </template>
