<odoo>
    <data>
        <template id="report_sa_invoice_qr_layout_custom" inherit_id="l10n_sa.l10n_sa_report_invoice_document"
                  priority="999">
            <xpath expr="//t[@t-set='layout_document_title']" position="replace">
                <t t-set="layout_document_title">
                    <span t-out="''"/>
                </t>
            </xpath>
            <xpath expr="//p[@name='payment_communication']" position="replace">
                <div/>
            </xpath>
            <xpath expr="//div[hasclass('row')][.//t[@t-set='address']][1]" position="replace">
                <div class="row" style="margin-top: -8px;">
                    <div class="offset-col-6 col-6" name="emdad_invoice_partner_address" style="line-height: 1.15;">
                        <t t-set="address">
                            <t t-set="address_partner" t-value="o.partner_id"/>
                            <t t-set="address_parts"
                            t-value="[part for part in [address_partner.street, address_partner.street2, address_partner.city, address_partner.state_id.name, address_partner.zip, address_partner.country_id.name] if part]"/>
                            <div t-if="address_partner.name" style="font-weight: bold;" t-out="address_partner.name"/>
                            <!-- كل العنوان في سطر واحد -->
                            <div t-if="address_parts" style="line-height: 1.15; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;"
                                t-out="', '.join(address_parts)"/>
                            <div t-if="address_partner.vat" style="line-height: 1.15;">
                                VAT Number:
                                <span t-out="address_partner.vat"/>
                            </div>
                        </t>
                    </div>
                </div>
            </xpath>
            <xpath expr="//div[@id='right-elements']" position="attributes">
                <attribute name="class">col-12 mt-3 d-block</attribute>
                <attribute name="style">clear: both; float: none; margin: 0 !important; padding: 0 !important; width:
                    100% !important;
                </attribute>
            </xpath>
            <xpath expr="//div[@id='total']" position="replace">
                <div id="total"
                     style="margin: 24px 0 14px 0; clear: both; width: 100%; page-break-inside: avoid; break-inside: avoid;">
                    <div style="display: table; width: 100%; page-break-inside: avoid; break-inside: avoid;">
                        <div style="display: table-cell; width: 58%; vertical-align: top;">
                            <table class="table table-sm o_main_table"
                                   style="width: 100%; border: 1px solid #1f2b3d; font-size: 15px; margin-bottom: 0; page-break-inside: avoid; break-inside: avoid;">
                                <tr>
                                    <td style="width: 16%; border: 1px solid #1f2b3d; text-align: center; vertical-align: middle; white-space: nowrap;">
                                        <span t-field="o.amount_untaxed"/>
                                    </td>
                                    <td style="border: 1px solid #1f2b3d; text-align: right; font-weight: 700; vertical-align: middle; line-height: 1.35;">
                                        <div>Invoice Taxable Amount /</div>
                                        <div dir="rtl">المبلغ غير شامل ضريبة القيمة المضافة</div>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="border: 1px solid #1f2b3d; text-align: center; vertical-align: middle; white-space: nowrap;">
                                        <span t-field="o.amount_tax"/>
                                    </td>
                                    <td style="border: 1px solid #1f2b3d; text-align: right; font-weight: 700; vertical-align: middle; line-height: 1.35;">
                                        <div>VAT Taxes</div>
                                        <div dir="rtl">ضريبة القيمة المضافة</div>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="border: 1px solid #1f2b3d; text-align: center; vertical-align: middle; font-weight: 700; white-space: nowrap;">
                                        <span t-field="o.amount_total"/>
                                    </td>
                                    <td style="border: 1px solid #1f2b3d; text-align: right; font-weight: 700; vertical-align: middle; line-height: 1.35;">
                                        <div>Invoice Total (inclusive of VAT) /</div>
                                        <div dir="rtl">إجمالي قيمة الفاتورة شامل ضريبة القيمة المضافة</div>
                                    </td>
                                </tr>
                            </table>
                        </div>
                        <div style="display: table-cell; width: 42%; text-align: right; vertical-align: top; page-break-inside: avoid; break-inside: avoid;">
                            <t t-if="o.company_id.id == 1">
                                <img src="/emdad_account_enhance/static/img/EmdadAccountStamp.png"
                                     style="width: 220px; height: auto; display: inline-block; page-break-inside: avoid; break-inside: avoid;"/>
                            </t>
                            <t t-if="o.company_id.id == 2">
                                <img src="/emdad_account_enhance/static/img/OilAccountStamp.png"
                                     style="width: 220px; height: auto; display: inline-block; page-break-inside: avoid; break-inside: avoid;"/>
                            </t>
                        </div>
                    </div>
                </div>
            </xpath>
            <xpath expr="//div[@id='total']" position="after">
                <div style="margin-top: 10px; font-size: 14px; font-weight: 700; width: 100%; clear: both;">
                    <div style="display: flex; align-items: center; white-space: nowrap;">
                        <span>Payment Reference:</span>
                        <span style="margin: 0 6px;" t-field="o.name"/>
                        <span>:رقم إشارة الدفعة</span>
                    </div>
                    <div t-if="o.partner_bank_id" style="display: flex; align-items: center; white-space: nowrap; margin-top: 4px;">
                        <span>Bank Account Number:</span>
                        <span style="margin: 0 6px;" t-field="o.partner_bank_id.acc_number"/>
                    </div>
                </div>
            </xpath>
            <xpath expr="//div[hasclass('page')]" position="attributes">
                <attribute name="style" add="position: relative;" separator=";"/>
            </xpath>
            <xpath expr="//div[hasclass('page')]" position="inside">
                <style type="text/css">.page h2, .invoice_main .page h2 { display: none !important; } .page
                    #l10n_sa_qr_code, .invoice_main .page #l10n_sa_qr_code { display: none !important; } .page
                    #informations, .invoice_main .page #informations, .page div[name='invoice_date'], .page
                    div[name='due_date'], .page div[name='delivery_date'], .page div[name='origin'], .page
                    div[name='reference'], .page div[name='incoterm_id'] { display: none !important; }
                    .emdad-info-grid, .emdad-info-grid-row, .emdad-info-grid-cell { border: 0 !important; outline: 0
                    !important; box-shadow: none !important; background: transparent !important; } .emdad-info-grid-row
                    { display: table-row; line-height: 1.28; } .emdad-info-grid { display: table; table-layout: fixed;
                    width: 560px !important; max-width: 100%; margin-left: auto; margin-right: 0; }
                    .emdad-info-grid-cell { display: table-cell; vertical-align: top; padding-bottom: 2px; }
                    .emdad-info-label-en { width: 24%; white-space: nowrap; } .emdad-info-value { width: 45%; }
                    .emdad-info-label-ar { width: 31%; white-space: nowrap; } .emdad-hide-company-tax-lines { display:
                    none !important; height: 0 !important; line-height: 0 !important; overflow: hidden !important; }
                    table[name='invoice_line_table'] { page-break-inside: auto !important; break-inside: auto
                    !important; clear: both !important; margin-top: 0 !important; } table[name='invoice_line_table'] thead { display: table-header-group; }
                    table[name='invoice_line_table'] thead tr { page-break-inside: avoid !important; break-inside: avoid
                    !important; page-break-after: avoid !important; }
                    table[name='invoice_line_table'] tbody { page-break-before: auto !important; }
                    table[name='invoice_line_table'] tbody tr { page-break-inside: auto !important; break-inside: auto
                    !important; }
                    table[name='invoice_line_table'] tbody td, table[name='invoice_line_table'] tbody td * {
                    page-break-inside: auto !important; break-inside: auto !important; }
                </style>
                
            </xpath>
            <xpath expr="//table[@name='invoice_line_table']" position="before">
                <t t-set="sale_order" t-value="o.invoice_line_ids.sale_line_ids.order_id[:1]"/>
                <div class="row" style="margin-top: -8px; margin-bottom: 0; clear: both;">
                    <div class="col-12">
                        <div class="row" style="font-size: 22px; font-weight: 700; color: #1f2b3d;">
                            <div class="col-4 text-start">
                                <t t-if="o.move_type == 'in_invoice'">Vendor Bill</t>
                                <t t-else="">Tax Invoice</t>
                            </div>
                            <div class="col-4 text-center">
                                <span t-field="o.name"/>
                            </div>
                            <div class="col-4 text-end">
                                <t t-if="o.move_type == 'in_invoice'">فاتورة مورد</t>
                                <t t-else="">فاتورة ضريبية</t>
                            </div>
                        </div>
                    </div>
                </div>
                <div style="display: table; width: 100%; margin-top: 4px; margin-bottom: 0;">
                    <div style="display: table-cell; width: 130px; vertical-align: top; padding-right: 10px;">
                        <t t-if="o._l10n_sa_is_legal() and o.l10n_sa_qr_code_str">
                            <img style="width: 120px; height: 120px; display: block;"
                                t-att-src="'/report/barcode/?barcode_type=%s&amp;value=%s&amp;width=%s&amp;height=%s' % ('QR', quote_plus(o.l10n_sa_qr_code_str), 200, 200)"/>
                        </t>
                    </div>
                    <div style="display: table-cell; vertical-align: top;">
                        <div class="emdad-info-grid" style="border: 0 !important; outline: 0 !important; box-shadow: none !important;">
                            <div class="emdad-info-grid-row">
                                <div class="emdad-info-grid-cell emdad-info-label-en" style="color: #8db49a;">Invoice Date:</div>
                                <div class="emdad-info-grid-cell emdad-info-value" style="color: #1f2b3d;">
                                    <span t-field="o.invoice_date"/>
                                </div>
                                <div class="emdad-info-grid-cell emdad-info-label-ar" style="color: #8db49a; font-weight: 700; text-align: right;">:تاريخ الفاتورة</div>
                            </div>
                            <div class="emdad-info-grid-row">
                                <div class="emdad-info-grid-cell emdad-info-label-en" style="color: #8db49a;">Due Date:</div>
                                <div class="emdad-info-grid-cell emdad-info-value" style="color: #1f2b3d;">
                                    <span t-field="o.invoice_date_due"/>
                                </div>
                                <div class="emdad-info-grid-cell emdad-info-label-ar" style="color: #8db49a; font-weight: 700; text-align: right;">:تاريخ الاستحقاق</div>
                            </div>
                            <div class="emdad-info-grid-row">
                                <div class="emdad-info-grid-cell emdad-info-label-en" style="color: #8db49a;">Delivery Date:</div>
                                <div class="emdad-info-grid-cell emdad-info-value" style="color: #1f2b3d;">
                                    <span t-field="o.delivery_date"/>
                                </div>
                                <div class="emdad-info-grid-cell emdad-info-label-ar" style="color: #8db49a; font-weight: 700; text-align: right;">:تاريخ التوصيل</div>
                            </div>
                            <div class="emdad-info-grid-row">
                                <div class="emdad-info-grid-cell emdad-info-label-en" style="color: #8db49a; padding-bottom: 8px;">Source:</div>
                                <div class="emdad-info-grid-cell emdad-info-value"
                                     style="color: #1f2b3d; direction: ltr; text-align: left; white-space: normal; overflow-wrap: break-word; word-break: normal; line-height: 1.28; padding-bottom: 8px; padding-left: 4px; padding-right: 4px;"
                                     t-out="o.ref or ''"/>
                                <div class="emdad-info-grid-cell emdad-info-label-ar"
                                     style="color: #8db49a; font-weight: 700; text-align: right; padding-bottom: 8px;">
                                    :المصدر
                                </div>
                            </div>
                            <div class="emdad-info-grid-row">
                                <div class="emdad-info-grid-cell emdad-info-label-en" style="color: #8db49a;">PO Number:</div>
                                <div class="emdad-info-grid-cell emdad-info-value" style="color: #1f2b3d;"
                                    t-out="sale_order.vs_po_contract_ref if sale_order else o.vs_po_contract_ref or ''"/>
                                <div class="emdad-info-grid-cell emdad-info-label-ar" style="color: #8db49a; font-weight: 700; text-align: right;">:رقم أمر الشراء</div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
            <xpath expr="//table[@name='invoice_line_table']" position="attributes">
                <attribute name="style"
                           add="width: 100%; table-layout: fixed; direction: rtl; border-collapse: collapse; font-size: 12px; clear: both;"
                           separator=";"/>
            </xpath>
            <xpath expr="//td[@name='account_invoice_line_name']" position="attributes">
                <attribute name="class" remove="text-end" separator=" "/>
                <attribute name="class" add="text-start" separator=" "/>
                <attribute name="style">width: 32%; white-space: normal; word-break: break-word; border: 1px solid
                    #1f2b3d; padding: 6px 5px; vertical-align: middle; text-align: left; direction: ltr; background-color: #eeeded;
                </attribute>
            </xpath>
            <xpath expr="//td[@name='td_quantity']" position="attributes">
                <attribute name="class" add="text-center" separator=" "/>
                <attribute name="style">width: 7%; border: 1px solid #1f2b3d; padding: 6px 4px; vertical-align:
                    middle; direction: ltr;
                </attribute>
            </xpath>
            <xpath expr="//td[@name='td_price_unit']" position="attributes">
                <attribute name="class" add="text-center" separator=" "/>
                <attribute name="style">width: 9%; border: 1px solid #1f2b3d; padding: 6px 4px; vertical-align:
                    middle; direction: ltr;
                </attribute>
            </xpath>
            <xpath expr="//td[@name='td_discount']" position="replace">
                <td name="td_discount" t-if="display_discount" class="text-center"
                    style="width: 7%; border: 1px solid #1f2b3d; padding: 6px 4px; vertical-align: middle; direction: ltr;">
                    <span t-if="line.discount">
                        <t t-esc="'%.2f' % line.discount"/>%
                    </span>
                    <span t-else="">-</span>
                </td>
            </xpath>
            <xpath expr="//td[@name='td_taxes']" position="attributes">
                <attribute name="class" add="text-center" separator=" "/>
                <attribute name="style">width: 9%; white-space: normal; border: 1px solid #1f2b3d; padding: 6px 4px;
                    vertical-align: middle;
                </attribute>
            </xpath>
            <xpath expr="//td[@name='td_vat_amount']" position="attributes">
                <attribute name="class" add="text-center" separator=" "/>
                <attribute name="style">width: 16%; border: 1px solid #1f2b3d; padding: 6px 4px; vertical-align: 
                    middle; background-color: white;
                </attribute>
            </xpath>
            <xpath expr="//td[@name='td_vat_excl']" position="attributes">
                <attribute name="class" add="text-center" separator=" "/>
                <attribute name="style">width: 9%; border: 1px solid #1f2b3d; padding: 6px 4px; vertical-align:
                    middle; background-color: white;
                </attribute>
            </xpath>
            <xpath expr="//td[@name='td_vat_incl']" position="attributes">
                <attribute name="class" add="text-center" separator=" "/>
                <attribute name="style">width: 18%; border: 1px solid #1f2b3d; white-space: normal; padding: 6px 4px;
                    vertical-align: middle; background-color: white;
                </attribute>
            </xpath>
            <xpath expr="//td[@name='td_vat_amount']/span" position="replace">
                <span class="text-nowrap" dir="ltr">
                    <t t-esc="'%.2f' % line.price_subtotal"/> SR
                </span>
            </xpath>
            <xpath expr="//td[@name='td_vat_excl']/span" position="replace">
                <span class="text-nowrap" dir="ltr">
                    <t t-esc="'%.2f' % line.l10n_gcc_invoice_tax_amount"/> SR
                </span>
            </xpath>
            <xpath expr="//td[@name='td_vat_incl']//span[@t-field='line.price_total']" position="replace">
                <span class="text-nowrap" dir="ltr">
                    <t t-esc="'%.2f' % line.price_total"/> SR
                </span>
            </xpath>
            <xpath expr="//th[@name='th_description']" position="replace">
                <th name="th_description" class="text-end"
                    style="width: 34%; text-align: right; white-space: normal; border: 1px solid #1f2b3d;  padding: 6px 5px; vertical-align: middle; line-height: 1.2; background-color: #eeeded;">
                    <span style="display: block; text-align: right;">
                        الوصف
                        <br/>
                        DESCRIPTION
                    </span>
                </th>
            </xpath>
            <xpath expr="//th[@name='th_quantity']" position="replace">
                <th name="th_quantity" class="text-center"
                    style="width: 8%; border: 1px solid #1f2b3d;  padding: 6px 4px; vertical-align: middle; line-height: 1.2; background-color: #eeeded;">
                    <span>
                        الكمية
                        <br/>
                        QUANTITY
                    </span>
                </th>
            </xpath>
            <xpath expr="//th[@name='th_priceunit']" position="replace">
                <th name="th_priceunit" class="text-center"
                    style="width: 9%; border: 1px solid #1f2b3d;  padding: 6px 4px; vertical-align: middle; line-height: 1.2; background-color: #eeeded;">
                    <span>
                        سعر الوحدة
                        <br/>
                        UNIT PRICE
                    </span>
                </th>
            </xpath>
            <xpath expr="//th[@name='th_discount']" position="replace">
                <th name="th_discount" t-if="display_discount" class="text-center"
                    style="width: 7%; border: 1px solid #1f2b3d; padding: 6px 4px; vertical-align: middle; line-height: 1.2; background-color: #eeeded;">
                    <span>
                        الخصم
                        <br/>
                        DISC%
                    </span>
                </th>
            </xpath>
            <xpath expr="//th[@name='th_taxes']" position="replace">
                <th name="th_taxes" class="text-center"
                    style="width: 7%; white-space: normal; border: 1px solid #1f2b3d;  padding: 6px 4px; vertical-align: middle; line-height: 1.2; background-color: #eeeded;">
                    <span>
                        نسبة الضريبة
                        <br/>
                        TAXES
                    </span>
                </th>
            </xpath>
            <xpath expr="//th[@name='th_vat_amount']" position="replace">
                <th name="th_vat_amount" class="text-center"
                    style="width: 16%; border: 1px solid #1f2b3d; padding: 6px 4px; vertical-align: middle; line-height: 1.2; background-color: #eeeded;">
                    <span>
                        المجموع الفرعي بدون الضريبة
                        <br/>
                        SUBTOTAL
                        <br/>
                        (EXCLUSIVE OF VAT)
                    </span>
                </th>
            </xpath>
            <xpath expr="//th[@name='th_vat_excl']" position="replace">
                <th name="th_vat_excl" class="text-center"
                    style="width: 9%; border: 1px solid #1f2b3d;  padding: 6px 4px; vertical-align: middle; line-height: 1.2; background-color: #eeeded;">
                    <span>
                        قيمة الضريبة
                        <br/>
                        VAT AMOUNT
                    </span>
                </th>
            </xpath>
            <xpath expr="//th[@name='th_vat_incl']" position="replace">
                <th name="th_vat_incl" class="text-center"
                    style="width: 18%; border: 1px solid #1f2b3d; white-space: normal; word-break: break-word;  padding: 6px 4px; vertical-align: middle; line-height: 1.2; background-color: #eeeded;">
                    <span>
                        المجموع شامل ضريبة القيمة المضافة
                        <br/>
                        SUBTOTAL
                        <br/>
                        (INCLUSIVE OF VAT)
                    </span>
                </th>
            </xpath>
        </template>
        <template id="address_layout_custom" inherit_id="web.address_layout">
            <xpath expr="//div[@name='information_block']" position="replace">
                <div name="information_block" class="col-6">
                    <t t-if="o and o._name == 'account.move'">
                        <t t-set="identification_labels"
                           t-value="['700 Number', 'Tax Identification Number', 'Commercial Registration Number', 'Momra License', 'MLSD License', 'Sagia License', 'National ID', 'GCC ID', 'Iqama Number', 'Passport ID', 'Other ID']"/>
                        <t t-set="clean_information_lines"
                           t-value="[line for line in (information_block or '').replace('&lt;br&gt;', '&lt;br/&gt;').replace('&lt;br /&gt;', '&lt;br/&gt;').split('&lt;br/&gt;') if 'VAT Number' not in line and not [label for label in identification_labels if label in line]]"/>
                        <t t-foreach="clean_information_lines" t-as="information_line">
                            <t t-out="information_line"/>
                            <br t-if="not information_line_last"/>
                        </t>
                    </t>
                    <t t-else="">
                        <t t-out="information_block or None"/>
                    </t>
                </div>
            </xpath>
            <xpath expr="//div[@name='address']" position="replace">
                <t t-if="o and o._name == 'account.move'">
                    <div name="address" class="col-12 mt-0 text-end"
                        style="max-width: calc(100% - 190px); margin-left: auto; margin-right: 0; line-height: 1.15;">
                        <t t-set="address_partner" t-value="o.partner_id"/>
                        <t t-set="address_parts"
                        t-value="[part for part in [address_partner.street, address_partner.street2, address_partner.city, address_partner.state_id.name, address_partner.zip, address_partner.country_id.name] if part]"/>
                        <div t-if="address_partner.name" style="font-weight: bold;" t-out="address_partner.name"/>
                        <div t-if="address_parts"
                            style="line-height: 1.15; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;"
                            t-out="', '.join(address_parts)"/>
                        <div t-if="address_partner.vat" style="line-height: 1.15;">
                            VAT Number:
                            <span t-out="address_partner.vat"/>
                        </div>
                        <div t-if="address_partner.l10n_sa_edi_additional_identification_scheme and address_partner.l10n_sa_edi_additional_identification_number"
                            style="line-height: 1.15;">
                            <span t-out="dict(address_partner._fields['l10n_sa_edi_additional_identification_scheme'].selection).get(address_partner.l10n_sa_edi_additional_identification_scheme, address_partner.l10n_sa_edi_additional_identification_scheme)"/>:
                            <span t-out="address_partner.l10n_sa_edi_additional_identification_number"/>
                        </div>
                    </div>
                </t>
                <div t-else="" name="address" t-att-class="not custom_layout_address and colclass or information_block and colclass">
                    <t t-out="address or None"/>
                </div>
            </xpath>
        </template>
        <template id="clean_company_details_without_vat_number">
            <t t-set="_emdad_company_details"
               t-value="(company.company_details or '').replace('&lt;br&gt;', '&lt;br/&gt;').replace('&lt;br /&gt;', '&lt;br/&gt;')"/>
            <t t-set="_emdad_company_detail_lines"
               t-value="[line for line in _emdad_company_details.split('&lt;br/&gt;') if 'VAT Number' not in line]"/>
            <t t-foreach="_emdad_company_detail_lines" t-as="_emdad_company_detail_line">
                <t t-out="_emdad_company_detail_line"/>
                <br t-if="not _emdad_company_detail_line_last"/>
            </t>
        </template>
        <template id="external_layout_standard_company_details_without_vat_number"
                  inherit_id="web.external_layout_standard" priority="100000">
            <xpath expr="//span[@t-field='company.company_details']" position="replace">
                <t t-if="o and o._name == 'account.move'"
