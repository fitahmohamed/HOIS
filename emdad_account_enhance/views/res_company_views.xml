<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_company_form_without_vat" model="ir.ui.view">
            <field name="name">res.company.form.without.vat</field>
            <field name="model">res.company</field>
            <field name="inherit_id" ref="base.view_company_form"/>
            <field name="priority">99999</field>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='vat']" position="replace"/>
            </field>
        </record>

        <record id="account_view_company_form_without_vat" model="ir.ui.view">
            <field name="name">res.company.form.account.without.vat</field>
            <field name="model">res.company</field>
            <field name="inherit_id" ref="account.view_company_form"/>
            <field name="priority">99999</field>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='vat']" position="replace"/>
            </field>
        </record>

        <record id="res_company_form_view_onboarding_without_vat" model="ir.ui.view">
            <field name="name">res.company.form.onboarding.without.vat</field>
            <field name="model">res.company</field>
            <field name="inherit_id" ref="account.res_company_form_view_onboarding"/>
            <field name="priority">99999</field>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='vat']" position="replace"/>
            </field>
        </record>
    </data>
</odoo>