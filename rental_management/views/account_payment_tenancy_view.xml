<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

    

        <!-- Inherit account.payment form to show contract info panel -->
        <record id="account_payment_tenancy_form_inherit" model="ir.ui.view">
            <field name="name">account.payment.tenancy.form.inherit</field>
            <field name="model">account.payment</field>
            <field name="inherit_id" ref="account.view_account_payment_form" />
            <field name="priority" eval="8" />
            <field name="arch" type="xml">
                <!-- Hidden fields needed for domain/related -->
                <xpath expr="//sheet" position="before">
                    <field name="tenancy_id" invisible="1" />
                    <field name="tenancy_property_id" invisible="1" />
                    <field name="tenancy_landlord_id" invisible="1" />
                    <field name="tenancy_journal_entry_id" invisible="1" />
                </xpath>
                <!-- Journal entry smart button -->
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button class="oe_stat_button" type="object"
                            name="action_open_tenancy_journal_entry"
                            icon="fa-book"
                            invisible="not tenancy_journal_entry_id">
                        <div class="o_field_widget o_stat_info">
                            <span class="o_stat_text">Journal Entry</span>
                        </div>
                    </button>
                </xpath>
                <!-- Contract info panel after the main sheet -->
                <xpath expr="//sheet" position="after">
                    <div class="o_field_widget o_stat_buttons"
                         invisible="not tenancy_id">
                    </div>
                </xpath>
                <!-- Add contract details inside sheet, before chatter -->
                <xpath expr="//sheet//group[1]" position="after">
                    <group string="تفاصيل العقد"
                           invisible="not tenancy_id"
                           name="tenancy_contract_info">
                        <group>
                            <field name="tenancy_seq"
                                   string="رقم العقد"
                                   readonly="1" />
                            <field name="tenancy_property_id"
                                   string="الوحدة / العقار"
                                   readonly="1"
                                   options="{'no_open': False}" />
                            <field name="tenancy_landlord_id"
                                   string="المالك"
                                   readonly="1"
                                   options="{'no_open': False}" />
                        </group>
                        <group>
                            <field name="tenancy_tenant_id"
                                   string="المستأجر"
                                   readonly="1"
                                   options="{'no_open': False}" />
                            <field name="tenancy_start_date"
                                   string="بداية العقد"
                                   readonly="1" />
                            <field name="tenancy_end_date"
                                   string="نهاية العقد"
                                   readonly="1" />
                            <field name="tenancy_payment_term"
                                   string="دورية السداد"
                                   readonly="1" />
                        </group>
                    </group>
                </xpath>
            </field>
        </record>


        <!-- Inherit account.move form to show contract info in commission invoices and journal entries -->
        <record id="account_move_tenancy_commission_form_inherit" model="ir.ui.view">
            <field name="name">account.move.tenancy.commission.form.inherit</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form" />
            <field name="priority" eval="8" />
            <field name="arch" type="xml">
                <xpath expr="//sheet//group[1]" position="after">
                    <group string="بيانات العقد"
                           invisible="not tenancy_commission_id and not tenancy_journal_id"
                           name="tenancy_move_info">
                        <group>
                            <field name="tenancy_commission_id" readonly="1"
                                   invisible="not tenancy_commission_id" />
                            <field name="tenancy_journal_id" readonly="1"
                                   invisible="not tenancy_journal_id" />
                            <field name="tenancy_commission_property_id" readonly="1"
                                   invisible="not tenancy_commission_id"
                                   string="الوحدة" />
                            <field name="tenancy_journal_property_id" readonly="1"
                                   invisible="not tenancy_journal_id"
                                   string="الوحدة" />
                        </group>
                        <group>
                            <field name="tenancy_commission_landlord_id" readonly="1"
                                   invisible="not tenancy_commission_id"
                                   string="المالك" />
                            <field name="tenancy_journal_landlord_id" readonly="1"
                                   invisible="not tenancy_journal_id"
                                   string="المالك" />
                            <field name="tenancy_commission_tenant_id" readonly="1"
                                   invisible="not tenancy_commission_id"
                                   string="المستأجر" />
                            <field name="tenancy_journal_tenant_id" readonly="1"
                                   invisible="not tenancy_journal_id"
                                   string="المستأجر" />
                        </group>
                    </group>
                </xpath>
            </field>
        </record>

    

    </data>
</odoo>
