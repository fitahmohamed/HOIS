<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="payment_customer_print_out_rental_details"
              inherit_id="bi_account_payment_customization.payment_customer_print_out_custom">
        <xpath expr="//span[@t-if='o.journal_id']/ancestor::h4[1]" position="after">
            <div t-if="o.tenancy_id" style="margin-top: 35px;">
                <h4 style="font-weight: bold; margin-bottom: 15px;">تفاصيل سند قبض الإيجار</h4>
                <table style="width: 100%; border-collapse: collapse; font-size: 15px;" class="table table-bordered" dir="rtl">
                    <tr>
                        <td style="width: 16%; font-weight: bold; background-color: #f5f5f5;">المالك</td>
                        <td style="width: 34%;">
                            <span t-if="o.tenancy_landlord_id" t-field="o.tenancy_landlord_id.name"/>
                            <span t-if="not o.tenancy_landlord_id">................</span>
                        </td>
                        <td style="width: 16%; font-weight: bold; background-color: #f5f5f5;">هاتف المالك</td>
                        <td style="width: 34%;">
                            <span t-if="o.tenancy_landlord_id and o.tenancy_landlord_id.phone" t-field="o.tenancy_landlord_id.phone"/>
                            <span t-else="">................</span>
                        </td>
                    </tr>
                    <tr>
                        <td style="font-weight: bold; background-color: #f5f5f5;">بريد المالك</td>
                        <td>
                            <span t-if="o.tenancy_landlord_id and o.tenancy_landlord_id.email" t-field="o.tenancy_landlord_id.email"/>
                            <span t-else="">................</span>
                        </td>
                        <td style="font-weight: bold; background-color: #f5f5f5;">الرقم الضريبي</td>
                        <td>
                            <span t-if="o.tenancy_landlord_id and o.tenancy_landlord_id.vat" t-field="o.tenancy_landlord_id.vat"/>
                            <span t-else="">................</span>
                        </td>
                    </tr>
                    <tr>
                        <td style="font-weight: bold; background-color: #f5f5f5;">عنوان المالك</td>
                        <td colspan="3">
                            <span t-if="o.tenancy_landlord_id and o.tenancy_landlord_id.contact_address" t-field="o.tenancy_landlord_id.contact_address"/>
                            <span t-else="">................</span>
                        </td>
                    </tr>
                    <tr>
                        <td style="font-weight: bold; background-color: #f5f5f5;">رقم العقد</td>
                        <td>
                            <span t-if="o.tenancy_seq" t-field="o.tenancy_seq"/>
                            <span t-else="">................</span>
                        </td>
                        <td style="font-weight: bold; background-color: #f5f5f5;">الوحدة / العقار</td>
                        <td>
                            <span t-if="o.tenancy_property_id" t-field="o.tenancy_property_id.name"/>
                            <span t-else="">................</span>
                        </td>
                    </tr>
                    <tr>
                        <td style="font-weight: bold; background-color: #f5f5f5;">المستأجر</td>
                        <td>
                            <span t-if="o.tenancy_tenant_id" t-field="o.tenancy_tenant_id.name"/>
                            <span t-else="">................</span>
                        </td>
                        <td style="font-weight: bold; background-color: #f5f5f5;">دورية السداد</td>
                        <td>
                            <span t-if="o.tenancy_payment_term" t-field="o.tenancy_payment_term"/>
                            <span t-else="">................</span>
                        </td>
                    </tr>
                    <tr>
                        <td style="font-weight: bold; background-color: #f5f5f5;">بداية العقد</td>
                        <td>
                            <span t-if="o.tenancy_start_date" t-field="o.tenancy_start_date" t-options='{"format": "dd/MM/yyyy"}'/>
                            <span t-else="">................</span>
                        </td>
                        <td style="font-weight: bold; background-color: #f5f5f5;">نهاية العقد</td>
                        <td>
                            <span t-if="o.tenancy_end_date" t-field="o.tenancy_end_date" t-options='{"format": "dd/MM/yyyy"}'/>
                            <span t-else="">................</span>
                        </td>
                    </tr>
                    <tr>
                        <td style="font-weight: bold; background-color: #f5f5f5;">تاريخ الدفعة</td>
                        <td colspan="3">
                            <span t-if="o.tenancy_installment_id and o.tenancy_installment_id.invoice_date" t-field="o.tenancy_installment_id.invoice_date" t-options='{"format": "dd/MM/yyyy"}'/>
                            <span t-else="">................</span>
                        </td>
                    </tr>
                    <tr>
                        <td style="font-weight: bold; background-color: #f5f5f5;">بيان الدفعة</td>
                        <td>
                            <span t-if="o.tenancy_installment_id and o.tenancy_installment_id.description" t-field="o.tenancy_installment_id.description"/>
                            <span t-elif="o.memo" t-field="o.memo"/>
                            <span t-else="">................</span>
                        </td>
                        <td style="font-weight: bold; background-color: #f5f5f5;">المحصل</td>
                        <td>
                            <span t-if="o.create_uid" t-field="o.create_uid.name"/>
                            <span t-else="">................</span>
                        </td>
                    </tr>
                </table>
            </div>
        </xpath>
    </template>

    <template id="standard_payment_receipt_rental_details"
              inherit_id="account.report_payment_receipt_document">
        <xpath expr="//div[@name='date']" position="replace"/>
        <xpath expr="//table[@name='invoices']" position="replace"/>
        <xpath expr="//div[@name='payment_method']" position="replace">
            <div name="payment_method"
                 t-if="o.journal_id"
                 class="col-6">
                Payment Method: <span t-field="o.journal_id.name"/>
            </div>
        </xpath>
        <xpath expr="//div[contains(@class, 'mb-4') and contains(@class, 'mt-3')]" position="after">
            <div t-if="o.tenancy_id" style="margin-top: 20px; direction: rtl;">
                <h4 style="font-weight: bold; margin-bottom: 15px;">تفاصيل سند قبض الإيجار</h4>
                <table style="width: 100%; border-collapse: collapse; font-size: 14px;" class="table table-bordered">
                    <tr>
                        <td style="width: 16%; font-weight: bold; background-color: #f5f5f5;">المالك</td>
                        <td style="width: 34%;">
                            <span t-if="o.tenancy_landlord_id" t-field="o.tenancy_landlord_id.name"/>
                            <span t-if="not o.tenancy_landlord_id">................</span>
                        </td>
                        <td style="width: 16%; font-weight: bold; background-color: #f5f5f5;">هاتف المالك</td>
                        <td style="width: 34%;">
                            <span t-if="o.tenancy_landlord_id and o.tenancy_landlord_id.phone" t-field="o.tenancy_landlord_id.phone"/>
                            <span t-else="">................</span>
                        </td>
                    </tr>
                    <tr>
                        <td style="font-weight: bold; background-color: #f5f5f5;">رقم العقد</td>
                        <td>
                            <span t-if="o.tenancy_seq" t-field="o.tenancy_seq"/>
                            <span t-else="">................</span>
                        </td>
                        <td style="font-weight: bold; background-color: #f5f5f5;">الوحدة / العقار</td>
                        <td>
                            <span t-if="o.tenancy_property_id" t-field="o.tenancy_property_id.name"/>
                            <span t-else="">................</span>
                        </td>
                    </tr>
                    <tr>
                        <td style="font-weight: bold; background-color: #f5f5f5;">المستأجر</td>
                        <td>
                            <span t-if="o.tenancy_tenant_id" t-field="o.tenancy_tenant_id.name"/>
                            <span t-else="">................</span>
                        </td>
                        <td style="font-weight: bold; background-color: #f5f5f5;">دورية السداد</td>
                        <td>
                            <span t-if="o.tenancy_payment_term" t-field="o.tenancy_payment_term"/>
                            <span t-else="">................</span>
                        </td>
                    </tr>
                    <tr>
                        <td style="font-weight: bold; background-color: #f5f5f5;">بداية العقد</td>
                        <td>
                            <span t-if="o.tenancy_start_date" t-field="o.tenancy_start_date" t-options='{"format": "dd/MM/yyyy"}'/>
                            <span t-else="">................</span>
                        </td>
                        <td style="font-weight: bold; background-color: #f5f5f5;">نهاية العقد</td>
                        <td>
                            <span t-if="o.tenancy_end_date" t-field="o.tenancy_end_date" t-options='{"format": "dd/MM/yyyy"}'/>
                            <span t-else="">................</span>
                        </td>
                    </tr>
                    <tr>
                        <td style="font-weight: bold; background-color: #f5f5f5;">تاريخ الدفعة</td>
                        <td>
                            <span t-if="o.tenancy_installment_id and o.tenancy_installment_id.invoice_date" t-field="o.tenancy_installment_id.invoice_date" t-options='{"format": "dd/MM/yyyy"}'/>
                            <span t-else="">................</span>
                        </td>
                        <td style="font-weight: bold; background-color: #f5f5f5;">تاريخ الدفع</td>
                        <td>
                            <span t-if="o.create_date" t-field="o.create_date" t-options='{"format": "dd/MM/yyyy"}'/>
                            <span t-else="">................</span>
                        </td>
                    </tr>
                    <tr>
                        <td style="font-weight: bold; background-color: #f5f5f5;">بيان الدفعة</td>
                        <td>
                            <span t-if="o.tenancy_installment_id and o.tenancy_installment_id.description" t-field="o.tenancy_installment_id.description"/>
                            <span t-elif="o.memo" t-field="o.memo"/>
                            <span t-else="">................</span>
                        </td>
                        <td style="font-weight: bold; background-color: #f5f5f5;">المحصل</td>
                        <td>
                            <span t-if="o.create_uid" t-field="o.create_uid.name"/>
                            <span t-else="">................</span>
                        </td>
                    </tr>
                </table>
            </div>
        </xpath>
        <xpath expr="//div[contains(@class, 'page')]" position="inside">
            <div style="margin-top: 70px; width: 100%; page-break-inside: avoid;">
                <table style="width: 100%; border-collapse: collapse;" class="table table-borderless">
                    <tr>
                        <td style="width: 45%; text-align: center;">
                            <strong>Manager المدير</strong>
                        </td>
                        <td style="width: 10%;"/>
                        <td style="width: 45%; text-align: center;">
                            <strong>Received المستلم</strong>
                        </td>
                    </tr>
                    <tr>
                        <td style="height: 45px; text-align: center; vertical-align: bottom;">................................................</td>
                        <td/>
                        <td style="height: 45px; text-align: center; vertical-align: bottom;">................................................</td>
                    </tr>
                </table>
            </div>
        </xpath>
    </template>
</odoo>