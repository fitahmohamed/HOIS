<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="action_landlord_commission_report_v2" model="ir.actions.report">
            <field name="name">تقرير المالك</field>
            <field name="model">landlord.commission.report</field>
            <field name="report_type">qweb-html</field>
            <field name="report_name">rental_management.report_landlord_commission_v2</field>
            <field name="report_file">rental_management.report_landlord_commission_v2</field>
        </record>

        <template id="report_landlord_commission_v2">
            <t t-call="web.html_container">
                <t t-call="web.external_layout">

                    <div class="page" style="font-family:'Segoe UI',Arial,sans-serif; direction:rtl; color:#222; font-size:13px;">

                        <!-- ====== HEADER ====== -->
                        <table style="width:100%; border-collapse:collapse; margin-bottom:16px;">
                            <tr>
                                <td style="width:60%; vertical-align:top;">
                                    <div style="font-size:20px; font-weight:700; color:#1a3c6e; border-bottom:3px solid #1a3c6e; padding-bottom:4px; margin-bottom:8px;">
                                        كشف حساب المالك
                                    </div>
                                    <table style="border-collapse:collapse;">
                                        <tr>
                                            <td style="padding:3px 0; min-width:110px; font-weight:600; color:#555;">العمارة / المشروع:</td>
                                            <td style="padding:3px 8px; font-weight:700;"><t t-esc="subproject_name"/></td>
                                        </tr>
                                        <tr>
                                            <td style="padding:3px 0; font-weight:600; color:#555;">المالك:</td>
                                            <td style="padding:3px 8px;"><t t-esc="landlord_name or '—'"/></td>
                                        </tr>
                                        <tr>
                                            <td style="padding:3px 0; font-weight:600; color:#555;">الفترة:</td>
                                            <td style="padding:3px 8px;">
                                                <t t-esc="df"/> — <t t-esc="dt"/>
                                            </td>
                                        </tr>
                                    </table>
                                </td>
                                <td style="width:40%; vertical-align:top; text-align:left;">
                                    <table style="border-collapse:collapse; border:1px solid #ccc; width:100%; font-size:13px;">
                                        <tr style="background:#1a3c6e; color:#fff;">
                                            <th style="padding:7px 12px; text-align:right;">البيان</th>
                                            <th style="padding:7px 12px; text-align:center;">العدد</th>
                                        </tr>
                                        <tr>
                                            <td style="padding:6px 12px;">إجمالي الوحدات</td>
                                            <td style="padding:6px 12px; text-align:center; font-weight:700;"><t t-esc="all_units_count"/></td>
                                        </tr>
                                        <tr style="background:#f0f9f4;">
                                            <td style="padding:6px 12px; color:#27ae60; font-weight:600;">الموجر</td>
                                            <td style="padding:6px 12px; text-align:center; font-weight:700; color:#27ae60;"><t t-esc="rented_count"/></td>
                                        </tr>
                                        <tr style="background:#fffbf0;">
                                            <td style="padding:6px 12px; color:#e67e22; font-weight:600;">الشاغر</td>
                                            <td style="padding:6px 12px; text-align:center; font-weight:700; color:#e67e22;"><t t-esc="vacant_count"/></td>
                                        </tr>
                                        <tr>
                                            <td style="padding:6px 12px; font-weight:600; color:#555;">تاريخ الطباعة</td>
                                            <td style="padding:6px 12px; text-align:center; font-size:11px;"><t t-esc="print_date"/></td>
                                        </tr>
                                    </table>
                                </td>
                            </tr>
                        </table>

                        <!-- ====== CONTRACTS TABLE ====== -->
                        <table style="width:100%; border-collapse:collapse; font-size:12px; margin-bottom:20px;">
                            <thead>
                                <tr style="background:#1a3c6e; color:#fff; text-align:center;">
                                    <th style="padding:8px 6px; border:1px solid #1a3c6e;">#</th>
                                    <th style="padding:8px 6px; border:1px solid #1a3c6e; text-align:right;">الوحدة</th>
                                    <th style="padding:8px 6px; border:1px solid #1a3c6e; text-align:right;">المستأجر</th>
                                    <th style="padding:8px 6px; border:1px solid #1a3c6e;">الإيجار الشهري</th>
                                    <th style="padding:8px 6px; border:1px solid #1a3c6e;">عدد الدفعات</th>
                                    <th style="padding:8px 6px; border:1px solid #1a3c6e;">المسدد</th>
                                    <th style="padding:8px 6px; border:1px solid #1a3c6e;">المتبقي</th>
                                    <th style="padding:8px 6px; border:1px solid #1a3c6e;">المتعثرات</th>
                                    <th style="padding:8px 6px; border:1px solid #1a3c6e;">العمولة</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="contract_lines" t-as="cl">
                                    <tr t-att-style="'background:#fff;' if cl_index % 2 == 0 else 'background:#f7f9fc;'">
                                        <td style="padding:7px 6px; border:1px solid #ddd; text-align:center;"><t t-esc="cl_index + 1"/></td>
                                        <td style="padding:7px 6px; border:1px solid #ddd; font-weight:600;"><t t-esc="cl.get('unit_name', '')"/></td>
                                        <td style="padding:7px 6px; border:1px solid #ddd;"><t t-esc="cl.get('tenant_name', '—')"/></td>
                                        <td style="padding:7px 6px; border:1px solid #ddd; text-align:center;"><t t-esc="'{:,.2f}'.format(cl.get('monthly_rent', 0))"/></td>
                                        <td style="padding:7px 6px; border:1px solid #ddd; text-align:center;"><t t-esc="cl.get('inv_count', 0)"/></td>
                                        <td style="padding:7px 6px; border:1px solid #ddd; text-align:center; color:#27ae60; font-weight:600;"><t t-esc="'{:,.2f}'.format(cl.get('paid', 0))"/></td>
                                        <td style="padding:7px 6px; border:1px solid #ddd; text-align:center; color:#e74c3c;"><t t-esc="'{:,.2f}'.format(cl.get('remaining', 0))"/></td>
                                        <td style="padding:7px 6px; border:1px solid #ddd; text-align:center; color:#c0392b; font-weight:600;"><t t-esc="'{:,.2f}'.format(cl.get('overdue', 0))"/></td>
                                        <td style="padding:7px 6px; border:1px solid #ddd; text-align:center;"><t t-esc="'{:,.2f}'.format(cl.get('commission', 0))"/></td>
                                    </tr>
                                </t>
                            </tbody>
                            <tfoot>
                                <tr style="background:#1a3c6e; color:#fff; font-weight:700; text-align:center;">
                                    <td style="padding:8px 6px; border:1px solid #1a3c6e;" colspan="2">الإجمالي</td>
                                    <td style="padding:8px 6px; border:1px solid #1a3c6e;"></td>
                                    <td style="padding:8px 6px; border:1px solid #1a3c6e;"></td>
                                    <td style="padding:8px 6px; border:1px solid #1a3c6e;"><t t-esc="total_inv_count"/></td>
                                    <td style="padding:8px 6px; border:1px solid #1a3c6e;"><t t-esc="'{:,.2f}'.format(g_paid)"/></td>
                                    <td style="padding:8px 6px; border:1px solid #1a3c6e;"><t t-esc="'{:,.2f}'.format(g_total - g_paid)"/></td>
                                    <td style="padding:8px 6px; border:1px solid #1a3c6e;"><t t-esc="'{:,.2f}'.format(g_over)"/></td>
                                    <td style="padding:8px 6px; border:1px solid #1a3c6e;"><t t-esc="'{:,.2f}'.format(g_comm)"/></td>
                                </tr>
                            </tfoot>
                        </table>

                        <!-- ====== EXPENSES TABLE ====== -->
                        <div style="font-size:13px; font-weight:700; color:#7b2d2d; border-bottom:2px solid #7b2d2d; padding-bottom:4px; margin-bottom:10px; margin-top:4px;">
                            المصروفات
                        </div>
                        <table style="width:100%; border-collapse:collapse; font-size:12px; margin-bottom:20px;">
                            <thead>
                                <tr style="background:#7b2d2d; color:#fff; text-align:center;">
                                    <th style="padding:7px 6px; border:1px solid #7b2d2d;">#</th>
                                    <th style="padding:7px 6px; border:1px solid #7b2d2d; text-align:right;">التاريخ</th>
                                    <th style="padding:7px 6px; border:1px solid #7b2d2d; text-align:right;">القيد</th>
                                    <th style="padding:7px 6px; border:1px solid #7b2d2d; text-align:right;">الحساب</th>
                                    <th style="padding:7px 6px; border:1px solid #7b2d2d; text-align:right;">البيان</th>
                                    <th style="padding:7px 6px; border:1px solid #7b2d2d;">المبلغ</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-if="expenses">
                                    <t t-foreach="expenses" t-as="exp">
                                        <tr t-att-style="'background:#fff5f5;' if exp_index % 2 == 0 else 'background:#ffffff;'">
                                            <td style="padding:6px; border:1px solid #ddd; text-align:center;"><t t-esc="exp_index + 1"/></td>
                                            <td style="padding:6px; border:1px solid #ddd;"><t t-esc="exp.get('date', '')"/></td>
                                            <td style="padding:6px; border:1px solid #ddd;"><t t-esc="exp.get('move_name', '')"/></td>
                                            <td style="padding:6px; border:1px solid #ddd;"><t t-esc="exp.get('account', '')"/></td>
                                            <td style="padding:6px; border:1px solid #ddd;"><t t-esc="exp.get('description', '')"/></td>
                                            <td style="padding:6px; border:1px solid #ddd; text-align:center; color:#c0392b; font-weight:600;"><t t-esc="'{:,.2f}'.format(exp.get('amount', 0))"/></td>
                                        </tr>
                                    </t>
                                </t>
                                <t t-else="">
                                    <tr>
                                        <td colspan="6" style="padding:10px; border:1px solid #ddd; text-align:center; color:#999; font-style:italic;">
                                            لا توجد مصروفات مسجلة لهذه الفترة
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                            <tfoot>
                                <tr style="background:#7b2d2d; color:#fff; font-weight:700;">
                                    <td colspan="5" style="padding:8px 14px; border:1px solid #7b2d2d; text-align:right;">إجمالي المصروفات</td>
                                    <td style="padding:8px 14px; border:1px solid #7b2d2d; text-align:center;"><t t-esc="'{:,.2f}'.format(total_expenses)"/></td>
                                </tr>
                            </tfoot>
                        </table>

                        <!-- ====== FINANCIAL SUMMARY ====== -->
                        <table style="width:50%; border-collapse:collapse; font-size:13px; margin-bottom:30px;">
                            <tr style="background:#1a3c6e; color:#fff;">
                                <th style="padding:8px 14px; border:1px solid #1a3c6e; text-align:right;" colspan="2">الملخص المالي</th>
                            </tr>
                            <tr>
                                <td style="padding:8px 14px; border:1px solid #ddd; font-weight:600; background:#f7f9fc;">التوريد (إجمالي المحصل)</td>
                                <td style="padding:8px 14px; border:1px solid #ddd; text-align:center; font-weight:700;"><t t-esc="'{:,.2f}'.format(g_paid)"/></td>
                            </tr>
                            <tr>
                                <td style="padding:8px 14px; border:1px solid #ddd; font-weight:600; background:#f7f9fc;">العمولة</td>
                                <td style="padding:8px 14px; border:1px solid #ddd; text-align:center;"><t t-esc="'{:,.2f}'.format(g_comm)"/></td>
                            </tr>
                            <tr>
                                <td style="padding:8px 14px; border:1px solid #ddd; font-weight:600; background:#fff5f5; color:#c0392b;">المصروفات</td>
                                <td style="padding:8px 14px; border:1px solid #ddd; text-align:center; color:#c0392b; font-weight:600;"><t t-esc="'{:,.2f}'.format(total_expenses)"/></td>
                            </tr>
                            <tr style="background:#e8f8f0;">
                                <td style="padding:8px 14px; border:1px solid #ddd; font-weight:700; color:#1a3c6e;">الصافي للمالك</td>
                                <td style="padding:8px 14px; border:1px solid #ddd; text-align:center; font-weight:700; color:#1a3c6e; font-size:14px;"><t t-esc="'{:,.2f}'.format(net_owner)"/></td>
                            </tr>
                        </table>

                        <!-- ====== SIGNATURES ====== -->
                        <table style="width:100%; border-collapse:collapse; margin-top:50px;">
                            <tr>
                                <td style="width:35%; text-align:center; padding-top:40px; border-top:1px solid #333;">
                                    توقيع المالك
                                </td>
                                <td style="width:30%;"></td>
                                <td style="width:35%; text-align:center; padding-top:40px; border-top:1px solid #333;">
                                    توقيع الشركة
                                </td>
                            </tr>
                        </table>

                    </div>
                </t>
            </t>
        </template>

    </data>
</odoo>
