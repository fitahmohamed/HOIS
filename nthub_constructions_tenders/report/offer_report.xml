<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="report_offer" model="ir.actions.report">
            <field name="name">Offer Report</field>
            <field name="model">tender.offer</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">nthub_constructions_tenders.tender_offer_contract</field>
            <field name="report_file">nthub_constructions_tenders.tender_offer_contract</field>
            <field name="binding_model_id" ref="model_tender_offer"/>
            <field name="binding_type">report</field>
        </record>

        <template id="tender_offer_contract">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="doc">
                    <t t-call="web.internal_layout">
                        <div class="page">
                            <div class="text-center">
                                <h2 style="text-align: center; color: #ffffff; background-color: silver; padding: 0px;">
                                    <strong>
                                        <p style="text-align: center; color: black;">Offer -
                                            <span t-field="doc.name"/>
                                        </p>
                                    </strong>

                                </h2>
                            </div>
                            <br/>
                            <strong>
                                <h3>Offer Information</h3>
                            </strong>

                            <table class="table table-responsive">
                                <tr>
                                      <td>
                                        <strong>Product</strong>
                                    </td>
                                    <td>
                                        <span t-field="doc.project_id.name"/>
                                    </td>
                                    <td>
                                        <strong>Customer</strong>
                                    </td>
                                    <td>
                                        <span t-field="doc.customer_id.name"/>
                                    </td>
                                </tr>
                                <tr>
                                     <td>
                                        <strong>Date</strong>
                                    </td>
                                    <td>
                                        <span t-field="doc.date"/>
                                    </td>

                                     <td>
                                        <strong>Version</strong>
                                    </td>
                                    <td>
                                        <span t-field="doc.version_id"/>
                                    </td>
                                    <tr>
                                         <td>
                                        <strong>Down Payment</strong>
                                    </td>
                                    <td>
                                        <span t-field="doc.down_payment"  widget="percentage"/>
                                    </td>
                                     <td>
                                        <strong>Down Payment Percentage</strong>
                                    </td>
                                    <td>
                                        <span t-field="doc.down_payment_percentage" widget="percentage" />
                                    </td>

                                    </tr>

                                </tr>
                            </table>
                            <strong t-if="doc.order_line_ids">
                                <h3>Items</h3>
                            </strong>
                            <table t-if="doc.order_line_ids" class="table table-responsive">
                                <tr style="border: 2px solid black;">
                                    <td>
                                        <strong>Item</strong>
                                    </td>
                                    <td>
                                        <strong>unit Price</strong>
                                    </td>
                                    <td>
                                        <strong>Quantity</strong>
                                    </td>
                                    <td>
                                        <strong>SubTotal</strong>
                                    </td>
                                </tr>
                                <t t-foreach="doc.order_line_ids" t-as="line">
                                    <tr style="border: 2px solid grey;">
                                        <td>
                                            <span t-field="line.item_id"/>
                                        </td>
                                        <td>
                                            <span t-field="line.unit_price"/>
                                        </td>
                                        <td class="text-right">
                                            <span t-esc="line.qty"/>
                                        </td>
                                        <td>
                                            <span t-esc="line.sub_total"/>
                                        </td>
                                    </tr>
                                </t>
                            </table>
                                 <strong t-if="doc.project_extra_expenses_ids">
                                <h3> Extra Expenses Lines</h3>
                            </strong>
                            <table t-if="doc.project_extra_expenses_ids" class="table table-responsive">
                                <tr style="border: 2px solid black;">
                                    <td>
                                        <strong>Name</strong>
                                    </td>
                                    <td>
                                        <strong>Project</strong>
                                    </td>
                                    <td>
                                        <strong>Date</strong>
                                    </td>

                                    <td>
                                        <strong>Cost</strong>
                                    </td>

                                </tr>
                                <t t-foreach="doc.project_extra_expenses_ids" t-as="line">
                                    <tr style="border: 2px solid grey;">
                                        <td>
                                            <span t-field="line.name"/>
                                        </td>
                                        <td>
                                            <span t-field="line.project_id.name"/>
                                        </td>
                                        <td>
                                            <span t-esc="line.date"/>
                                        </td>

                                        <td class="text-right">
                                            <span t-esc="line.cost"/>
                                        </td>

                                    </tr>
                                </t>
                            </table>
                            <div class="text-right">

                                <table class="table table-responsive" style="width:50%; float:right">
                                    <tr>
                                        <td>
                                            <strong>Total Order Lines Cost</strong>
                                        </td>
                                        <td>
                                            <span t-field="doc.total_cost"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>
                                            <strong>Total Extra Cost</strong>
                                        </td>
                                        <td>
                                            <span t-field="doc.total_extra_cost"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>
                                            <strong>Total</strong>
                                        </td>
                                        <td>
                                            <span t-field="doc.offer_total"/>
                                        </td>

                                    </tr>

                                </table>
                            </div>
                        </div>
                    </t>
                </t>
            </t>
        </template>

    </data>
</odoo>
