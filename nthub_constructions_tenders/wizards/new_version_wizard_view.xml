<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="new_version_wizard_view_form" model="ir.ui.view">
            <field name="name">new_version_wizard_view_form</field>
            <field name="model">new.version.wizard</field>
            <field name="arch" type="xml">
                <form string="New Version">
                    <sheet>
                        <group>
                            <group>
                                <field name="version_id"/>
                                <field name="tender_offer_id" invisible="1"/>
                            </group>
                            <group>
                                <field name="description"/>
                            </group>
                        </group>
                    </sheet>
                    <footer>
                        <button name="confirm" groups="nthub_constructions_tenders.construction_tender_offer" type="object" string="Approve" class="oe_highlight"/>
                        <button special="cancel" string="Cancel"/>
                    </footer>
                </form>
            </field>
        </record>

    </data>
</odoo>