<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="down_payment_invoice_wizard_form" model="ir.ui.view">
        <field name="name">down.payment.invoice.wizard.form</field>
        <field name="model">down.payment.invoice.wizard</field>
        <field name="arch" type="xml">
            <form string="Down Payment Invoice">
                <group>
                    <field name="contract_id" readonly="1"/>
                    <field name="max_amount" readonly="1" string="Total Remaining"/>
                    <field name="amount"/>
                    <field name="remaining_after" readonly="1" string="Remaining After Invoice"/>
                    <field name="is_vendor" invisible="1"/>
                </group>
                <footer>
                    <button name="action_create_invoice" string="Create Invoice"
                            type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
