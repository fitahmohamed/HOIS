<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="jobcost_copy_choice_wizard_view_form" model="ir.ui.view">
        <field name="name">jobcost.copy.choice.wizard.form</field>
        <field name="model">jobcost.copy.choice.wizard</field>
        <field name="arch" type="xml">
            <form string="Items with Previous Breakdown">
                <div class="alert alert-warning o_field_widget" role="alert"
                     style="font-size:13px;">
                    These items have a previous breakdown with the same code —
                    the decision is yours: copy the last one with all its details, or create a new empty one.
                    <br/>New items already got a new breakdown automatically.
                </div>
                <field name="project_id" invisible="1"/>
                <field name="line_ids" nolabel="1">
                    <list editable="bottom" create="0" delete="0">
                        <field name="item_code"   string="Code" readonly="1"/>
                        <field name="item_name"   string="Item" readonly="1"/>
                        <field name="source_id"   string="Last Breakdown" readonly="1"/>
                        <field name="source_total" string="Its Total Cost" widget="monetary" readonly="1"/>
                        <field name="choice"      string="Decision" widget="radio"
                               options="{'horizontal': true}"/>
                    </list>
                </field>
                <footer>
                    <button name="action_apply" string="✓ Apply Choices"
                            type="object" class="btn-primary"/>
                    <button name="action_copy_all" string="📋 Copy All"
                            type="object" class="btn-secondary"/>
                    <button name="action_new_all" string="✚ Create New for All"
                            type="object" class="btn-secondary"/>
                    <button name="action_cancel" string="Cancel"
                            type="object" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
