<?xml version="1.0" encoding="UTF-8"?>
<odoo>
        <record id="inherit_construction_form_project" model="ir.ui.view">
            <field name="name">project.project.form</field>
            <field name="model">project.project</field>
            <field name="inherit_id" ref="nthub_constructions.construction_form_project"/>
            <field name="arch" type="xml">
                <xpath expr="//sheet//div[@name='button_box']//button[@name='action_open_contract']" position="before">
                    <button type="object" name="action_open_offer" class="oe_stat_button"
                            icon="fa-handshake-o"
                            groups="nthub_constructions_tenders.construction_tender_offer,nthub_constructions.construction_group_manager"
                            invisible="offer_count== 0"
                           >
                        <div class="o_field_widget o_stat_info">
                            <span class="o_stat_value" widget="statinfo">
                                <field name="offer_count" widget="statinfo" nolabel="1" class="mr4"
                                       readonly="1"/>
                            </span>
                            <span class="o_stat_text">Offer</span>
                        </div>
                    </button>
                </xpath>
            </field>
        </record>
</odoo>
