<odoo>

        <record id="tender_information_id" model="ir.ui.view">
            <field name="name">project.inherited</field>
            <field name="model">project.project</field>
            <field name="inherit_id" ref="nthub_constructions.construction_form_project"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='project_information']" position="before">
                    <page string="Tender Information" autofocus="autofocus"
                          invisible="is_tender ==False">
                        <group>
                            <group>
                                <field name="tender_creation_date"/>
                            </group>
                            <group>
                                <field name="tender_responsible_id"/>
                                <field name="tender_approval_date" readonly="1"/>
                            </group>
                            <group>
                                <field name="partner_id"/>
                                <field name="tender_responsible_id"/>
                            </group>
                        </group>
                        <field name="tender_ids"
                               readonly="state not in ('draft', 'tender')">
                            <list editable="bottom">
                                <field name="date"/>
                                <field name="item_id"/>
                                <field name="description"/>
                                <field name="qty" sum="Total"/>
                                <field name="uom_id"/>
                                <field name="template_id"/>
                                <field name="unit_price" sum="Total"/>
                                <field name="total_cost" widget="monetary" sum="Total"/>
                                <field name="currency_id" column_invisible="1"/>
                                <field name="project_id" column_invisible="1"/>
                                <field name="flag" optional="hide"/>
                            </list>
                        </field>
                    </page>
                </xpath>
            </field>
        </record>

</odoo>