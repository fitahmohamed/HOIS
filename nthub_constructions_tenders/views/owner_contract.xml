<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="inherit_owner_contract_form" model="ir.ui.view">
        <field name="name">owner.contract.form</field>
        <field name="model">owner.contract</field>
        <field name="inherit_id" ref="nthub_constructions.owner_contract_form"/>
        <field name="arch" type="xml">
            <!-- NOTE: the "Extra Expenses" page, the "Total Extra Expenses" field,
                 the "Create Extra Expenses Invoice" button and the "Expenses Invoice"
                 stat button already exist in the base nthub_constructions contract view.
                 They were duplicated here before — removed to avoid showing twice. -->
            <xpath expr="//header//field[@name='state']" position="before">
                <field name="total_deductions_retained" invisible="1"/>
                <field name="deduction_return_remaining" invisible="1"/>
                <button name="action_create_deduction_return_invoice" type="object"
                        string="Return Deductions"
                        class="btn-primary"
                        invisible="state == 'draft' or total_deductions_retained &lt;= 0 or deduction_return_remaining &lt;= 0"/>
            </xpath>
            <xpath expr="//sheet//div[@name='button_box']//button[@name='action_open_sub_contract']" position="before">
                <button name="action_open_variation_orders" type="object"
                        class="oe_stat_button" icon="fa-code-fork">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value">
                            <field name="variation_order_count" widget="statinfo" nolabel="1"/>
                        </span>
                        <span class="o_stat_text">عقود تكميلية</span>
                    </div>
                </button>
                <field name="variation_order_count" invisible="1"/>
                <button name="action_open_deduction_return_invoices" type="object"
                        class="oe_stat_button" icon="fa-undo"
                        invisible="deduction_return_invoice_count == 0">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value">
                            <field name="deduction_return_invoice_count"
                                   widget="statinfo" nolabel="1" class="mr4"/>
                        </span>
                        <span class="o_stat_text">Return Invoices</span>
                    </div>
                </button>
                <field name="deduction_return_invoice_count" invisible="1"/>
                <button name="action_open_budget" type="object" class="oe_stat_button"
                        icon="fa-bar-chart"
                        invisible="budget_created == False">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">Budget</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>

    <!-- Fix: generation_method (progress/duration) accessible for tender groups -->
    <record id="inherit_owner_contract_form_generation" model="ir.ui.view">
        <field name="name">owner.contract.form.generation.tenders</field>
        <field name="model">owner.contract</field>
        <field name="inherit_id" ref="nthub_constructions.owner_contract_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_generate_completion_request']" position="attributes">
                <attribute name="groups">nthub_constructions.construction_group_officer,nthub_constructions_tenders.construction_tender_confirm_contract</attribute>
            </xpath>
            <xpath expr="//page[@name='cr_settings']" position="attributes">
                <attribute name="invisible">is_owner == False</attribute>
            </xpath>
        </field>
    </record>

</odoo>
