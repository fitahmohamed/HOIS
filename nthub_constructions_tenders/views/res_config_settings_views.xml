<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="res_config_settings_view_form_inherit" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.tenders</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="nthub_constructions.constructions_res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='nthub_constructions']" position="inside">
                <block title="Down Payment Settings" name="tenders_down_payment_settings">
                    <setting string="Down Payment Account" help="Default account for down payment invoices from contracts">
                        <field name="down_payment_account_id"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>
