<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===================================================================
         List View
    =================================================================== -->
    <record id="variation_order_list_view" model="ir.ui.view">
        <field name="name">owner.variation.order.list</field>
        <field name="model">owner.variation.order</field>
        <field name="arch" type="xml">
            <list string="عقود تكميلية / Variation Orders"
                  decoration-muted="state == 'rejected'"
                  decoration-success="state == 'executed'"
                  decoration-warning="state == 'approved'"
                  decoration-info="state in ('submitted','reviewed')">
                <field name="name"        string="الرقم المرجعي"/>
                <field name="date"        string="التاريخ"/>
                <field name="contract_id" string="العقد الأصلي"/>
                <field name="project_id"  string="المشروع"/>
                <field name="partner_id"  string="العميل"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="net_amount"  string="الصافي"
                       widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="state"       string="الحالة" widget="badge"/>
            </list>
        </field>
    </record>

    <!-- ===================================================================
         Form View
    =================================================================== -->
    <record id="variation_order_form_view" model="ir.ui.view">
        <field name="name">owner.variation.order.form</field>
        <field name="model">owner.variation.order</field>
        <field name="arch" type="xml">
            <form string="عقد تكميلي / Variation Order">
                <header>
                    <button name="action_submit" type="object"
                            string="رفع للمراجعة / Submit"
                            class="oe_highlight"
                            invisible="state != 'draft'"
                            groups="nthub_constructions_tenders.completion_group_site_engineer,nthub_constructions_tenders.construction_completion_request_confirm"/>

                    <button name="action_review" type="object"
                            string="تمت المراجعة / Mark Reviewed"
                            class="oe_highlight"
                            invisible="state != 'submitted'"
                            groups="nthub_constructions_tenders.completion_group_review_engineer,nthub_constructions_tenders.construction_completion_request_confirm"/>

                    <button name="action_approve" type="object"
                            string="اعتماد / Approve"
                            class="oe_highlight"
                            invisible="state != 'reviewed'"
                            groups="nthub_constructions_tenders.completion_group_project_manager,nthub_constructions_tenders.construction_completion_request_confirm"/>

                    <button name="action_execute" type="object"
                            string="تنفيذ على العقد / Execute"
                            class="btn-success"
                            invisible="state != 'approved'"
                            confirm="سيتم تطبيق التعديلات على بنود العقد الأصلي. هذا الإجراء لا يمكن التراجع عنه. هل أنت متأكد؟"
                            groups="nthub_constructions_tenders.completion_group_project_manager,nthub_constructions_tenders.construction_completion_request_confirm"/>

                    <button name="action_reset_draft" type="object"
                            string="رجوع للمسودة / Reset to Draft"
                            invisible="state not in ('submitted', 'rejected')"
                            groups="nthub_constructions_tenders.completion_group_site_engineer,nthub_constructions_tenders.construction_completion_request_confirm"/>

                    <button name="action_reject" type="object"
                            string="رفض / Reject"
                            class="btn-danger"
                            invisible="state in ('draft', 'executed', 'rejected')"
                            confirm="هل تريد رفض العقد التكميلي؟"
                            groups="nthub_constructions_tenders.completion_group_review_engineer,nthub_constructions_tenders.completion_group_project_manager,nthub_constructions_tenders.construction_completion_request_confirm"/>

                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,reviewed,approved,executed"/>
                </header>
                <sheet>
                    <div name="button_box" class="oe_button_box">
                        <button name="action_open_contract" type="object"
                                class="oe_stat_button" icon="fa-file-text-o">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">العقد الأصلي</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>

                    <!-- Hidden: used for domain filtering on line items -->
                    <field name="available_item_ids" invisible="1"/>

                    <group>
                        <group string="بيانات العقد">
                            <field name="contract_id"
                                   string="العقد الأصلي"
                                   readonly="state != 'draft'"
                                   options="{'no_create': True}"/>
                            <field name="project_id" string="المشروع"  readonly="1"/>
                            <field name="partner_id" string="العميل"   readonly="1"/>
                        </group>
                        <group string="التفاصيل">
                            <field name="date"       string="التاريخ"  readonly="state != 'draft'"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group>
                        <field name="reason"
                               string="السبب / Reason"
                               readonly="state != 'draft'"
                               placeholder="مثال: تغيير تصميم، زيادة نطاق العمل، قرار المالك..."/>
                    </group>

                    <!-- ── بنود العقد التكميلي ──────────────────────────────── -->
                    <field name="line_ids"
                           string="البنود"
                           readonly="state not in ('draft',)">
                        <list editable="bottom">
                            <field name="item_id"
                                   string="البند"
                                   domain="[('id', 'in', parent.available_item_ids)]"
                                   options="{'no_create': True}"/>
                            <field name="description" string="الوصف"/>
                            <field name="uom_id"      string="الوحدة"/>

                            <!-- نوع التغيير: dropdown — الثلاثة خيارات تظهر عند الضغط -->
                            <field name="change_type" string="نوع التغيير"/>

                            <!-- بيانات مرجعية من العقد — readonly + force_save -->
                            <field name="ref_quantity"
                                   string="الكمية في العقد"
                                   readonly="1" force_save="1"
                                   optional="show"/>
                            <field name="ref_unit_price"
                                   string="السعر في العقد"
                                   readonly="1" force_save="1"
                                   optional="show"/>

                            <!-- هل تسعير جديد؟ -->
                            <field name="use_new_breakdown"
                                   string="تسعير جديد؟"
                                   widget="boolean_toggle"
                                   optional="show"/>

                            <!-- قيم التغيير -->
                            <field name="quantity"   string="كمية التغيير"/>
                            <field name="unit_price" string="سعر الوحدة"
                                   readonly="not use_new_breakdown"/>
                            <field name="amount"     string="القيمة"
                                   readonly="1" force_save="1" sum="الإجمالي"/>
                        </list>
                    </field>

                    <!-- ── إجماليات ────────────────────────────────────────── -->
                    <group class="oe_subtotal_footer oe_right" colspan="2">
                        <field name="total_increase"
                               string="إجمالي الزيادات"
                               widget="monetary" readonly="1" force_save="1"
                               options="{'currency_field': 'currency_id'}"/>
                        <field name="total_decrease"
                               string="إجمالي النقص"
                               widget="monetary" readonly="1" force_save="1"
                               options="{'currency_field': 'currency_id'}"/>
                        <field name="net_amount"
                               string="الصافي"
                               widget="monetary" readonly="1" force_save="1"
                               options="{'currency_field': 'currency_id'}"
                               class="oe_subtotal_footer_separator"/>
                    </group>

                    <group>
                        <field name="notes" string="ملاحظات"
                               readonly="state == 'executed'"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ===================================================================
         Actions
    =================================================================== -->
    <record id="action_variation_order" model="ir.actions.act_window">
        <field name="name">Variation Orders</field>
        <field name="res_model">owner.variation.order</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">أضف عقداً تكميلياً جديداً</p>
            <p>العقد التكميلي بيتيح تسجيل أي زيادة أو نقص في بنود عقد أصلي
               مع سايكل اعتماد كامل قبل التطبيق.</p>
        </field>
    </record>

    <record id="action_variation_order_from_contract" model="ir.actions.act_window">
        <field name="name">Variation Orders</field>
        <field name="res_model">owner.variation.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('contract_id', '=', active_id)]</field>
        <field name="context">{'default_contract_id': active_id}</field>
    </record>

</odoo>
