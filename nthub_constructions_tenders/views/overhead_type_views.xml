<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List View -->
    <record id="overhead_type_list_view" model="ir.ui.view">
        <field name="name">project.overhead.type.list</field>
        <field name="model">project.overhead.type</field>
        <field name="arch" type="xml">
            <list string="أنواع الأوفر هيد / Overhead Types" editable="bottom">
                <field name="name"       string="الاسم / Name"/>
                <field name="category"   string="التصنيف / Category"/>
                <field name="uom_name"   string="الوحدة / Unit"/>
                <field name="unit_price" string="التكلفة الافتراضية / Default Cost"/>
                <field name="account_id" string="الحساب / Account" optional="show"/>
                <field name="active"     string="نشط" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="overhead_type_form_view" model="ir.ui.view">
        <field name="name">project.overhead.type.form</field>
        <field name="model">project.overhead.type</field>
        <field name="arch" type="xml">
            <form string="نوع أوفر هيد / Overhead Type">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="الاسم / Name"/>
                        <h1>
                            <field name="name"
                                   placeholder="مثال: مهندس موقع، عمالة، سقالات..."/>
                        </h1>
                    </div>
                    <group>
                        <group string="التصنيف / Classification">
                            <field name="category" string="التصنيف / Category"/>
                            <field name="uom_name" string="الوحدة / Unit"
                                   placeholder="مثال: شهر / ساعة / مبلغ ثابت"/>
                            <field name="active" string="نشط / Active"/>
                        </group>
                        <group string="التكلفة والمحاسبة / Cost &amp; Accounting">
                            <field name="unit_price"
                                   string="التكلفة الافتراضية / Default Cost"/>
                            <field name="account_id"
                                   string="الحساب المحاسبي / Account"
                                   options="{'no_create': True}"/>
                            <field name="company_id"
                                   groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes" string="ملاحظات / Notes"
                               placeholder="ملاحظات إضافية..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_overhead_type" model="ir.actions.act_window">
        <field name="name">Overhead Types</field>
        <field name="res_model">project.overhead.type</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">أضف نوع أوفر هيد جديد</p>
            <p>عرّف هنا بنود الأوفر هيد الثابتة (عمالة، مهندسين، مصاريف...)
               وبعدين تقدر تختارها مباشرة لما تضيف بنود في المشاريع أو العروض
               بدلاً من الكتابة اليدوية في كل مرة.</p>
        </field>
    </record>

</odoo>
