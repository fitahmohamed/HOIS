<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Add deduction_type_id and account_id to completion deduction/allowance list -->
    <record id="view_completion_deduction_allowance_list_inherit" model="ir.ui.view">
        <field name="name">contract.completion.deduction.allowance.list.inherit.tenders</field>
        <field name="model">contract.completion.deduction.allowance</field>
        <field name="inherit_id" ref="nthub_constructions.view_contract_completion_deduction_allowance_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="before">
                <field name="deduction_type_id"/>
            </xpath>
            <xpath expr="//field[@name='name']" position="after">
                <field name="account_id" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- Add deduction_type_id and account_id to completion deduction/allowance form -->
    <record id="view_completion_deduction_allowance_form_inherit" model="ir.ui.view">
        <field name="name">contract.completion.deduction.allowance.form.inherit.tenders</field>
        <field name="model">contract.completion.deduction.allowance</field>
        <field name="inherit_id" ref="nthub_constructions.view_contract_completion_deduction_allowance_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="before">
                <field name="deduction_type_id"/>
            </xpath>
            <xpath expr="//field[@name='name']" position="after">
                <field name="account_id"/>
            </xpath>
        </field>
    </record>

    <!-- Inherit completion request form -->
    <record id="completion_request_form_inherit" model="ir.ui.view">
        <field name="name">project.completion.request.form.inherit.tenders</field>
        <field name="model">project.completion.request</field>
        <field name="inherit_id" ref="nthub_constructions.project_completion_request_form"/>
        <field name="arch" type="xml">

            <!--
                صلاحيات المستخلص (مستخلص Workflow Permissions):
                ┌─────────────────────┬──────────────────────────────────────────────┐
                │ مهندس الموقع        │ ينشئ + يدخل كميات + يرفع للمراجعة           │
                │ مهندس المراجعة      │ يراجع البنود + يقبل/يرجع للمسودة            │
                │ مدير المشروع        │ يعتمد المستخلص النهائي                      │
                │ المحاسب             │ ينشئ الفاتورة ويعالجها                      │
                └─────────────────────┴──────────────────────────────────────────────┘
                المجموعة القديمة construction_completion_request_confirm تبقى كـ fallback
                للمستخدمين اللي ليهم صلاحيات كاملة.
            -->

            <!-- زر "رفع للمراجعة" — مهندس الموقع فقط -->
            <xpath expr="//button[@name='start_processing']" position="attributes">
                <attribute name="string">رفع للمراجعة / Submit for Review</attribute>
                <attribute name="groups">nthub_constructions_tenders.completion_group_site_engineer,nthub_constructions_tenders.construction_completion_request_confirm</attribute>
            </xpath>

            <!-- زر "رجوع للمسودة" — مهندس المراجعة فقط (يظهر في processing) -->
            <xpath expr="//button[@name='start_processing']" position="after">
                <button name="action_return_to_draft" type="object"
                        string="رجوع للمسودة / Return to Draft"
                        invisible="state != 'processing'"
                        class="btn-warning"
                        groups="nthub_constructions_tenders.completion_group_review_engineer,nthub_constructions_tenders.construction_completion_request_confirm"
                        confirm="سيتم إرجاع المستخلص للمسودة وإشعار مهندس الموقع. هل أنت متأكد؟"/>
            </xpath>

            <!-- زر "اعتماد" — مدير المشروع فقط -->
            <xpath expr="//button[@name='action_confirm']" position="attributes">
                <attribute name="string">اعتماد / Approve</attribute>
                <attribute name="groups">nthub_constructions_tenders.completion_group_project_manager,nthub_constructions_tenders.construction_completion_request_confirm</attribute>
            </xpath>

            <!-- زر إنشاء الفاتورة — المحاسب فقط -->
            <xpath expr="//button[@name='create_completion_invoice']" position="attributes">
                <attribute name="groups">nthub_constructions_tenders.completion_group_accountant,nthub_constructions_tenders.construction_completion_request_confirm</attribute>
            </xpath>

            <!-- زر إعادة تحميل البنود — مهندس الموقع فقط -->
            <xpath expr="//button[@name='start_processing']" position="before">
                <button name="action_load_contract_lines" type="object"
                        string="تحميل بنود العقد / Reload Contract Lines"
                        invisible="state != 'draft' or not contract_id"
                        class="btn-secondary"
                        groups="nthub_constructions_tenders.completion_group_site_engineer,nthub_constructions_tenders.construction_completion_request_confirm"
                        confirm="سيتم إعادة تحميل البنود من العقد. البنود التي بها كميات مُدخَلة ستُحفظ."/>
            </xpath>

            <!-- Replace Lines tab: show contract info columns + two input modes -->
            <xpath expr="//field[@name='line_ids']" position="replace">
                <field name="line_ids"
                       readonly="state in ('confirm', 'invoiced')">
                    <list editable="bottom">
                        <field name="item_id" readonly="1"/>
                        <field name="uom_id" readonly="1"/>
                        <field name="contract_qty" readonly="1" string="Contract Qty"
                               decoration-muted="contract_qty == 0"/>
                        <field name="prev_completed_qty" readonly="1" string="Prev. Done"/>
                        <field name="remaining_contract_qty" readonly="1" string="Remaining"
                               decoration-danger="remaining_contract_qty == 0"/>
                        <field name="price_unit" readonly="1"/>
                        <!-- Mode 1: Enter quantity directly -->
                        <field name="quantity" string="This Period Qty"
                               readonly="parent.state == 'processing'"/>
                        <!-- Mode 2: Enter % of the base contract qty -->
                        <field name="completion_percentage" string="النسبة % / Percentage"
                               widget="percentage"
                               readonly="parent.state == 'processing'"/>
                        <field name="total_amount" readonly="1" sum="Total"/>
                        <field name="overall_completion_pct" string="Overall %" widget="percentage" readonly="1"/>
                        <!-- Approval fields (processing stage) -->
                        <field name="percentage" widget="percentage" string="Approved %"
                               readonly="parent.state == 'draft'"/>
                        <field name="amount" sum="Total" string="Approved Amt"
                               readonly="parent.state == 'draft'"/>
                        <field name="state" readonly="parent.state == 'draft'"
                               widget="badge"
                               decoration-success="state == 'accept'"
                               decoration-warning="state == 'partially'"
                               decoration-danger="state == 'reject'"/>
                        <field name="completion_request_id" column_invisible="1"/>
                        <field name="analytic_distribution" widget="analytic_distribution"
                               optional="hide"/>
                    </list>
                </field>
            </xpath>

            <!-- Deductions tab: replace with editable list showing type and account -->
            <xpath expr="//field[@name='deduction_line_ids']" position="replace">
                <field name="deduction_line_ids" nolabel="1" readonly="1"
                       context="{'default_main_type':'deduction', 'default_contract_type':'owner'}">
                    <list>
                        <field name="deduction_type_id"/>
                        <field name="name"/>
                        <field name="item_id"/>
                        <field name="account_id" optional="show"/>
                        <field name="main_type" column_invisible="1" force_save="1"/>
                        <field name="contract_type" column_invisible="1" force_save="1"/>
                        <field name="calculation_type"/>
                        <field name="percentage" widget="percentage"/>
                        <field name="amount" sum="Total"/>
                    </list>
                </field>
            </xpath>

            <!-- Allowances tab: replace with editable list showing type and account -->
            <xpath expr="//field[@name='allowance_line_ids']" position="replace">
                <field name="allowance_line_ids" nolabel="1" readonly="1"
                       context="{'default_main_type':'allowance', 'default_contract_type':'owner'}">
                    <list>
                        <field name="deduction_type_id" string="Allowance Type"/>
                        <field name="name"/>
                        <field name="account_id" optional="show"/>
                        <field name="main_type" column_invisible="1" force_save="1"/>
                        <field name="contract_type" column_invisible="1" force_save="1"/>
                        <field name="calculation_type"/>
                        <field name="percentage" widget="percentage"/>
                        <field name="amount" sum="Total"/>
                    </list>
                </field>
            </xpath>
        </field>
    </record>

</odoo>
