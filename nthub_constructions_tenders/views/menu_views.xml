<odoo>


        <!-- This Menu Item will appear in the Upper bar, That's why It needs NO parent or action -->
        <menuitem id="constructions_tenders_root_menu" name="Tenders" sequence="10" web_icon="nthub_constructions_tenders,static/description/icon.png"/>

        <!-- This Menu Item Must have a parent -->

        <menuitem id="constructions_tenders_category_menu" name="Configuration" parent="constructions_tenders_root_menu"
                  sequence="100"/>
        <menuitem id="tenders_job" parent="constructions_tenders_category_menu"
                  action="nthub_constructions.tender_job_action" name="Project Jobs" sequence="5"/>
        <menuitem id="tenders_job_item" parent="constructions_tenders_category_menu"
                  action="nthub_constructions.tender_item_action" name="Project Items" sequence="10"/>

        <menuitem id="constructions_tenders_job_cost_menu" action="nthub_constructions.action_tender_job_costing" name="Breakdown Template"
                  parent="constructions_tenders_category_menu"
                  sequence="20"/>
        <!-- This Menu Item must have a parent and an action -->
        <menuitem id="tender_offer_menu_action" name="Offers" parent="constructions_tenders_root_menu"
                  action="tender_offer_view_action" sequence="2"/>


        <!-- This Menu Item Must have a parent -->
        <menuitem id="constructions_tenders_Project_menu" name="Tender Projects" parent="constructions_tenders_root_menu"
                  action="action_project_tender"
                  groups="nthub_constructions.construction_group_user"
                  sequence="0"/>







</odoo>