<odoo>

        <!--   define a search -->
        <record model="ir.ui.view" id="view_top_sheet_search">
            <field name="name">top.sheet.search</field>
            <field name="model">top.sheet</field>
            <field name="arch" type="xml">
                <search>
                    <field name="project_id" string="Project" filter_domain="[('project_id','ilike',self)]"/>
                    <newline/>
                    <group>
                        <filter name="project_id" string="Project" domain="[]" context="{'group_by':'project_id'}"/>
                    </group>
                </search>
            </field>
        </record>
        <!-- define a form_top_sheet-->
        <record model="ir.ui.view" id="top_sheet_form">
            <field name="name">top.sheet.form</field>
            <field name="model">top.sheet</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="project_id" readonly="1"/>
                                <field name="total_tender_cost" readonly="1"/>
                                <field name="total_indirect_cost" readonly="1"/>
                                <field name="indirect_cost_percentage" widget="percentage" readonly="1"/>
                                <field name="sub_total" readonly="1"/>
                                <field name="offer_id" invisible="1"/>
                            </group>
                        </group>
                    </sheet>
                    <chatter reload_on_follower="True"/>
                </form>
            </field>
        </record>
        <!--  define a action_top_sheet-->
        <record id="top_sheet_action" model="ir.actions.act_window">
            <field name="name">Top Sheet</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">top.sheet</field>
            <field name="view_mode">list,form</field>
        </record>

</odoo>
