<?xml version="1.0" encoding="utf-8"?>
<odoo>

        <record id="tender_version_view_tree" model="ir.ui.view">
            <field name="name">tender_version_view_list</field>
            <field name="model">tender.offer.version</field>
            <field name="arch" type="xml">
                <list string="tender_version">
                    <field name="name"/>
                    <field name="date"/>
                    <field name="customer_id"/>
                    <field name="project_id"/>
                    <field name="total_cost"/>
                    <field name="state" widget="badge"
                           decoration-success="state == 'confirm'"
                           decoration-info="state == 'draft'"/>
                </list>
            </field>
        </record>
        <record id="tender_version_view_form" model="ir.ui.view">
            <field name="name">tender_version_view_form</field>
            <field name="model">tender.offer.version</field>
            <field name="arch" type="xml">
                <form string="tender_version" create="0">
                    <header>
                        <button name="action_confirm" string="Confirm" type="object"
                                class="oe_highlight"
                                groups="nthub_constructions_tenders.construction_tender_offer"
                                invisible="state !='draft'"
                                />
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field nolabel="1" name="name"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="customer_id" readonly="1"/>
                                <field name="project_id" readonly="1"/>
                                <field name="tender_offer_id" readonly="1"/>
                            </group>
                            <group>
                                <field name="date" readonly="state =='confirm'"/>
                                <field name="tag_ids" widget="many2many_tags" readonly="state =='confirm'"/>
                                <field name="description" readonly="state =='confirm'"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Order Lines">
                                <field name="version_line_ids"
                                       readonly="state =='confirm'"
                                       >
                                    <list editable="bottom">
                                        <field name="item_id"/>
                                        <field name="version_id" column_invisible="1"/>
                                        <field name="name"/>
                                        <field name="uom_id"/>
                                        <field name="qty"/>
                                        <field name="unit_price"/>
                                        <field name="template_id"/>
                                        <field name="sub_total"/>
                                        <field name="flag"/>
                                    </list>
                                </field>
                                <group class="oe_subtotal_footer oe_right" colspan="2">
                                    <field name="total_cost"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>

                </form>
            </field>
        </record>

        <record id="tender_version_view_action" model="ir.actions.act_window">
            <field name="name">Versions</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">tender.offer.version</field>
            <field name="view_mode">list,form</field>
        </record>



</odoo>