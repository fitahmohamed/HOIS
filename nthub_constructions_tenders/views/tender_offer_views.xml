<?xml version="1.0" encoding="utf-8"?>
<odoo>

        <record id="tender_offer_view_tree" model="ir.ui.view">
            <field name="name">tender_offer_view_list</field>
            <field name="model">tender.offer</field>
            <field name="arch" type="xml">
                <list string="tender_offer" create="0">
                    <field name="name"/>
                    <field name="date"/>
                    <field name="customer_id"/>
                    <field name="project_id"/>
                    <field name="company_id"/>
                    <field name="currency_id" column_invisible="1"/>
                    <field name="total_cost" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                    <field name="state" widget="badge" decoration-success="state=='approved'"
                               decoration-danger="state=='cancel'" decoration-muted="state=='draft'"/>
                </list>
            </field>
        </record>
        <record id="tender_offer_view_form" model="ir.ui.view">
            <field name="name">tender_offer_view_form</field>
            <field name="model">tender.offer</field>
            <field name="arch" type="xml">
                <form string="tender_offer" create="0">
                    <header>
                        <button name="action_confirm" string="Confirm" type="object"
                                class="oe_highlight"
                                groups="nthub_constructions_tenders.construction_tender_offer"
                                invisible="state!='draft'"/>
                        <button name="action_create_top_sheet" type="object" string="Create Top Sheet"
                                class="btn-primary"
                                invisible="top_sheet_id==True"
                                />
                        <button name="action_cancel" string="Cancel" type="object"
                                class="oe_highlight"
                                groups="nthub_constructions_tenders.construction_tender_offer"
                                invisible="state!='draft'"
                                />
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <div name="button_box" class="oe_button_box">
                            <button type="object" name="action_open_version" class="oe_stat_button"
                                    icon="fa-align-justify"
                                    invisible="version_count==0"
                                    >
                                <div class="o_field_widget o_stat_info">
                                    <span class="o_stat_value" widget="statinfo">
                                        <field name="version_count" widget="statinfo" nolabel="1" class="mr4"
                                               readonly="1"/>
                                    </span>
                                    <span class="o_stat_text">Version</span>
                                </div>
                            </button>
                            <button string="Top Sheet" type="object" icon="fa-align-justify"
                                    name="action_open_top_sheet"
                                    invisible="top_sheet_id==False"
                                   />
                        </div>
                        <div class="oe_title">
                            <h1>
                                <field nolabel="1" name="name"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="customer_id" readonly="1"/>
                                <field name="project_id" readonly="1"/>
                                <field name="company_id" readonly="1"/>
                                <field name="last_update_date" readonly="1"/>
                            </group>
                            <group>
                                <field name="date"
                                       readonly="state=='approved'"/>

                                <field name="down_payment_percentage" widget="percentage"
                                       readonly="state=='approved'"/>
                                 <field name="down_payment" widget="monetary"
                                       readonly="state=='approved'"/>
                                <field name="tag_ids" widget="many2many_tags"
                                       readonly="state=='approved'"/>
                                <field name="currency_id" invisible="1"/>
                                <field name="top_sheet_id" invisible="1"/>
                            </group>
                        </group>
                        <group>
                            <group style="width:30%%">
                                <label for="version_id"/>
                                <div class="o_row">
                                    <field name="version_id"
                                           readonly="state=='approved'"
                                           />
                                    <button name="create_new_version" type="object" string="New Version"
                                            invisible="state=='approved'"
                                            />
                                </div>
                            </group>
                            <group>
                            </group>
                        </group>
                        <notebook>
                            <page string="Order Lines">
                                <field name="order_line_ids"
                                       readonly="state=='approved'"
                                       >
                                    <list editable="bottom" create="0">
                                        <field name="item_id"/>
                                        <field name="tender_offer_id" column_invisible="1"/>
                                        <field name="name"/>
                                        <field name="uom_id"/>
                                        <field name="qty"/>
                                        <field name="unit_price"/>
                                        <field name="template_id"/>
                                        <field name="sub_total" widget="monetary"
                                               options="{'currency_field': 'currency_id'}"/>
                                        <field name="flag"/>
                                        <field name="company_id" column_invisible="1"/>
                                        <field name="currency_id" column_invisible="1"/>

                                    </list>
                                </field>
                            </page>
                            <page name="extra_expense" string="Extra Expenses">
                                <field name="project_extra_expenses_ids">
                                    <list>
                                        <field name="product_id"/>
                                        <field name="date"/>
                                        <field name="name"/>
                                        <field name="description"/>
                                        <field name="cost"/>
                                        <field name="attachment"/>
                                        <field name="project_id" column_invisible="1"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                        <group class="oe_subtotal_footer oe_right" colspan="2">
                            <field name="total_cost" string="Total Order Lines Cost" widget="monetary"
                                   options="{'currency_field': 'currency_id'}" readonly="1" force_save="1"/>
                            <field name="total_extra_cost" widget="monetary" readonly="1" force_save="1"/>
                            <field name="offer_total" widget="monetary" string="Total"
                                   class="oe_subtotal_footer_separator" readonly="1" force_save="1"
                            />
                        </group>
                        <!--                        <group>-->
                        <!--                            <group class="oe_subtotal_footer oe_right" colspan="2" name="total_tender_cost">-->
                        <!--                                <field name="total_tender_cost" widget="monetary"/>-->
                        <!--                                <field name="total_extra_cost" widget="monetary"/>-->
                        <!--                                <field name="total_cost" widget="monetary"/>-->
                        <!--                            </group>-->
                        <!--                        </group>-->
                    </sheet>

                </form>
            </field>
        </record>

        <record id="tender_offer_view_action" model="ir.actions.act_window">
            <field name="name">Offers</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">tender.offer</field>
            <field name="view_mode">list,form</field>
        </record>



</odoo>