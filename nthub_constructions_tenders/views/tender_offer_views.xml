<?xml version="1.0" encoding="utf-8"?>
<odoo>

        <record id="tender_offer_view_tree" model="ir.ui.view">
            <field name="name">tender_offer_view_list</field>
            <field name="model">tender.offer</field>
            <field name="arch" type="xml">
                <list string="Tender Offer" create="0">
                    <field name="name"/>
                    <field name="date"/>
                    <field name="customer_id"/>
                    <field name="company_id"/>
                    <field name="currency_id" column_invisible="1"/>
                    <field name="total_cost" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                    <field name="state" widget="badge" decoration-success="state=='approved'"
                               decoration-danger="state=='cancel'" decoration-muted="state=='draft'"/>
                </list>
            </field>
        </record>
        <record id="tender_offer_view_form" model="ir.ui.view">
            <field name="name">tender_offer_view_form</field>
            <field name="model">tender.offer</field>
            <field name="arch" type="xml">
                <form string="Tender Offer" create="0">
                    <header>
                        <button name="action_confirm" string="Approve" type="object"
                                class="oe_highlight"
                                groups="nthub_constructions_tenders.construction_tender_confirm_offer"
                                invisible="state!='draft'"/>
                        <button name="action_create_top_sheet" type="object" string="Create Top Sheet"
                                class="btn-primary"
                                invisible="top_sheet_id==True"
                                />
                        <button name="action_cancel" string="Cancel" type="object"
                                class="oe_highlight"
                                groups="nthub_constructions_tenders.construction_tender_offer"
                                invisible="state!='draft'"
                                />
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <div name="button_box" class="oe_button_box">
                            <button type="object" name="action_open_version" class="oe_stat_button"
                                    icon="fa-align-justify"
                                    invisible="version_count==0"
                                    >
                                <div class="o_field_widget o_stat_info">
                                    <span class="o_stat_value" widget="statinfo">
                                        <field name="version_count" widget="statinfo" nolabel="1" class="mr4"
                                               readonly="1"/>
                                    </span>
                                    <span class="o_stat_text">Versions</span>
                                </div>
                            </button>
                            <button string="Top Sheet" type="object" icon="fa-align-justify"
                                    name="action_open_top_sheet"
                                    invisible="top_sheet_id==False"
                                   />
                        </div>
                        <div class="oe_title">
                            <h1>
                                <field nolabel="1" name="name"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="customer_id" readonly="1"/>
                                <field name="project_id" invisible="1"/>
                                <field name="company_id" readonly="1"/>
                                <field name="last_update_date" readonly="1"/>
                            </group>
                            <group>
                                <field name="date"
                                       readonly="state=='approved'"/>

                                <field name="tag_ids" widget="many2many_tags"
                                       readonly="state=='approved'"/>
                                <field name="currency_id" invisible="1"/>
                                <field name="top_sheet_id" invisible="1"/>
                            </group>
                        </group>
                        <group>
                            <group style="width:30%%">
                                <label for="version_id"/>
                                <div class="o_row">
                                    <field name="version_id"
                                           readonly="state=='approved'"
                                           />
                                    <button name="create_new_version" type="object" string="New Version"
                                            invisible="state=='approved'"
                                            />
                                </div>
                            </group>
                            <group>
                                <field name="profit_margin" string="Profit Margin %"/>
                                <field name="overhead_percentage" string="نسبة الأوفر هيد % / Overhead %"
                                       readonly="1" force_save="1"
                                       help="تُحسب تلقائيًا من إجمالي بنود الأوفر هيد بتبويب 'الأوفر هيد' بالمشروع، مقسومة على إجمالي تكلفة البنود بعد الهالك."/>
                                <field name="total_overhead_amount" string="إجمالي الأوفر هيد / Total Overhead" widget="monetary"
                                       readonly="1" force_save="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Offer Lines">
                                <field name="order_line_ids"
                                       readonly="state=='approved'"
                                       >
                                    <list editable="bottom" create="0">
                                        <field name="item_id"/>
                                        <field name="tender_offer_id" column_invisible="1"/>
                                        <field name="name"/>
                                        <field name="uom_id"/>
                                        <field name="qty"/>
                                        <field name="cost_price"         string="Cost Price"  readonly="1" force_save="1"/>
                                        <field name="cost_total"          string="Total Cost" widget="monetary"
                                               readonly="1" force_save="1" sum="Total Cost"/>
                                        <field name="wastage_percentage"  string="نسبة الهالك % / Wastage %"
                                               readonly="flag != 'm'"/>
                                        <field name="overhead_share"      string="حصة الأوفر هيد / Overhead Share" widget="monetary"
                                               readonly="1" force_save="1" optional="show"/>
                                        <field name="direct_cost_unit"    string="التكلفة المباشرة / Direct Cost"
                                               readonly="1" force_save="1"/>
                                        <field name="profit_margin_line"  string="نسبة الربح % / Profit Margin %"/>
                                        <field name="sell_price"          string="Selling Price"/>
                                        <field name="sub_total"           string="Total Selling" widget="monetary"
                                               options="{'currency_field': 'currency_id'}" sum="Total Selling"/>
                                        <field name="template_id" optional="show"/>
                                        <field name="flag"        optional="show"/>
                                        <field name="company_id"  column_invisible="1"/>
                                        <field name="currency_id" column_invisible="1"/>
                                    </list>
                                </field>
                            </page>
                            <page name="overhead" string="الأوفر هيد / Overhead">
                                <group>
                                    <field name="project_duration_months"
                                           string="مدة المشروع (شهور) / Project Duration (Months)"
                                           help="تُحسب كل بند = الكمية × الشهور × سعر الوحدة"/>
                                </group>
                                <field name="project_overhead_ids">
                                    <list editable="bottom">
                                        <field name="type_id" optional="show"
                                               string="نوع الأوفر هيد"
                                               options="{'no_create': True}"/>
                                        <field name="name"       string="الوصف"/>
                                        <field name="category"   string="التصنيف"/>
                                        <field name="uom_name"   string="الوحدة"/>
                                        <field name="qty"        string="العدد" digits="[16,4]"/>
                                        <field name="duration_months" string="الشهور"
                                               readonly="1" force_save="1"/>
                                        <field name="unit_price" string="الراتب / سعر الوحدة"/>
                                        <field name="amount" widget="monetary" sum="إجمالي الأوفر هيد"
                                               readonly="1" force_save="1"/>
                                        <field name="project_id" column_invisible="True"/>
                                    </list>
                                </field>
                                <group class="oe_subtotal_footer oe_right" colspan="2">
                                    <field name="total_overhead_amount" string="إجمالي الأوفر هيد / Total Overhead"
                                           widget="monetary" readonly="1" force_save="1"/>
                                    <field name="overhead_percentage" string="نسبة الأوفر هيد %"
                                           readonly="1" force_save="1"/>
                                </group>
                            </page>
                            <page name="extra_expense" string="Extra Expenses">
                                <field name="project_extra_expenses_ids">
                                    <list>
                                        <field name="product_id"/>
                                        <field name="date"/>
                                        <field name="name"/>
                                        <field name="description"/>
                                        <field name="cost"/>
                                        <field name="attachment"/>
                                        <field name="project_id" column_invisible="1"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                        <group class="oe_subtotal_footer oe_right" colspan="2">
                            <field name="total_cost" string="Total Lines Cost" widget="monetary"
                                   options="{'currency_field': 'currency_id'}" readonly="1" force_save="1"/>
                            <field name="total_direct_cost" string="إجمالي التكلفة المباشرة / Total Direct Cost" widget="monetary"
                                   options="{'currency_field': 'currency_id'}" readonly="1" force_save="1"/>
                            <field name="total_extra_cost" widget="monetary" readonly="1" force_save="1"/>
                            <field name="offer_total" widget="monetary" string="Total"
                                   class="oe_subtotal_footer_separator" readonly="1" force_save="1"
                            />
                        </group>
                    </sheet>

                </form>
            </field>
        </record>

        <record id="tender_offer_view_action" model="ir.actions.act_window">
            <field name="name">Tender Offers</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">tender.offer</field>
            <field name="view_mode">list,form</field>
        </record>

</odoo>
