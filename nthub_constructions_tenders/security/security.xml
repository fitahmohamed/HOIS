<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ============================================================= -->
        <!-- Dedicated module category for Construction Tenders            -->
        <!-- Keeps this addon's permissions in their own section, separate -->
        <!-- from the base "Constructions" category of nthub_constructions.-->
        <!-- ============================================================= -->

        <record model="ir.module.category" id="nthub_constructions_tenders_category">
            <field name="name">Construction Tenders</field>
            <field name="sequence">11</field>
            <field name="description">Module category for Construction Tenders</field>
        </record>

        <!-- ============================================================= -->
        <!-- Tender privileges                                             -->
        <!-- All grouped under the dedicated "Construction Tenders"        -->
        <!-- section in the user form, ordered by the tender workflow      -->
        <!-- (sequence 20..28). Each privilege holds a single group, so it -->
        <!-- renders as a simple toggle.                                   -->
        <!-- ============================================================= -->

        <record model="res.groups.privilege" id="privilege_tender_offer">
            <field name="name">Tender: Offer Manager</field>
            <field name="sequence">20</field>
            <field name="category_id" ref="nthub_constructions_tenders_category"/>
        </record>

        <record model="res.groups.privilege" id="privilege_tender_confirm_offer">
            <field name="name">Tender: Offer Confirm</field>
            <field name="sequence">21</field>
            <field name="category_id" ref="nthub_constructions_tenders_category"/>
        </record>

        <record model="res.groups.privilege" id="privilege_tender_confirm_version">
            <field name="name">Tender: Version Confirm</field>
            <field name="sequence">22</field>
            <field name="category_id" ref="nthub_constructions_tenders_category"/>
        </record>

        <record model="res.groups.privilege" id="privilege_tender_confirm_breakdown">
            <field name="name">Tender: Breakdown Confirm</field>
            <field name="sequence">23</field>
            <field name="category_id" ref="nthub_constructions_tenders_category"/>
        </record>

        <record model="res.groups.privilege" id="privilege_tender_confirm_contract">
            <field name="name">Tender: Contract Confirm</field>
            <field name="sequence">24</field>
            <field name="category_id" ref="nthub_constructions_tenders_category"/>
        </record>

        <record model="res.groups.privilege" id="privilege_subcontractor_delivery_confirm">
            <field name="name">Tender: Subcontractor Delivery Confirm</field>
            <field name="sequence">25</field>
            <field name="category_id" ref="nthub_constructions_tenders_category"/>
        </record>

        <record model="res.groups.privilege" id="privilege_completion_request_confirm">
            <field name="name">Tender: Completion Request Confirm</field>
            <field name="sequence">26</field>
            <field name="category_id" ref="nthub_constructions_tenders_category"/>
        </record>

        <record model="res.groups.privilege" id="privilege_requisition_over_budget">
            <field name="name">Tender: Allow Over-Budget Requisition</field>
            <field name="sequence">27</field>
            <field name="category_id" ref="nthub_constructions_tenders_category"/>
        </record>

        <record model="res.groups.privilege" id="privilege_task_transfer">
            <field name="name">Tender: Task Transfer Product</field>
            <field name="sequence">28</field>
            <field name="category_id" ref="nthub_constructions_tenders_category"/>
        </record>

        <!-- ============================================================= -->
        <!-- Tender groups (one per privilege above)                       -->
        <!-- XML IDs kept unchanged so existing groups= references and     -->
        <!-- assigned users are preserved on upgrade.                      -->
        <!-- ============================================================= -->

        <record id="construction_tender_offer" model="res.groups">
            <field name="name">Tender: Offer Manager</field>
            <field name="privilege_id" ref="privilege_tender_offer"/>
        </record>

        <record id="construction_tender_confirm_offer" model="res.groups">
            <field name="name">Tender: Offer Confirm</field>
            <field name="privilege_id" ref="privilege_tender_confirm_offer"/>
        </record>

        <record id="construction_tender_confirm_version" model="res.groups">
            <field name="name">Tender: Version Confirm</field>
            <field name="privilege_id" ref="privilege_tender_confirm_version"/>
        </record>

        <record id="construction_tender_confirm_breakdown" model="res.groups">
            <field name="name">Tender: Breakdown Confirm</field>
            <field name="privilege_id" ref="privilege_tender_confirm_breakdown"/>
        </record>

        <record id="construction_tender_confirm_contract" model="res.groups">
            <field name="name">Tender: Contract Confirm</field>
            <field name="privilege_id" ref="privilege_tender_confirm_contract"/>
        </record>

        <record id="construction_subcontractor_delivery_confirm" model="res.groups">
            <field name="name">Tender: Subcontractor Delivery Confirm</field>
            <field name="privilege_id" ref="privilege_subcontractor_delivery_confirm"/>
        </record>

        <record id="construction_completion_request_confirm" model="res.groups">
            <field name="name">Tender: Completion Request Confirm</field>
            <field name="privilege_id" ref="privilege_completion_request_confirm"/>
        </record>

        <record id="construction_requisition_over_budget" model="res.groups">
            <field name="name">Tender: Allow Over-Budget Requisition</field>
            <field name="privilege_id" ref="privilege_requisition_over_budget"/>
        </record>

        <record id="construction_task_transfer" model="res.groups">
            <field name="name">Tender: Task Transfer Product</field>
            <field name="privilege_id" ref="privilege_task_transfer"/>
        </record>

        <!-- ============================================================= -->
        <!-- Completion Request (مستخلص) role-based privileges             -->
        <!-- Four dedicated roles covering the full مستخلص workflow:       -->
        <!--   مهندس موقع → مهندس مراجعة → مدير مشروع → محاسب            -->
        <!-- ============================================================= -->

        <record model="res.groups.privilege" id="privilege_completion_site_engineer">
            <field name="name">مستخلص: مهندس موقع / Site Engineer</field>
            <field name="sequence">30</field>
            <field name="category_id" ref="nthub_constructions_tenders_category"/>
        </record>

        <record model="res.groups.privilege" id="privilege_completion_review_engineer">
            <field name="name">مستخلص: مهندس مراجعة / Review Engineer</field>
            <field name="sequence">31</field>
            <field name="category_id" ref="nthub_constructions_tenders_category"/>
        </record>

        <record model="res.groups.privilege" id="privilege_completion_project_manager">
            <field name="name">مستخلص: مدير مشروع / Project Manager</field>
            <field name="sequence">32</field>
            <field name="category_id" ref="nthub_constructions_tenders_category"/>
        </record>

        <record model="res.groups.privilege" id="privilege_completion_accountant">
            <field name="name">مستخلص: محاسب / Accountant</field>
            <field name="sequence">33</field>
            <field name="category_id" ref="nthub_constructions_tenders_category"/>
        </record>

        <!-- مهندس الموقع — ينشئ المستخلص ويدخل الكميات ويرفعه للمراجعة -->
        <record id="completion_group_site_engineer" model="res.groups">
            <field name="name">مستخلص: مهندس موقع / Site Engineer</field>
            <field name="privilege_id" ref="privilege_completion_site_engineer"/>
        </record>

        <!-- مهندس المراجعة — يراجع البنود ويقبل/يرفض/يرجع للمسودة -->
        <record id="completion_group_review_engineer" model="res.groups">
            <field name="name">مستخلص: مهندس مراجعة / Review Engineer</field>
            <field name="privilege_id" ref="privilege_completion_review_engineer"/>
        </record>

        <!-- مدير المشروع — يعتمد المستخلص النهائي -->
        <record id="completion_group_project_manager" model="res.groups">
            <field name="name">مستخلص: مدير مشروع / Project Manager</field>
            <field name="privilege_id" ref="privilege_completion_project_manager"/>
        </record>

        <!-- المحاسب — يشوف المستخلصات المعتمدة وينشئ فواتيرها -->
        <record id="completion_group_accountant" model="res.groups">
            <field name="name">مستخلص: محاسب / Accountant</field>
            <field name="privilege_id" ref="privilege_completion_accountant"/>
        </record>

    </data>
</odoo>
